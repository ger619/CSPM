<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 bg-[#131D58]/40 backdrop-blur-sm flex justify-center items-center z-50 px-3 py-6">
    <div class="bg-white p-5 sm:p-6 rounded-xl shadow-xl w-full max-w-5xl relative max-h-[90vh] overflow-y-auto">
      <!-- Close Button -->
      <%= link_to "&times;".html_safe, product_path(@product), data: { turbo_frame: "_top" }, class: "absolute top-4 right-4 text-2xl leading-none font-bold text-gray-400 hover:text-gray-700" %>

      <!-- Header -->
      <h2 class="text-xl sm:text-2xl font-bold text-[#131D58] mb-6 pr-8">Add New Task</h2>

      <%= form_with(model: [product, product.tasks.build], data: { turbo: false }) do |f| %>
        <div class="space-y-5">
          <!-- Error Messages -->
          <% if flash[:alert] %>
            <div id="error_explanation" class="bg-red-50 border border-red-100 p-4 rounded-lg">
              <h2 class="text-red-700 font-semibold mb-2">Error:</h2>
              <ul class="list-disc list-inside text-red-600 text-sm">
                <li><%= flash[:alert] %></li>
              </ul>
            </div>
          <% end %>


          <!-- Prerequisite -->
          <div class="bg-[#F4F5FA] p-4 rounded-xl">
            <div class="relative z-0 w-full group">
              <%= f.label :prerequisite, ('Prerequisite'), class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
              <%= f.collection_select :tasks_id, @prerequisite_tasks, :id, :name,
                                      { prompt: "Select Task" },
                                      class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white"
              %>
            </div>
          </div>

          <!-- Name -->
          <div class="bg-[#F4F5FA] p-4 rounded-xl">
            <div class="relative z-0 w-full group">
              <%= f.label :name, ('Name*'), class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
              <%= f.text_field :name, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", placeholder: '', required: true %>
            </div>
          </div>

          <!-- Priority Field -->
          <div class="bg-[#F4F5FA] p-4 rounded-xl">
            <%= f.label :priority, ('Priority *'), class: "capitalize block mb-2 text-sm font-medium text-[#131D58]"  %>
            <%= f.select :priority, options_for_select(['SEVERITY 1','SEVERITY 2','SEVERITY 3','SEVERITY 4']), {}, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", placeholder: 'Select The Issue', required: true %>
            <% if @task.errors[:priority].any? %>
              <div class="text-red-600 text-sm mt-1"><%= @task.errors[:priority].join(", ") %></div>
            <% end %>
          </div>

          <!-- Image and File Uploads -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Task Image -->
            <div class="bg-[#F4F5FA] p-4 rounded-xl">
              <div class="relative z-0 w-full group">
                <%= f.label :image, ('Task Image (Only Images)'), class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
                <%= f.file_field :image, accept: 'image/*', class: "border border-gray-300 rounded-lg block w-full p-2 text-sm bg-white file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:bg-[#131D58] file:text-white file:text-sm file:font-medium file:cursor-pointer" %>
              </div>
            </div>

            <!-- Task File -->
            <div class="bg-[#F4F5FA] p-4 rounded-xl">
              <div class="relative z-0 w-full group">
                <%= f.label :file, ('Task File (Only files)'), class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
                <%= f.file_field :file, accept: '*/*', class: "border border-gray-300 rounded-lg block w-full p-2 text-sm bg-white file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:bg-[#131D58] file:text-white file:text-sm file:font-medium file:cursor-pointer" %>
              </div>
            </div>
          </div>

          <!-- Dates -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Start Date -->
            <div class="bg-[#F4F5FA] p-4 rounded-xl">
              <div class="relative z-0 w-full group">
                <%= f.label :start_date, 'Start Date*', class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                    <svg class="w-4 h-4 text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M20 4a2 2 0 0 0-2-2h-2V1a1 1 0 0 0-2 0v1h-3V1a1 1 0 0 0-2 0v1H6V1a1 1 0 0 0-2 0v1H2a2 2 0 0 0-2 2v2h20V4ZM0 18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H0v10Zm5-8h10a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z"/>
                    </svg>
                  </div>
                  <%= f.date_field :start_date, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full pl-10 p-2.5 text-sm bg-white", required: true %>
                </div>
              </div>
            </div>

            <!-- End Date -->
            <div class="bg-[#F4F5FA] p-4 rounded-xl">
              <div class="relative z-0 w-full group">
                <%= f.label :end_date, 'End Date*', class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                    <svg class="w-4 h-4 text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M20 4a2 2 0 0 0-2-2h-2V1a1 1 0 0 0-2 0v1h-3V1a1 1 0 0 0-2 0v1H6V1a1 1 0 0 0-2 0v1H2a2 2 0 0 0-2 2v2h20V4ZM0 18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H0v10Zm5-8h10a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z"/>
                    </svg>
                  </div>
                  <%= f.date_field :end_date, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full pl-10 p-2.5 text-sm bg-white", required: true %>
                </div>
              </div>
            </div>
          </div>

          <!-- Description -->
          <div class="bg-[#F4F5FA] p-4 rounded-xl">
            <div class="relative z-0 w-full group">
              <%= f.label :description, 'Description*', class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
              <%= f.rich_text_area :description,
                class: "min-h-[200px] border border-gray-300 rounded-lg bg-white",
                required: true %>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="flex justify-end">
            <%= f.submit 'Add Task', class: "px-5 py-2.5 text-sm font-semibold text-white bg-[#0D9C67] rounded-lg hover:bg-[#0B8659] focus:ring-2 focus:ring-offset-2 focus:ring-[#0D9C67] focus:outline-none transition-colors cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
