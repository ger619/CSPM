<div class="flex flex-wrap gap-2 mt-2">
  <% if current_user.has_role? :admin or current_user.has_role?('project manager') or current_user.has_role? :agent %>
    <div class="w-full">
      <%= form_with url: add_state_product_task_path(@product, @task), local: true, data: { turbo: false } do %>
        <%= label_tag :status, "SELECT STATUS", class: "sr-only" %>
        <div class="flex flex-col gap-2">
          <div>
            <% available_statuses = Status.where(name: ['TO DO', 'Closed', 'Await Client Information', 'Blocked',
                                                    'In Progress', 'On-Hold', 'Failed-QA', 'QA-testing',
                                                    'Reopened', 'Awaiting Build', 'Support Testing',
                                                    'Awaiting Client API', 'Resolved', 'Closed']) %>
            <% if available_statuses %>
              <%= select_tag :status_id,
                             options_for_select(available_statuses.pluck(:name, :id)),
                             class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] w-full p-2.5 text-sm",
                             required: true %>
            <% end %>
          </div>
          <%= submit_tag "UPDATE STATUS", class: 'w-full font-semibold bg-[#131D58] hover:bg-[#0E1642] text-white p-2.5 rounded-lg text-sm transition-colors cursor-pointer' %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
