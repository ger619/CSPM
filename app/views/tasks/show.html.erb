<div class="min-h-screen bg-gray-50 px-3 py-4 sm:px-6 sm:py-6 lg:px-8">
  <%= render partial: 'tasks/top_task_bar' %>

  <div class="flex flex-col lg:flex-row w-full mx-auto overflow-hidden bg-white rounded-xl shadow-sm border border-gray-100">

    <div class="p-4 sm:p-5 grid grid-cols-1 lg:grid-cols-5 gap-6">
      <div class="lg:col-span-4">
        <%= render 'tasks/content_for_task' %>
      </div>

      <div class="lg:col-span-1 space-y-5">
        <!-- Image/File Section -->
        <div class="bg-[#F4F5FA] rounded-xl p-4 space-y-3">
          <% if @task.image.present? %>
            <p class="font-semibold text-xs text-[#131D58] uppercase tracking-wide">Click to Enlarge</p>
            <%= image_tag @task.image, class: 'zoomable-image w-full rounded-lg object-cover cursor-pointer' %>
          <% elsif @product.image.present? %>
            <%= image_tag @product.image, class: 'w-16 rounded-lg' %>
          <% else %>
            <%= image_tag 'logo-mark.png', class: 'w-16 rounded-lg' %>
          <% end %>

          <% if @task.file.present? %>
            <%= link_to url_for(@task.file), target: "_blank", class: "inline-flex items-center gap-1.5 text-sm text-[#0D9C67] hover:text-[#0B8659] font-medium" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              Download <%= @task.file.filename %>
            <% end %>
          <% else %>
            <p class="text-sm text-gray-500">
              This task does not have an uploaded file. If you need to add a file, kindly
              <%= link_to "edit", edit_product_task_path(@product, @task), method: :get, class: 'underline text-[#0D9C67] hover:text-[#0B8659] font-medium' %>
              the task to include it.
            </p>
          <% end %>
        </div>

        <!-- Status Section -->
        <div class="bg-[#F4F5FA] rounded-xl p-4 space-y-3">
          <div class="flex items-center justify-between">
            <span class="font-semibold text-xs text-[#131D58] uppercase tracking-wide">Status</span>
            <%= render partial: 'tasks/task_status', locals: { task: @task } %>
          </div>
          <div>
            <%= render 'tasks/add_state' %>
          </div>
        </div>

        <!-- Assigned Users Section -->
        <div class="bg-[#F4F5FA] rounded-xl p-4 space-y-3">
          <div class="font-semibold text-xs text-[#131D58] uppercase tracking-wide">Assigned To</div>
          <div class="flex flex-wrap items-center gap-3">
            <% if @task.users.any? %>
              <% @task.users.each do |user| %>
                <div class="flex items-center gap-2 bg-white rounded-full pl-1 pr-3 py-1 shadow-sm">
                  <% if user.profile_picture.attached? %>
                    <%= image_tag user.profile_picture, class: 'object-cover h-8 w-8 rounded-full' %>
                  <% elsif user.name_initials.present? %>
                    <p class="w-8 h-8 flex items-center justify-center rounded-full bg-[#131D58] text-white text-xs font-semibold capitalize">
                      <%= user.name_initials %>
                    </p>
                  <% else %>
                    <%= image_tag 'default.png', class: 'w-8 h-8 rounded-full' %>
                  <% end %>
                  <span class="text-sm text-gray-700"><%= user.name if user.name.present? %></span>
                </div>
              <% end %>
            <% else %>
              <p class="text-sm text-gray-500">No users assigned yet.</p>
            <% end %>
          </div>

          <!-- Assign User Form -->
          <div>
            <%= render 'tasks/assign_user' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
