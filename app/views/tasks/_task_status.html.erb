<% if task.statuses.present? %>
  <% task.statuses.each do |status| %>
    <% case status.name %>
    <% when 'Resolved' %>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-[#E3F6EC] text-[#0B4A32] ring-1 ring-[#0D9C67]/20">Resolved</span>
    <% when 'Closed' %>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-gray-100 text-gray-600 ring-1 ring-gray-200">Closed</span>
    <% when 'Reopened' %>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-red-50 text-red-700 ring-1 ring-red-200">Reopened</span>
    <% when 'New' %>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-red-50 text-red-700 ring-1 ring-red-200">New</span>
    <% when 'Under Development' %>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-[#E8EAF3] text-[#131D58] ring-1 ring-[#131D58]/10">Under Development</span>
    <% when 'Work in Progress' %>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-gray-100 text-gray-700 ring-1 ring-gray-200">Work In Progress</span>
    <% when 'QA Testing' %>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-pink-50 text-pink-700 ring-1 ring-pink-200">QA Testing</span>
    <% when 'Awaiting Build' %>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-white text-gray-600 ring-1 ring-gray-300">Awaiting Build</span>
    <% when 'Client Confirmation Pending' %>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-purple-50 text-purple-700 ring-1 ring-purple-200">Client Confirmation Pending</span>
    <% when 'On-Hold' %>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-yellow-50 text-yellow-700 ring-1 ring-yellow-200">On-Hold</span>
    <% when 'TO DO' %>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-[#E8EAF3] text-[#131D58] ring-1 ring-[#131D58]/10">TO DO</span>
    <% when 'Approved' %>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-[#E3F6EC] text-[#0B4A32] ring-1 ring-[#0D9C67]/20">Approved</span>
    <% when 'Pending' %>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-gradient-to-r from-[#E3F6EC] to-gray-100 text-[#0B4A32] ring-1 ring-[#0D9C67]/20">Pending</span>
    <% when 'Declined' %>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-gray-100 text-gray-600 ring-1 ring-gray-200">Declined</span>
    <% end %>
  <% end %>
<% end %>
