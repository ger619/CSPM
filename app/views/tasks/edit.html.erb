<div class="min-h-screen bg-gray-50 px-3 py-4 sm:px-6 sm:py-6 lg:px-8">
  <div class="max-w-4xl mx-auto bg-white rounded-xl shadow-sm border border-gray-100 p-5 sm:p-6">

    <%= link_to product_path(@product.id), method: :get, class: 'inline-flex items-center gap-1.5 bg-[#131D58] hover:bg-[#0E1642] px-3 py-2 rounded-lg font-semibold text-sm text-white transition-colors mb-4' do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
      </svg>
      Back
    <% end %>

    <h1 class="text-xl sm:text-2xl font-bold text-[#131D58] mb-6">Edit Task</h1>

    <% if flash[:alert] %>
      <div class="bg-red-50 border border-red-100 text-red-700 px-4 py-3 rounded-lg mb-5 text-sm font-medium">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with(model: [@product, @task], method: :patch) do |f| %>
      <div class="space-y-5">
        <div class="bg-[#F4F5FA] p-4 rounded-xl grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="relative z-0 w-full group">
            <%= f.label :name, "Name*", class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
            <%= f.text_field :name, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", placeholder: '', required: true %>
          </div>

          <div class="relative z-0 w-full group">
            <%= f.label :priority, ('Priority *'), class: "capitalize block mb-2 text-sm font-medium text-[#131D58]"  %>
            <%= f.select :priority, ['SEVERITY 1','SEVERITY 2','SEVERITY 3','SEVERITY 4'], {}, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", placeholder: 'Select The Issue' %>
          </div>
        </div>

        <div class="bg-[#F4F5FA] p-4 rounded-xl grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="relative z-0 w-full group">
            <%= f.label :image, ('Task Image'), class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
            <%= f.file_field :image, class: "border border-gray-300 rounded-lg block w-full p-2 text-sm bg-white file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:bg-[#131D58] file:text-white file:text-sm file:font-medium file:cursor-pointer", placeholder: '' %>
          </div>
          <div class="relative z-0 w-full group">
            <%= f.label :file, ('Task File'), class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
            <%= f.file_field :file, class: "border border-gray-300 rounded-lg block w-full p-2 text-sm bg-white file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:bg-[#131D58] file:text-white file:text-sm file:font-medium file:cursor-pointer", placeholder: '' %>
          </div>
        </div>

        <div class="bg-[#F4F5FA] p-4 rounded-xl grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="relative z-0 w-full group">
            <%= f.label :start_date, 'Start Date', class: "capitalize block mb-2 text-sm font-medium text-[#131D58]"  %>
            <%= f.date_field :start_date, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", placeholder: '', required: true %>
          </div>
          <div class="relative z-0 w-full group">
            <%= f.label :end_date, 'End Date', class: "capitalize block mb-2 text-sm font-medium text-[#131D58]"  %>
            <%= f.date_field :end_date, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", placeholder: '', required: true %>
          </div>
        </div>

        <div class="bg-[#F4F5FA] p-4 rounded-xl">
          <div class="relative z-0 w-full group">
            <%= f.label :description, "Description*", class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
            <%= f.rich_text_area :description, class: "border border-gray-300 rounded-lg block w-full min-h-64 p-2.5 text-sm bg-white", placeholder: '', required: true %>
          </div>
        </div>

        <div class="flex justify-end pt-2">
          <%= f.submit 'Save Changes', class: 'bg-[#0D9C67] hover:bg-[#0B8659] px-5 py-2.5 rounded-lg font-semibold text-sm text-white transition-colors cursor-pointer' %>
        </div>
      </div>
    <% end %>
  </div>
</div>
