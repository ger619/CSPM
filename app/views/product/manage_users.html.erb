<%= turbo_frame_tag "modal" do %>

  <div class="fixed inset-0 bg-[#131D58]/40 backdrop-blur-sm flex justify-center items-center z-50 px-3">
    <div class="bg-white p-5 sm:p-6 rounded-xl shadow-xl w-full max-w-2xl relative max-h-[90vh] overflow-y-auto">

      <% if flash[:notice] %>
        <div class="flex items-start gap-3 bg-[#E3F6EC] border border-[#0D9C67]/30 text-[#0B4A32] px-4 py-3 rounded-xl mb-4 shadow-sm">
          <p class="text-sm font-medium"><%= flash[:notice] %></p>
        </div>
      <% elsif flash[:alert] %>
        <div class="flex items-start gap-3 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl mb-4 shadow-sm">
          <p class="text-sm font-medium"><%= flash[:alert] %></p>
        </div>
      <% end %>

      <!-- Close Button -->
      <%= link_to "&times;".html_safe, "#", data: {
        controller: "modal",
        action: "modal#close"
      }, class: "absolute top-4 right-4 text-2xl leading-none font-bold text-gray-400 hover:text-gray-700" %>

      <!-- Header -->
      <h2 class="text-xl sm:text-2xl font-bold text-[#131D58] mb-6 pr-8">Manage Product Users</h2>

      <!-- Main Content -->
      <div class="space-y-5">
        <!-- Assigned Agents Section -->
        <div class="bg-[#F4F5FA] p-4 rounded-xl">
          <%= render 'product/added_users' %>
        </div>

        <!-- Add/Remove Users Section -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Add Users -->
          <div class="bg-[#F4F5FA] p-4 rounded-xl">
            <%= render 'product/add_users' %>
          </div>

          <!-- Remove Users -->
          <% if @product.users.present? %>
            <div class="bg-[#F4F5FA] p-4 rounded-xl">
              <%= render 'product/remove_user' %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Cancel Button -->
      <div class="flex justify-end mt-6">
        <%= link_to "Close", "#", data: {
            controller: "modal",
            action: "modal#close"
        }, class: "px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors" %>
      </div>
    </div>
  </div>
<% end %>
