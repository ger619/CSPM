<% if current_user.has_role?(:admin) || current_user.has_role?('project manager') %>
  <div>
    <h4 class="font-semibold text-sm text-[#131D58] mb-3">Remove User</h4>
    <%= form_with url: remove_user_product_path(@product), method: :delete, data: { turbo: false }, class: "space-y-3" do %>
      <div>
        <%= label_tag :user_id, "Select User", class: "block text-xs font-medium text-gray-500 mb-1" %>
        <%= select_tag :user_id,
            options_from_collection_for_select(@product.users, :id, :name),
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 text-sm" %>
      </div>
      <div>
        <%= submit_tag "Remove User",
            class: "w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
<% end %>
