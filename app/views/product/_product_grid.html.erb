<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-5 mt-5">
  <% @product.each do |product| %>
    <div class="group bg-white border border-gray-100 shadow-sm hover:shadow-md rounded-xl transition-shadow cursor-pointer overflow-hidden" onclick="window.location='<%= product_path(product.id) %>'">
      <div>
        <div class="flex items-start justify-between gap-2 bg-[#F4F5FA] p-3 sm:p-4">
          <div class="flex items-center gap-3 min-w-0">
          <% if product.image.present? %>
            <%= image_tag(product.image, class: 'w-9 h-9 rounded-lg object-cover flex-shrink-0') %>
          <% else %>
            <%= image_tag 'logo-mark.png', class: 'w-9 h-9 rounded-lg flex-shrink-0' %>
          <% end %>
            <div class="min-w-0">
              <p class="text-sm font-semibold uppercase text-[#131D58] truncate"><%= product.client.present? ? product.client.name : 'No Client Assigned' %></p>
              <p class="text-xs font-medium capitalize text-gray-500 truncate">
                <%= product.groupwares.map(&:name).join(', ') %>
              </p>
            </div>
          </div>
          <div class="flex items-center gap-1 flex-shrink-0">
            <span class="inline-flex items-center rounded-full bg-[#E3F6EC] text-[#0B4A32] text-xs font-semibold px-2.5 py-1 whitespace-nowrap">
              <%= product.statuses.first&.name %>
            </span>
            <% if current_user.has_role?(:admin) && can?(:edit, product) %>
              <%= link_to edit_product_path(product),
                          class: "p-1.5 rounded-lg hover:bg-white text-gray-400 hover:text-[#131D58] transition-colors",
                          data: { turbo: false } do %>
                <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 18.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z" />
                </svg>
              <% end %>
            <% end %>
          </div>
        </div>
        <div>
          <%= render partial: 'product/task_budget' , locals: { product: product } %>
        </div>
      </div>
      <div class="px-4">
        <hr class="border-gray-100">
      </div>

      <div class="p-4">
        <!-- All users assigned to the product show first 5 only-->
        <%= render partial: 'product/user_list_index', locals: { product: product } %>
      </div>

      </div>
  <% end %>
</div>
<%= render partial: 'product/grid_pagination' %>
