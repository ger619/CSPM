<h3 class="font-semibold text-sm text-[#131D58] mb-3">Assigned Agents</h3>
<div class="flex flex-wrap gap-2 items-center">
  <% if @product.users.any? %>
    <% @product.users.each do |user| %>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-[#E8EAF3] text-[#131D58]">
          <% if user.name.present? %>
            <%= user.name %>
          <% else %>
            <%= truncate(user.email, length: 15, omission: '...') %>
          <% end %>
      </span>
    <% end %>
  <% else %>
    <p class="text-sm text-gray-500">No users assigned to this product yet.</p>
  <% end %>
</div>
