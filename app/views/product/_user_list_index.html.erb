<div class="flex flex-wrap gap-2 items-center">
  <% if product.users.any? %>
    <% product.users.first(5).each do |user| %>
      <% if user.profile_picture.attached? %>
        <%= image_tag user.profile_picture, class: 'w-9 h-9 rounded-full object-cover ring-2 ring-white' %>
      <% elsif user.name_initials.present? %>
              <span class="w-9 h-9 inline-flex items-center justify-center rounded-full text-xs font-semibold bg-[#131D58] text-white ring-2 ring-white">
                <%= user.name_initials %>
              </span>
      <% else %>
        <%= image_tag 'default.png', class: 'w-9 h-9 rounded-full object-cover ring-2 ring-white' %>
      <% end %>
    <% end %>
  <% else %>
    <p class="text-sm text-gray-400">No users assigned to this product yet.</p>
  <% end %>
</div>
