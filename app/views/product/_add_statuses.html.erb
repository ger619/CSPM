<% # Find the product's current status name (or nil if it has none) %>
<% current_status = @product.statuses.first&.name %>

<% status_options =
     if current_status.nil? || current_status == 'Initiation'
             Status.where(name: ['Development']).pluck(:name, :id)
     elsif current_status == 'Development'
             Status.where(name: ['Quality Assurance']).pluck(:name, :id)
     elsif current_status == 'Quality Assurance'
             Status.where(name: ['User Acceptance Test']).pluck(:name, :id)
     elsif current_status == "User Acceptance Test"
             Status.where(name: ['Deploy']).pluck(:name, :id)
     elsif current_status == 'Deploy'
             Status.where(name: ['Production']).pluck(:name, :id)
     else
             []
     end
%>

<%= form_with url: product_status_product_path(@product), local: true do %>
  <div class="relative flex flex-col gap-2">
    <%= select_tag :status_id,
                   options_for_select(status_options),
                   class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] p-2.5 text-sm" %>
    <%= submit_tag "UPDATE", class: 'font-semibold bg-[#0D9C67] hover:bg-[#0B8659] text-white p-2.5 rounded-lg mt-1 transition-colors cursor-pointer' %>
  </div>
<% end %>
