<% if current_user.has_role?(:admin) || current_user.has_role?('project manager') %>
  <div>
    <h4 class="font-semibold text-sm text-[#131D58] mb-3">Add User</h4>
    <%= form_with url: add_user_product_path(@product), data: { turbo: false }, class: "space-y-3" do %>
      <div>
        <%= label_tag :user_id, "Select User", class: "block text-xs font-medium text-gray-500 mb-1" %>
        <%= select_tag :user_id,
            options_from_collection_for_select(User.with_agent_role.where.not(id: @product.users.pluck(:id)).distinct, :id, :name),
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-[#0D9C67] focus:ring-[#0D9C67] text-sm",
            required: true %>
      </div>
      <div>
        <%= submit_tag "Add User",
            class: "w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-[#0D9C67] hover:bg-[#0B8659] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#0D9C67] transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
<% end %>
