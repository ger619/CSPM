<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 bg-[#131D58]/40 backdrop-blur-sm flex justify-center items-center z-50 px-3 py-6">
    <div class="bg-white p-5 sm:p-6 rounded-xl shadow-xl w-full max-w-5xl relative max-h-[90vh] overflow-y-auto">
      <!-- Close Button -->
      <%= link_to "&times;".html_safe, product_index_path, data: {
        turbo_frame: "_top"
      }, class: "absolute top-4 right-4 text-2xl leading-none font-bold text-gray-400 hover:text-gray-700" %>


      <!-- Header -->
      <h2 class="text-xl sm:text-2xl font-bold text-[#131D58] mb-6 pr-8">Add new Project</h2>

      <%= form_with model: @product, url: product_index_url, method: :post, data: { turbo: false }, local: true, html: { multipart: true } do |f| %>
        <div class="space-y-5">
          <!-- Error Messages -->
          <% if @product.errors.any? %>
            <div id="error_explanation" class="bg-red-50 border border-red-100 p-4 rounded-lg">
              <h2 class="text-red-700 font-semibold mb-2"><%= pluralize(@product.errors.count, "error") %> prohibited this project from being saved:</h2>
              <ul class="list-disc list-inside text-red-600 text-sm space-y-0.5">
                <% @product.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>


          <!-- Client Name -->
          <div class="bg-[#F4F5FA] p-4 rounded-xl">
            <div class="relative z-0 w-full group">
              <%= f.label :software, ('Client*'), class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
              <%= f.collection_select :client_id, Client.all, :id, :name, { prompt: "Select Client" }, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", required: true %>
            </div>
          </div>

          <!-- Project Category and Sub Category -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Project Category -->
            <div class="bg-[#F4F5FA] p-4 rounded-xl">
              <div class="relative z-0 w-full group">
                <%= f.label :categories, ('Project Category*'), class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
                <%= f.collection_select :software_ids, Software.all, :id, :name,
                                      { prompt: "Select Product", include_hidden: false },
                                      class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white",
                                      data: { action: "change->form#updateGroupwareOptions" },
                                      required: true %>
              </div>
            </div>

            <!-- Sub Category -->
            <div class="bg-[#F4F5FA] p-4 rounded-xl">
              <div class="relative z-0 w-full group">
                <%= f.label :categories, ('Sub Category*'), class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
                <%= f.collection_select :groupware_ids, @product.groupwares.where(software_id: @product.software_ids), :id, :name,
                                      { prompt: "Select Sub Product", include_hidden: false },
                                      class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white",
                                      id: "groupware-select",
                                      required: true %>
              </div>
            </div>
          </div>


          <!-- Assignee -->
          <div class="bg-[#F4F5FA] p-4 rounded-xl">
            <div class="relative z-0 w-full group">
              <%= f.label :Assignee, ('Team Members*'), class: "capitalize block mb-2 text-sm font-medium text-[#131D58]"  %>
              <%= f.select :user_id, User.with_agent_project_manager_role.order(:first_name, :last_name).map { |user| [user.name, user.id] }, {}, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", placeholder: 'Assign User', required: true %>
            </div>
          </div>

          <!-- Attachments Section -->
          <div class="bg-[#F4F5FA] p-4 rounded-xl">
            <h3 class="text-base font-semibold text-[#131D58] mb-4">Attachments (PDF/DOC)</h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Add Document -->
              <div class="relative z-0 w-full group">
                <!-- Documents Field (use :documents with multiple: true for ActiveStorage) -->
                <div id="documents-container">

                </div>
                <button type="button" id="add-document-button" class="mt-2 inline-flex items-center gap-2 px-3 py-2 bg-[#131D58] hover:bg-[#0E1642] text-white text-sm font-medium rounded-lg transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                  </svg>
                  Add Document(s)
                </button>
              </div>
            </div>
          </div>

          <!-- Dates and Budget -->
          <div class="bg-[#F4F5FA] p-4 rounded-xl">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <!-- Start Date -->
              <div class="relative z-0 w-full group">
                <%= f.label :start_date, 'Start Date*', class: "capitalize block mb-2 text-sm font-medium text-[#131D58]"  %>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                    <svg class="w-4 h-4 text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M20 4a2 2 0 0 0-2-2h-2V1a1 1 0 0 0-2 0v1h-3V1a1 1 0 0 0-2 0v1H6V1a1 1 0 0 0-2 0v1H2a2 2 0 0 0-2 2v2h20V4ZM0 18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H0v10Zm5-8h10a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z"/>
                    </svg>
                  </div>
                  <%= f.date_field :start_date, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full pl-10 p-2.5 text-sm bg-white", required: true %>
                </div>
              </div>

              <!-- End Date -->
              <div class="relative z-0 w-full group">
                <%= f.label :end_date, 'End Date*', class: "capitalize block mb-2 text-sm font-medium text-[#131D58]"  %>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                    <svg class="w-4 h-4 text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M20 4a2 2 0 0 0-2-2h-2V1a1 1 0 0 0-2 0v1h-3V1a1 1 0 0 0-2 0v1H6V1a1 1 0 0 0-2 0v1H2a2 2 0 0 0-2 2v2h20V4ZM0 18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H0v10Zm5-8h10a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z"/>
                    </svg>
                  </div>
                  <%= f.date_field :end_date, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full pl-10 p-2.5 text-sm bg-white", required: true %>
                </div>
              </div>

              <!-- Budget -->
              <div class="relative z-0 w-full group">
                <%= f.label :budget, ('Budget*'), class: "capitalize block mb-2 text-sm font-medium text-[#131D58]"  %>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                    <svg class="w-4 h-4 text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 11 20">
                      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1.75 15.363a4.954 4.954 0 0 0 2.638 1.574c2.345.572 4.653-.434 5.155-2.247.502-1.813-1.313-3.79-3.657-4.364-2.344-.574-4.16-2.551-3.658-4.364.502-1.813 2.81-2.818 5.155-2.246A4.97 4.97 0 0 1 10 5.264M6 17.097v1.82m0-17.5v2.138"/>
                    </svg>
                  </div>
                  <%= f.number_field :budget, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full pl-10 p-2.5 text-sm bg-white", placeholder: '0.00', required: true %>
                </div>
              </div>
            </div>
          </div>

          <!-- Milestones -->
          <div class="bg-[#F4F5FA] p-4 rounded-xl">
            <h3 class="text-base font-semibold text-[#131D58] mb-4">Milestones</h3>
            <div id="milestones-container">
              <!-- Milestones will be added here dynamically -->
            </div>
            <button type="button" id="add-milestone-button" class="mt-2 inline-flex items-center gap-2 px-3 py-2 bg-[#131D58] hover:bg-[#0E1642] text-white text-sm font-medium rounded-lg transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
              Add Milestone
            </button>
          </div>

          <!-- Description -->
          <div class="bg-[#F4F5FA] p-4 rounded-xl">
            <div class="relative z-0 w-full group">
              <%= f.label :title, ('Project Description*'), class: "capitalize block mb-2 text-sm font-medium text-[#131D58]"  %>
              <div data-controller="text-limit" data-text-limit-limit-value="3000">
                <p class="text-sm text-gray-500 mb-2" id="char-count">0/3000</p>
                <%= f.rich_text_area :content, id: "content",
                                   data: { text_limit_target: "content" },
                                   class: "min-h-[200px] border border-gray-300 rounded-lg bg-white #{'border-red-500' if @product.errors[:content].any?}",
                                   required: true %>
                <% if @product.errors[:content].any? %>
                  <div class="text-red-600 text-sm mt-2"><%= @product.errors[:content].join(', ') %></div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Buttons -->
          <div class="flex flex-col sm:flex-row justify-end gap-3 pt-2">
            <%= f.submit "Save Draft", name: "commit", value: "draft", class: "px-4 py-2.5 text-sm font-semibold text-[#131D58] bg-white border-2 border-[#131D58] rounded-lg hover:bg-[#131D58] hover:text-white focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#131D58] transition-colors cursor-pointer" %>
            <%= f.submit "Create Project", name: "commit", value: "create", class: "px-4 py-2.5 text-sm font-semibold text-white bg-[#0D9C67] rounded-lg hover:bg-[#0B8659] focus:ring-2 focus:ring-offset-2 focus:ring-[#0D9C67] focus:outline-none transition-colors cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<script>
  // Add Milestone Button
  document.getElementById('add-milestone-button').addEventListener('click', function () {
    const container = document.getElementById('milestones-container');
    const timestamp = Date.now();
    const budget = document.getElementById('product_budget').value || 0;

    const newField = document.createElement('div');
    newField.classList.add('milestone-field', 'grid', 'grid-cols-2', 'sm:grid-cols-4', 'gap-4', 'mb-4', 'p-4', 'bg-white', 'border', 'border-gray-200', 'rounded-lg');
    newField.id = `milestone-${timestamp}`;

    newField.innerHTML = `
      <div>
        <label class="block mb-2 text-sm font-medium text-[#131D58]">Status</label>
        <select name="product[milestones_attributes][${timestamp}][status_id]"
                class="status-select bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] w-full p-2.5">
          <%= options_from_collection_for_select(
                Status.where(name: ['Development', 'User Acceptance Test', 'Pilot', 'Quality Assurance', 'Deploy', 'Production']),
                :id,
                :name
              ) %>
        </select>
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-[#131D58]">Percentage</label>
        <input type="number" step="0.01"
              name="product[milestones_attributes][${timestamp}][percentage]"
              class="percentage-input bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] w-full p-2.5"
              oninput="calculateAmount(this, ${budget})">
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-[#131D58]">Amount</label>
        <input type="text" readonly
              class="amount-display bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg w-full p-2.5">
      </div>

      <div class="flex items-end">
        <input type="hidden" name="product[milestones_attributes][${timestamp}][_destroy]" value="false">
        <button type="button"
                class="mt-4 sm:mt-0 px-3 py-2.5 bg-red-600 hover:bg-red-700 text-white rounded-lg remove-milestone text-sm font-medium transition-colors"
                onclick="this.closest('.milestone-field').remove()">
          Remove
        </button>
      </div>
    `;

    container.appendChild(newField);
  });

  // Calculate amount function
  function calculateAmount(input, budget) {
    const percentage = parseFloat(input.value) || 0;
    const amountField = input.closest('.milestone-field').querySelector('.amount-display');
    const amount = (budget * percentage / 100).toFixed(2);
    amountField.value = amount;
  }


  document.getElementById('add-document-button').addEventListener('click', function() {
    const container = document.getElementById('documents-container');
    const timestamp = Date.now(); // Unique identifier for each field set
    const newField = document.createElement('div');

    newField.classList.add('document-field', 'flex', 'flex-col', 'mb-4', 'p-3', 'border', 'border-gray-200', 'bg-white', 'rounded-lg');
    newField.id = timestamp;

    newField.innerHTML = `
      <label class="block mb-1 text-sm font-medium text-[#131D58]">Document Name</label>
      <input type="text" name="product[documents_attributes][${timestamp}][name]"
            class="border border-gray-300 rounded-lg p-2 mb-2 text-sm focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67]" placeholder="Document Name">
      <label class="block mb-1 text-sm font-medium text-[#131D58]">Upload File</label>
      <input type="file" name="product[documents_attributes][${timestamp}][file]"
            class="border border-gray-300 rounded-lg p-2 text-sm">
      <a href="#" class="remove-document text-red-600 hover:text-red-700 text-sm mt-2 block font-medium" data-id="document-${timestamp}">Remove</a>
    `;

    container.appendChild(newField);
  });

  // Functionality to remove an upload document block based on the ID
  document.addEventListener('click', (e) => {
    if(e.target.classList.contains("remove-document")) {
      e.preventDefault();
      const id = e.target.getAttribute("data-id");
      const element = document.getElementById(id);
      if(element) {
        element.remove();
      }
    }
  })

  // Character counter for description
  document.addEventListener('turbo:load', function() {
    const contentField = document.querySelector('[data-text-limit-target="content"]');
    const charCount = document.getElementById('char-count');

    if (contentField && charCount) {
      contentField.addEventListener('input', function() {
        const length = this.textContent.length;
        charCount.textContent = `${length}/3000`;

        if (length > 3000) {
          charCount.classList.add('text-red-500');
          charCount.classList.remove('text-gray-500');
        } else {
          charCount.classList.remove('text-red-500');
          charCount.classList.add('text-gray-500');
        }
      });

      // Initialize count
      const initialLength = contentField.textContent.length;
      charCount.textContent = `${initialLength}/3000`;
    }

    document.addEventListener('click', function (e) {
      if (e.target.classList.contains('remove-document')) {
        e.preventDefault();
        e.target.closest('.document-field').remove();
      }
    });
  });
</script>
