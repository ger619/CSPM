<div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between p-4 bg-white border border-gray-100 rounded-xl shadow-sm">
  <!-- Left side - Search + Category and Sort by dropdowns -->
  <div class="flex flex-col md:flex-row md:items-center gap-3 md:gap-4 w-full lg:w-auto">
    <!-- Projects search form -->
    <div class="relative group flex flex-col sm:flex-row items-stretch sm:items-center w-full md:w-auto">
        <%= form_with url: product_index_path,
                        method: :get,
                        class: 'flex gap-2 w-full',
                        data: { controller: 'search-form',
                                action: 'submit->search-form#submit' } do |f| %>

            <!-- Hidden fields to preserve other params -->
            <%= hidden_field_tag :sort_by, params[:sort_by] if params[:sort_by].present? %>
            <%= hidden_field_tag :status, params[:status] if params[:status].present? %>

            <!-- Search input with clear button -->
            <div class="relative flex-grow min-w-0 sm:min-w-[220px]">
              <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                <svg class="w-4 h-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
                </svg>
              </div>
              <%= f.text_field :query,
                      value: params[:query],
                      placeholder: "Search by content...",
                      class: "w-full border border-gray-300 pl-9 pr-4 py-2.5 rounded-lg text-sm font-medium placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67]",
                      data: { 'search-form-target': 'input' } %>
            </div>

            <%= f.submit "Search", class: 'bg-[#131D58] hover:bg-[#0E1642] px-4 py-2.5 rounded-lg text-sm font-semibold text-white transition-colors whitespace-nowrap' %>
        <% end %>

        <% if params[:query].present? || params[:status].present? || params[:sort_by].present? %>
            <%= link_to 'Clear all', product_index_path,
      class: 'whitespace-nowrap mt-2 sm:mt-0 sm:ml-2 bg-gray-100 hover:bg-gray-200 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-700 text-center transition-colors' %>
        <% end %>
    </div>

    <div class="flex items-center gap-2">
      <!-- Category Dropdown -->
      <div class="relative group" data-controller="product-topbar-dropdown">
          <%= form_with url: product_index_path, method: :get, local: true do |f| %>
              <div class="flex items-center gap-2 text-gray-700 hover:text-[#131D58] px-3 py-2 rounded-lg transition-colors">
              <%= f.label :status, "Category", class: "text-sm font-medium text-gray-500" %>
              <%= select_tag :status,
                  options_for_select(['All', *@used_statuses.sort], selected: params[:status]),
                  onchange: 'this.form.submit()',
                  class: "px-3 py-2 border border-gray-300 bg-white text-gray-900 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] text-sm"
              %>
              </div>
          <% end %>

          <div
              class="hidden absolute left-0 mt-2 w-48 bg-white rounded-lg shadow-lg z-10 border border-gray-100"
              data-product-topbar-dropdown-target="menu"
              data-transition-enter="transition ease-out duration-100"
              data-transition-enter-from="transform opacity-0 scale-95"
              data-transition-enter-to="transform opacity-100 scale-100"
              data-transition-leave="transition ease-in duration-75"
              data-transition-leave-from="transform opacity-100 scale-100"
              data-transition-leave-to="transform opacity-0 scale-95"
          >
              <% ['All', *@used_statuses.sort].each do |category| %>
              <button
                  class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-[#E3F6EC] hover:text-[#0B4A32] transition-colors"
                  data-action="click->product-topbar-dropdown#select"
                  data-category="<%= category %>"
              >
                  <%= category %>
              </button>
              <% end %>
          </div>
          </div>


      <!-- Sort by Dropdown -->
      <div class="relative group" data-controller="product-topbar-dropdown">
        <button
          class="flex items-center gap-2 text-sm text-gray-500 hover:text-[#131D58] px-3 py-2 rounded-lg transition-colors"
          data-action="click->product-topbar-dropdown#toggle"
        >
          <span class="whitespace-nowrap font-medium">Sort by</span>
          <span class="font-semibold text-gray-700" data-product-topbar-dropdown-target="display">Upcoming</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          class="hidden absolute left-0 mt-2 w-48 bg-white rounded-lg shadow-lg z-10 border border-gray-100"
          data-product-topbar-dropdown-target="menu"
        >
          <% current_sort = params[:sort_by].to_s %>
          <% ['Upcoming', 'Recent'].each do |sort_option| %>
          <% sort_key = sort_option.downcase %>
          <button
              class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-[#E3F6EC] hover:text-[#0B4A32] transition-colors <%= 'bg-[#E3F6EC] text-[#0B4A32] font-semibold' if current_sort == sort_key %>"
              data-action="click->product-topbar-dropdown#select"
              data-category="<%= sort_option %>"
          >
              <%= sort_option %>
          </button>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if current_user.has_role? :admin %>
    <!-- Right side - Add New Project button -->
    <div class="flex items-center">
      <%= link_to new_product_path, class: 'inline-flex items-center justify-center gap-2 w-full lg:w-auto bg-[#0D9C67] hover:bg-[#0B8659] px-4 py-2.5 rounded-lg font-semibold text-white shadow-sm transition-colors' do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Add New Project
      <% end %>
    </div>
  <% end %>
</div>
