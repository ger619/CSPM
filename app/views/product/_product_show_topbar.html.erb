<div class="bg-white border border-gray-100 rounded-xl shadow-sm p-4 sm:p-5 mb-4 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
  <!-- Tickets topbar left side -->
  <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
    <div class="flex items-center gap-3 sm:gap-4">
      <div class="flex-shrink-0">
        <% if @product.image.present? %>
          <%= image_tag(@product.image, class: 'w-12 h-12 sm:w-14 sm:h-14 rounded-full object-cover ring-2 ring-[#E8EAF3]') %>
        <% else %>
          <%= image_tag 'logo-mark.png', class: 'w-12 h-12 sm:w-14 sm:h-14 rounded-full object-cover ring-2 ring-[#E8EAF3]' %>
        <% end %>
      </div>
      <div class="flex flex-col min-w-0">
        <h1 class="text-lg sm:text-xl font-bold text-[#131D58] truncate"><%= @product.client.name %></h1>
        <p class="text-xs sm:text-sm text-gray-500 truncate"><%= @product.groupwares.map(&:name).join(', ').presence || "Client Description if any" %></p>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2 sm:gap-3 sm:pl-4 sm:border-l sm:border-gray-200">
      <span class="text-sm text-gray-600">Due date: <span class="font-semibold text-[#131D58]"><%= @product.end_date.strftime("%d %b %Y") %></span></span>
      <span class="text-xs font-semibold px-2.5 py-1 rounded-full <%= @days_remaining.to_i < 10 ? 'bg-red-50 text-red-600' : 'bg-[#E3F6EC] text-[#0B4A32]' %>">
        <%= pluralize(@days_remaining, 'day') %> remaining
      </span>
    </div>
  </div>

  <!-- Tickets topbar right side -->
  <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3">
    <!-- If there is no board created that is todo, this will not show. Show create first board -->
      <%= link_to new_product_task_path(@product), class: 'inline-flex items-center justify-center gap-2 bg-[#0D9C67] hover:bg-[#0B8659] px-4 py-2.5 rounded-lg font-semibold text-white shadow-sm transition-colors', id: 'button' do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Add Task
      <% end %>

    <% if current_user.has_role?(:admin) || current_user.has_role?('project manager') %>
      <%= link_to manage_users_product_path(@product), data: { turbo_frame: "modal" }, class: "inline-flex items-center justify-center gap-2 border-2 border-[#131D58] bg-white hover:bg-[#131D58] px-4 py-2 rounded-lg text-[#131D58] hover:text-white font-medium transition-colors duration-200" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z" />
        </svg>
        <span>Manage Users</span>
      <% end %>
    <% end %>
  </div>
</div>

<% if flash[:prompt] %>
  <div id="custom-alert" class="fixed inset-0 bg-[#131D58]/40 backdrop-blur-sm flex justify-center items-center z-50 px-4">
    <div class="bg-white rounded-xl p-6 max-w-sm w-full shadow-xl">
      <h2 class="text-xl font-semibold mb-4 text-[#131D58]">Notice</h2>
      <p class="text-gray-600"><%= flash[:prompt] %></p>
      <div class="mt-5 text-right">
        <button id="close-alert" class="bg-[#0D9C67] hover:bg-[#0B8659] text-white px-4 py-2 rounded-lg font-medium transition-colors">
          OK
        </button>
      </div>
    </div>
  </div>

  <script type="text/javascript">
    document.addEventListener("turbo:load", function() {
      const alertBox = document.getElementById("custom-alert");
      const closeButton = document.getElementById("close-alert");

      closeButton.addEventListener("click", function() {
        alertBox.remove(); // Completely removes the modal from the DOM
      });
    });
  </script>
<% end %>
