<div class="overflow-x-auto rounded-xl border border-gray-100 shadow-sm bg-white h-full">
  <table class="w-full text-sm text-left text-gray-600">
    <thead class="text-xs uppercase bg-[#F4F5FA] text-[#131D58] font-semibold">
    <tr>
      <th scope="col" class="px-4 sm:px-6 py-3">
        Name of Project
      </th>
      <th scope="col" class="px-4 sm:px-6 py-3">
        Production Description
      </th>
      <th scope="col" class="px-4 sm:px-6 py-3 hide-in-sidebar">
        Start Date
      </th>
      <th scope="col" class="px-4 sm:px-6 py-3 hide-in-sidebar">
        End Date
      </th>
      <th scope="col" class="px-4 sm:px-6 py-3">
        Assignee
      </th>
      <th scope="col" class="px-4 sm:px-6 py-3">
        Product Category
      </th>
      <th scope="col" class="px-4 sm:px-6 py-3">
        Clients
      </th>
      <th scope="col" class="px-4 sm:px-6 py-3 text-right">
        Actions
      </th>
    </tr>
    </thead>
    <tbody class="text-sm font-normal text-gray-700 divide-y divide-gray-100">
    <% @product.each do |product|  %>
      <% if product.added_to?(current_user) or current_user.has_role?(:admin) %>
        <tr class="bg-white hover:bg-[#F4F5FA] transition-colors h-12 text-left">
          <th scope="row" class="px-4 sm:px-6 py-4 font-medium whitespace-nowrap text-left">
            <%= link_to product.name, product_path(product.id), class: "text-[#131D58] hover:text-[#0D9C67] font-semibold" %>
          </th>
          <td class="px-4 sm:px-6 py-4">
            <%= product.description.truncate(50) %>
          </td>
          <td class="px-4 sm:px-6 py-4 hide-in-sidebar">
            <%= product.start_date.strftime("%d-%b-%y") %>
          </td>
          <td class="px-4 sm:px-6 py-4 hide-in-sidebar">
            <% if product.end_date.present? %>
              <% if product.end_date <= Date.today %>
                <span class="inline-flex items-center rounded-full bg-red-50 text-red-700 text-xs font-semibold px-2.5 py-1">
                  <%= product.end_date.strftime("%d-%b-%y") %>
                </span>
              <% else %>
                <span class="inline-flex items-center rounded-full bg-[#E3F6EC] text-[#0B4A32] text-xs font-semibold px-2.5 py-1">
                  <%= product.end_date.strftime("%d-%b-%y") %>
                </span>
              <% end %>
            <% end %>
          </td>
          <td class="px-4 sm:px-6 py-4">
            <%= product.user.name %>
          </td>
          <td class="px-4 sm:px-6 py-4 capitalize">
            <% product.softwares.each do |software| %>  <!-- Iterate through software for the current project -->
              <%= software.name %>
            <% end %>
          </td>
          <td class="px-4 sm:px-6 py-4 capitalize ">
            <% if product.client.present? && product.client.name.present? %>
              <%= product.client.name %>
            <% end %>
          </td>

          <!-- Actions -->
          <td class="px-4 sm:px-6 py-4 whitespace-nowrap font-medium text-right" data-controller="dropdown" data-dropdown-ticket-id-value="<%= product.id %>">
            <div class="relative w-full flex justify-end">
              <%= render partial: 'product/action_dropdown', locals: { product: product } %>
            </div>
          </td>
        </tr>
      <% end %>
    <% end %>
    </tbody>
  </table>
</div>
<div class="flex items-center justify-between gap-4 mt-5">
  <!-- Pagination Controls -->
  <div class="pagination flex items-center gap-4">
    <% if @page > 1 %>
      <%= link_to 'Previous', product_index_path(@product, page: @page - 1, query: params[:query]), class: 'bg-[#131D58] hover:bg-[#0E1642] px-4 py-2 rounded-lg font-semibold text-sm text-white transition-colors' %>
    <% end %>
    <span class="text-sm text-gray-500">Page <span class="font-semibold text-[#131D58]"><%= @page %></span> of <%= @total_pages %></span>
    <% if @page < @total_pages %>
      <%= link_to 'Next', product_index_path(@product, page: @page + 1, query: params[:query]), class: 'bg-[#131D58] hover:bg-[#0E1642] px-4 py-2 rounded-lg font-semibold text-sm text-white transition-colors' %>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    const sidebar = document.getElementById("sidebar"); // Ensure sidebar has this ID
    const tableColumns = document.querySelectorAll(".hide-in-sidebar");

    function toggleColumns() {
      if (sidebar.classList.contains("w-64")) {
        // If sidebar is expanded, hide the columns
        tableColumns.forEach(col => {
          col.style.display = "none";
        });
      } else {
        // If sidebar is collapsed, show the columns
        tableColumns.forEach(col => {
          col.style.display = "table-cell"; // Use table-cell instead of block
        });
      }
    }

    toggleColumns(); // Run initially
    const observer = new MutationObserver(toggleColumns);
    observer.observe(sidebar, { attributes: true });
  });
</script>
