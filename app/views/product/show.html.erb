<% provide(:title, "Project: #{@product.client.name}") %>

<div class="min-h-screen bg-gray-50 px-3 py-4 sm:px-6 sm:py-6 lg:px-8">

  <% if flash[:notice] %>
    <div class="flex items-start gap-3 bg-[#E3F6EC] border border-[#0D9C67]/30 text-[#0B4A32] px-4 py-3 rounded-xl mb-4 shadow-sm">
      <svg class="w-5 h-5 flex-shrink-0 text-[#0D9C67] mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <p class="text-sm font-medium"><%= flash[:notice] %></p>
    </div>
  <% elsif flash[:alert] %>
    <div class="flex items-start gap-3 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl mb-4 shadow-sm">
      <svg class="w-5 h-5 flex-shrink-0 text-red-600 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
      </svg>
      <p class="text-sm font-medium"><%= flash[:alert] %></p>
    </div>
  <% end %>

  <%= render 'product/product_show_topbar' %>

  <div class="bg-white max-w-full rounded-xl shadow-sm border border-gray-100 p-4 sm:p-6 mb-6">
    <%= render 'layouts/alert' %>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- First Column: List milestones -->
      <div class="grid grid-cols-1 gap-4 col-span-1">
        <h2 class="text-base sm:text-lg font-semibold text-[#131D58] mb-1">Milestones</h2>
        <% if @product.milestones.any? %>
          <ul class="space-y-3">
            <% @product.milestones.each do |milestone| %>
              <li class="bg-[#F4F5FA] p-4 rounded-lg border border-gray-100">
                <p class="text-sm text-gray-700">
                  <strong class="text-[#131D58]">Status:</strong> <%= milestone.status&.name || 'N/A' %>
                </p>
                <p class="text-sm text-gray-700">
                  <strong class="text-[#131D58]">Percentage:</strong> <%= milestone.percentage %>%
                </p>
                <% if @product.budget.present? %>
                  <p class="text-sm text-gray-700">
                    <strong class="text-[#131D58]">Amount:</strong> KES <%= number_with_precision(@product.budget * milestone.percentage.to_f / 100, precision: 2) %>
                  </p>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-gray-400">No milestones available for this product.</p>
        <% end %>
      </div>

      <!-- Documents -->
      <div class="grid grid-cols-1 gap-3 col-span-1">
        <h2 class="text-base sm:text-lg font-semibold text-[#131D58] mb-1">Documents</h2>
        <div class="flex">
          <% if @product.documents.any? %>
            <ul class="space-y-2 w-full">
              <% @product.documents.each do |document| %>
                <li class="flex items-center justify-between gap-2 bg-[#F4F5FA] px-3 py-2 rounded-lg border border-gray-100">
                  <span class="capitalize text-sm text-gray-700 truncate"><%= document.name %></span>
                  <% if document.file.attached? %>
                    <%= link_to "Download", rails_blob_path(document.file, disposition: "attachment"), class: "text-sm font-medium text-[#0D9C67] hover:text-[#0B8659] flex-shrink-0" %>
                  <% else %>
                    <span class="text-xs text-gray-400 flex-shrink-0">No file</span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-gray-400">There are no documents for this product.</p>
          <% end %>
        </div>
      </div>

      <!-- Admin Only Section -->
      <% if current_user.has_role?(:admin) %>
        <div class="grid grid-cols-1 gap-3 col-span-1">
          <h2 class="text-base sm:text-lg font-semibold text-[#131D58] mb-1">Advance Status</h2>
          <%= render partial: 'product/add_statuses', locals: { product: @product } %>
        </div>
      <% end %>
    </div>
  </div>


  <!-- The products search form partial -->
  <div class="">
    <%= render 'product/product_show_search' %>
  </div>


  <div class="relative max-w-full">
    <% if @product.added_to?(current_user) || current_user.has_role?(:admin) || current_user.has_role?(:observer) || current_user.has_role?(:hod) %>
      <div class="p-1 sm:p-2 overflow-x-auto pb-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 min-w-full">

          <% ordered_statuses = ['Reopened', 'TO DO', 'In Progress', 'On-Hold', 'Await Client Information',
                                 'Failed-QA', 'QA-testing', 'Awaiting Build', 'Awaiting Client API',
                                 'Blocked', 'Resolved', 'Closed'] %>

          <% categorized_statuses = @tasks_by_status.slice(*ordered_statuses) %>
          <% uncategorized_statuses = @tasks_by_status.except(*ordered_statuses) %>

          <% ordered_statuses.each do |status| %>
            <% tasks = categorized_statuses[status] || [] %>
            <% next if tasks.empty? %>

            <div class="bg-white border border-gray-100 rounded-xl shadow-sm px-3 py-3">
              <!-- Board Header -->
              <div class="flex justify-between items-center mb-2 mx-1">
                <div class="flex items-center gap-2">
                  <h2 class="text-sm w-max px-2 py-1 rounded-lg bg-[#F4F5FA] text-[#131D58] capitalize flex items-center gap-2 font-semibold">
                    <% case status %>
                    <% when "TO DO" %>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m.75 12 3 3m0 0 3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                      </svg>
                    <% when "In Progress" %>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                      </svg>
                    <% when "Under Development" %>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
                      </svg>
                    <% when "Blocked" %>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0-10.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.25-8.25-3.286Zm0 13.036h.008v.008H12v-.008Z" />
                      </svg>
                    <% end %>
                    <%= status %>
                  </h2>
                  <p class="text-xs font-semibold bg-[#E3F6EC] text-[#0B4A32] rounded-full px-2 py-0.5"><%= tasks.count %></p>
                </div>
                <div class="text-lg font-bold text-gray-300">+</div>
              </div>

              <!-- Board Cards -->
              <div class="grid gap-2 p-1">
                <% tasks.each do |task| %>
                  <%= render partial: 'tasks/card', locals: { task: task } %>
                <% end %>
              </div>
            </div>
          <% end %>

          <% # Render Uncategorized Tasks %>
          <% uncategorized_tasks = uncategorized_statuses.values.flatten.compact %>
          <% if uncategorized_tasks.any? %>
            <div class="bg-white border border-gray-100 rounded-xl shadow-sm px-3 py-3">
              <div class="flex justify-between items-center mb-2 mx-1">
                <div class="flex items-center gap-2">
                  <h2 class="text-sm w-max px-2 py-1 rounded-lg bg-[#F4F5FA] text-[#131D58] capitalize flex items-center gap-2 font-semibold">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0-10.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.25-8.25-3.286Zm0 13.036h.008v.008H12v-.008Z" />
                    </svg>
                    Uncategorized
                  </h2>
                  <p class="text-xs font-semibold bg-[#E3F6EC] text-[#0B4A32] rounded-full px-2 py-0.5"><%= uncategorized_tasks.count %></p>
                </div>
              </div>

              <div class="grid gap-2 p-1">
                <% uncategorized_tasks.each do |task| %>
                  <%= render partial: 'tasks/card', locals: { task: task } %>
                <% end %>
              </div>
            </div>
          <% end %>

        </div>
      </div>
  <% end %>
  </div>
</div>
