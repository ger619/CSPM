<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 w-full p-3 rounded-xl border border-gray-100 mb-4 bg-white shadow-sm">
  <!-- Search Form -->
  <div class="flex-1 flex items-center">
    <%= form_with url: product_path(@product), method: :get, class: 'flex w-full max-w-xl gap-2', data: { controller: 'search-form', action: 'submit->search-form#submit' } do |f| %>
      <!-- Hidden fields to preserve other params -->
      <%= hidden_field_tag :filter, params[:filter] if params[:filter].present? %>

      <div class="relative flex-grow">
        <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
          <svg class="w-4 h-4 text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
          </svg>
        </div>
        <%= f.text_field :query,
              value: params[:query],
              class: "block w-full p-2.5 pl-10 text-sm border-gray-300 border rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] placeholder-gray-400",
              placeholder: "Search tasks by name, description, priority...",
              data: { 'search-form-target': 'input' } %>
      </div>
      <%= f.submit "Search",
            class: 'bg-[#131D58] hover:bg-[#0E1642] px-4 py-2.5 rounded-lg font-semibold text-white text-sm transition-colors' %>
    <% end %>
  </div>

  <!-- Clear Filters Button -->
  <div>
    <%= link_to "Clear Filters", product_path(@product),
          class: 'block text-center bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2.5 rounded-lg font-medium text-sm transition-colors whitespace-nowrap' %>
  </div>
</div>
