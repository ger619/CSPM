<% provide(:title, "Home") %>

<div class="min-h-screen bg-slate-50 px-4 py-6 dark:bg-slate-950 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="mb-8 overflow-hidden rounded-3xl bg-gradient-to-r from-[#0A1629] via-[#1a237e] to-[#3F8CFF] p-6 shadow-xl shadow-blue-500/20 sm:p-8">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.25em] text-blue-100">
            Dashboard Overview
          </p>
          <h1 class="mt-2 text-2xl font-black tracking-tight text-white sm:text-4xl">
            Service Desk Analytics
          </h1>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100 sm:text-base">
            Monitor service desks, tickets, active users, and recent activity from one simple dashboard.
          </p>
        </div>

        <div class="rounded-2xl border border-white/20 bg-white/10 px-5 py-4 text-white backdrop-blur">
          <p class="text-xs font-semibold uppercase tracking-wide text-blue-100">
            Logged in as
          </p>
          <p class="mt-1 text-lg font-bold capitalize">
            <%= current_user.first_name %> <%= current_user.last_name %>
          </p>
        </div>
      </div>
    </div>

    <% if current_user.has_role?(:admin) || current_user.has_role?(:observer) %>
      <section class="mb-8">
        <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm font-bold uppercase tracking-wide text-[#3F8CFF]">
              Admin Overview
            </p>
            <h2 class="text-xl font-black text-[#0A1629] dark:text-white sm:text-2xl">
              System Summary
            </h2>
          </div>
          <p class="text-sm text-slate-500 dark:text-slate-400">
            High-level system activity and user engagement.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
          <div class="group rounded-3xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                  All Service Desks
                </p>
                <p class="mt-3 text-3xl font-black text-[#0A1629] dark:text-white">
                  <%= @all_service_desks_count %>
                </p>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#3F8CFF]/10 text-[#3F8CFF]">
                <span class="text-xl font-black">SD</span>
              </div>
            </div>
          </div>

          <%= link_to active_users_path, class: "group rounded-3xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900" do %>
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                  Active Users
                </p>
                <p class="mt-1 text-xs text-slate-400">
                  Users who have logged in more than once
                </p>
                <p class="mt-3 text-3xl font-black text-[#0A1629] dark:text-white">
                  <%= @users_who_have_loggedin_more_than_once_count %>
                </p>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-600">
                <span class="text-xl font-black">U</span>
              </div>
            </div>
          <% end %>

          <%= link_to active_client_users_path, class: "group rounded-3xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900" do %>
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                  Active Clients
                </p>
                <p class="mt-1 text-xs text-slate-400">
                  Clients who have logged in more than once
                </p>
                <p class="mt-3 text-3xl font-black text-[#0A1629] dark:text-white">
                  <%= @clients_who_have_loggedin_more_than_once_count %>
                </p>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-purple-100 text-purple-600">
                <span class="text-xl font-black">C</span>
              </div>
            </div>
          <% end %>

          <%= link_to active_manager_users_path, class: "group rounded-3xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900" do %>
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                  Active Project Managers
                </p>
                <p class="mt-1 text-xs text-slate-400">
                  Project managers who have logged in more than once
                </p>
                <p class="mt-3 text-3xl font-black text-[#0A1629] dark:text-white">
                  <%= @project_managers_who_have_loggedin_more_than_once_count %>
                </p>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-600">
                <span class="text-xl font-black">PM</span>
              </div>
            </div>
          <% end %>

          <%= link_to active_agent_users_path, class: "group rounded-3xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900" do %>
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                  Active Internal Users
                </p>
                <p class="mt-1 text-xs text-slate-400">
                  Agents who have logged in more than once
                </p>
                <p class="mt-3 text-3xl font-black text-[#0A1629] dark:text-white">
                  <%= @agents_who_have_loggedin_more_than_once_count %>
                </p>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-100 text-cyan-600">
                <span class="text-xl font-black">A</span>
              </div>
            </div>
          <% end %>

          <% if current_user.projects.any? %>
            <%= link_to closed_tickets_one_week_project_tickets_path(project_id: current_user.projects.first.id), class: "group rounded-3xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900" do %>
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                    Tickets Closed
                  </p>
                  <p class="mt-1 text-xs text-slate-400">
                    In the last one week
                  </p>
                  <p class="mt-3 text-3xl font-black text-[#0A1629] dark:text-white">
                    <%= @tickets_closed_in_last_one_week_count %>
                  </p>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-green-100 text-green-600">
                  <span class="text-xl font-black">✓</span>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
              <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                No tickets closed in the last one week
              </p>
            </div>
          <% end %>

          <div class="group rounded-3xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                  All Tickets
                </p>
                <p class="mt-3 text-3xl font-black text-[#0A1629] dark:text-white">
                  <%= @all_tickets_count %>
                </p>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#0A1629]/10 text-[#0A1629] dark:bg-white/10 dark:text-white">
                <span class="text-xl font-black">T</span>
              </div>
            </div>
          </div>

          <% if current_user.projects.any? %>
            <%= link_to all_open_tickets_project_tickets_path(project_id: current_user.projects.first.id), class: "group rounded-3xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900" do %>
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                    All Open Tickets
                  </p>
                  <p class="mt-3 text-3xl font-black text-[#0A1629] dark:text-white">
                    <%= @all_open_tickets_for_current_user_count %>
                  </p>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-red-100 text-red-600">
                  <span class="text-xl font-black">!</span>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
              <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                No open tickets available
              </p>
            </div>
          <% end %>

          <% if current_user.projects.any? %>
            <%= link_to created_tickets_one_week_project_tickets_path(project_id: current_user.projects.first.id), class: "group rounded-3xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900" do %>
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                    Tickets Created
                  </p>
                  <p class="mt-1 text-xs text-slate-400">
                    In the last one week
                  </p>
                  <p class="mt-3 text-3xl font-black text-[#0A1629] dark:text-white">
                    <%= @tickets_created_in_last_one_week_count %>
                  </p>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-100 text-[#3F8CFF]">
                  <span class="text-xl font-black">+</span>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
              <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                No tickets created in the last one week
              </p>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <section class="mb-8">
      <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-bold uppercase tracking-wide text-[#3F8CFF]">
            My Workspace
          </p>
          <h2 class="text-xl font-black text-[#0A1629] dark:text-white sm:text-2xl">
            Personal Ticket Summary
          </h2>
        </div>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          Quick access to your assigned service desk activity.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        <%= link_to project_index_path, class: "group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900" do %>
          <div class="h-2 bg-gradient-to-r from-[#1a237e] to-[#3F8CFF]"></div>
          <div class="p-5">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                  Number of Service Desks
                </p>
                <p class="mt-3 text-4xl font-black text-[#0A1629] dark:text-white">
                  <%= current_user.all_projects_for_the_current_user_count %>
                </p>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#3F8CFF]/10 text-[#3F8CFF]">
                <span class="text-xl font-black">SD</span>
              </div>
            </div>
          </div>
        <% end %>

        <% if current_user.projects.any? %>
          <%= link_to project_tickets_path(project_id: current_user.projects.first.id, status: "open", user_id: current_user.id), class: "group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900" do %>
            <div class="h-2 bg-gradient-to-r from-amber-400 to-orange-500"></div>
            <div class="p-5">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                    My Open Tickets
                  </p>
                  <p class="mt-3 text-4xl font-black text-[#0A1629] dark:text-white">
                    <%= current_user.all_open_tickets_for_the_current_user_count %>
                  </p>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-600">
                  <span class="text-xl font-black">!</span>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
            <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
              No tickets available
            </p>
          </div>
        <% end %>

        <% if current_user.projects.any? %>
          <%= link_to all_tickets_project_tickets_path(project_id: current_user.projects.first.id, status: "open"), class: "group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900" do %>
            <div class="h-2 bg-gradient-to-r from-red-400 to-rose-600"></div>
            <div class="p-5">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                    Total Open Tickets
                  </p>
                  <p class="mt-3 text-4xl font-black text-[#0A1629] dark:text-white">
                    <%= @total_no_of_open_tickets_for_current_user_count %>
                  </p>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-red-100 text-red-600">
                  <span class="text-xl font-black">O</span>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
            <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
              No open tickets available
            </p>
          </div>
        <% end %>
      </div>
    </section>

    <section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="border-b border-slate-200 bg-slate-50 px-5 py-4 dark:border-slate-800 dark:bg-slate-900/60 sm:px-6">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-sm font-bold uppercase tracking-wide text-[#3F8CFF]">
              Ticket Breakdown
            </p>
            <h2 class="text-lg font-black text-[#0A1629] dark:text-white sm:text-xl">
              Tickets Per Service Desk
            </h2>
          </div>
          <div class="rounded-full bg-[#3F8CFF]/10 px-4 py-2 text-xs font-bold text-[#3F8CFF]">
            Live Summary
          </div>
        </div>
      </div>

      <div class="overflow-x-auto p-4 sm:p-6">
        <div class="min-w-full text-slate-700 dark:text-slate-200">
          <%= render "home/table_ticket_per_project" %>
        </div>
      </div>
    </section>
  </div>
</div>