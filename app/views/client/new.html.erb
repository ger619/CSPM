<% provide(:title, "New Client Record") %>

<div class="min-h-screen bg-gray-50 px-3 py-4 sm:px-6 sm:py-6 lg:px-8">
  <div class="max-w-3xl mx-auto bg-white rounded-xl shadow-sm border border-gray-100 p-5 sm:p-6">
    <h1 class="text-xl sm:text-2xl font-bold text-[#131D58] mb-6">New Client Record</h1>

    <%= form_with model: @client, url: client_index_url, method: :post, data: { turbo: false }, local: true do |f| %>
      <div class="space-y-5">

        <div class="bg-[#F4F5FA] p-4 rounded-xl grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :name, 'Name*', class: "block mb-2 text-sm font-medium text-[#131D58]" %>
            <%= f.text_field :name, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", required: true %>
          </div>
          <div>
            <%= f.label :email, 'Email', class: "block mb-2 text-sm font-medium text-[#131D58]" %>
            <%= f.email_field :email, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white" %>
          </div>
        </div>

        <div class="bg-[#F4F5FA] p-4 rounded-xl grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :phone, 'Phone', class: "block mb-2 text-sm font-medium text-[#131D58]" %>
            <%= f.text_field :phone, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white" %>
          </div>
          <div>
            <%= f.label :address, 'Address', class: "block mb-2 text-sm font-medium text-[#131D58]" %>
            <%= f.text_field :address, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white" %>
          </div>
        </div>

        <div class="bg-[#F4F5FA] p-4 rounded-xl">
          <h3 class="text-sm font-semibold text-[#131D58] mb-4">Primary Contact</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= f.label :client_contact_person, 'Contact Name', class: "block mb-2 text-sm font-medium text-[#131D58]" %>
              <%= f.text_field :client_contact_person, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white" %>
            </div>
            <div>
              <%= f.label :client_contact_phone_number, 'Contact Phone Number', class: "block mb-2 text-sm font-medium text-[#131D58]" %>
              <%= f.text_field :client_contact_phone_number, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white" %>
            </div>
            <div>
              <%= f.label :client_contact_person_email, 'Contact Email', class: "block mb-2 text-sm font-medium text-[#131D58]" %>
              <%= f.email_field :client_contact_person_email, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white" %>
            </div>
            <div>
              <%= f.label :country_code, 'Country*', class: "block mb-2 text-sm font-medium text-[#131D58]" %>
              <%= f.country_select :country_code, { prompt: 'Select a country' },
                                   class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", required: true %>
            </div>
          </div>
        </div>

        <div class="flex justify-end pt-2">
          <%= f.submit 'Create Client', class: 'bg-[#0D9C67] hover:bg-[#0B8659] text-white px-5 py-2.5 rounded-lg font-semibold text-sm transition-colors cursor-pointer' %>
        </div>
      </div>
    <% end %>
  </div>
</div>
