<div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between p-4 bg-white border border-gray-100 rounded-xl shadow-sm mb-5">
  <div class="flex flex-col sm:flex-row sm:items-center gap-2 w-full lg:w-auto">
    <% if can? :create, @software %>
      <% if current_user.has_role? :admin %>
        <%= button_to software_index_path, method: :get, class: 'inline-flex items-center justify-center gap-1.5 bg-gray-100 hover:bg-gray-200 px-4 py-2.5 rounded-lg font-semibold text-sm text-gray-700 transition-colors' do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
          </svg>
          Back
        <% end %>
        <%= button_to new_software_groupware_path(@software), method: :get, class: 'inline-flex items-center justify-center gap-1.5 bg-[#0D9C67] hover:bg-[#0B8659] px-4 py-2.5 rounded-lg font-semibold text-sm text-white shadow-sm transition-colors' do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Add Product
        <% end %>
      <% end %>
    <% end %>
  </div>

  <!-- Search on the right -->
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full lg:w-auto">
    <%= form_with url: software_path(@software), method: :get, class: 'flex gap-2 flex-1' do |f| %>
      <div class="relative flex-grow min-w-0 sm:min-w-[220px]">
        <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
          <svg class="w-4 h-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
          </svg>
        </div>
        <%= f.text_field :query, placeholder: "Search groupware...", class: "w-full border border-gray-300 pl-9 pr-4 py-2.5 rounded-lg text-sm font-medium placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67]" %>
      </div>
      <%= f.submit "Search", class: 'bg-[#131D58] hover:bg-[#0E1642] px-4 py-2.5 rounded-lg text-sm font-semibold text-white transition-colors whitespace-nowrap' %>
    <% end %>
    <%= form_with url: software_path(@software), method: :get, class: 'flex' do |f| %>
      <%= f.submit "Clear", class: 'w-full sm:w-auto bg-gray-100 hover:bg-gray-200 px-4 py-2.5 rounded-lg font-medium text-sm text-gray-700 transition-colors whitespace-nowrap'  %>
    <% end %>
  </div>
</div>
