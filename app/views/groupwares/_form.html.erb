<%= form_with(model: [software, software.groupwares.build], data: { turbo: false }, local: true, html: { multipart: true }) do |f| %>
  <div class="space-y-5">
    <div class="bg-[#F4F5FA] p-4 rounded-xl">
      <%= f.label :name, 'Name*', class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
      <%= f.text_field :name, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", placeholder: '', required: true %>
    </div>

    <div class="bg-[#F4F5FA] p-4 rounded-xl">
      <%= f.label :description, 'Description*', class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
      <%= f.text_field :description, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", placeholder: '', required: true %>
    </div>

    <div class="bg-[#F4F5FA] p-4 rounded-xl">
      <%= f.label :Assignee, 'Assignee*', class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
      <%= f.select :user_id, User.with_agent_project_manager_role.order(:first_name, :last_name).map { |user| [user.name, user.id] }, {},
                   class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", placeholder: 'Assign User', required: true %>
    </div>

    <div class="bg-[#F4F5FA] p-4 rounded-xl">
      <%= f.label :image, 'Product Image (Only Images)', class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
      <%= f.file_field :image, accept: 'image/*', class: "border border-gray-300 rounded-lg block w-full p-2 text-sm bg-white file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:bg-[#131D58] file:text-white file:text-sm file:font-medium file:cursor-pointer" %>
    </div>

    <div class="flex justify-end">
      <%= f.submit "Submit", class: 'bg-[#0D9C67] hover:bg-[#0B8659] text-white px-5 py-2.5 rounded-lg font-semibold text-sm transition-colors cursor-pointer' %>
    </div>
  </div>
<% end %>
