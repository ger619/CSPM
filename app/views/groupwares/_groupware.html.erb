<% if @groupware.empty? %>
  <div class="flex flex-col items-center justify-center text-center py-16 px-4 bg-white border border-gray-100 rounded-xl shadow-sm">
    <div class="w-14 h-14 rounded-full bg-[#E8EAF3] flex items-center justify-center mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#131D58]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
      </svg>
    </div>
    <p class="text-sm font-semibold text-[#131D58] mb-1">No groupware products yet</p>
    <p class="text-sm text-gray-500">Add a groupware product to start organising work under this software.</p>
  </div>
<% else %>

  <!-- Desktop / tablet table -->
  <div class="hidden sm:block overflow-x-auto rounded-xl border border-gray-100 shadow-sm bg-white">
    <table class="w-full text-sm text-left text-gray-600">
      <thead class="text-xs uppercase bg-[#F4F5FA] text-[#131D58] font-semibold">
      <tr>
        <th scope="col" class="px-6 py-3 whitespace-nowrap">Name of the Software Product</th>
        <th scope="col" class="px-6 py-3 whitespace-nowrap">Description</th>
        <th scope="col" class="px-6 py-3 whitespace-nowrap">Project Manager</th>
        <th scope="col" class="px-6 py-3 whitespace-nowrap text-right">Actions</th>
      </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
      <% @groupware.each do |group| %>
        <tr class="bg-white hover:bg-[#F4F5FA] transition-colors">
          <td class="px-6 py-4 font-semibold whitespace-nowrap">
            <%= link_to group.name, [group.software, group], class: "text-[#131D58] hover:text-[#0D9C67] font-semibold" %>
          </td>
          <td class="px-6 py-4 capitalize text-gray-600">
            <div class="truncate max-w-sm"><%= group.description %></div>
          </td>
          <td class="px-6 py-4 capitalize">
            <% if group.user.present? %>
              <span class="text-gray-700"><%= group.user.name %></span>
            <% else %>
              <span class="text-gray-400">No user assigned</span>
            <% end %>
          </td>
          <td class="px-6 py-4">
            <div class="flex items-center justify-end gap-2">
              <%= link_to [group.software, group], class: 'inline-flex items-center gap-1.5 bg-gray-100 hover:bg-gray-200 px-3 py-1.5 rounded-lg font-semibold text-xs text-gray-700 transition-colors' do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-3.5 w-3.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
                View
              <% end %>
              <%= link_to edit_software_groupware_path(group.software, group), class: 'inline-flex items-center gap-1.5 bg-[#131D58] hover:bg-[#0E1642] px-3 py-1.5 rounded-lg font-semibold text-xs text-white transition-colors' do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-3.5 w-3.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                </svg>
                Edit
              <% end %>
              <% if can? :destroy, group %>
                <%= button_to 'Delete', [group.software, group], method: :delete,
                    data: { 'turbo_method': :delete, 'turbo-confirm': 'Are you sure?' },
                    class: 'inline-flex items-center gap-1.5 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-lg font-semibold text-xs text-red-600 transition-colors' %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>

  <!-- Mobile cards -->
  <div class="sm:hidden grid grid-cols-1 gap-3">
    <% @groupware.each do |group| %>
      <div class="bg-white border border-gray-100 rounded-xl shadow-sm p-4">
        <%= link_to group.name, [group.software, group], class: "text-[#131D58] font-semibold text-base truncate block" %>
        <p class="text-sm text-gray-500 mt-0.5 capitalize line-clamp-2"><%= group.description %></p>
        <p class="text-xs text-gray-400 mt-2">
          <%= group.user.present? ? "Project Manager: #{group.user.name}" : "No project manager assigned" %>
        </p>
        <div class="flex items-center gap-2 mt-3">
          <%= link_to [group.software, group], class: 'flex-1 inline-flex items-center justify-center gap-1.5 bg-gray-100 hover:bg-gray-200 px-3 py-2 rounded-lg font-semibold text-xs text-gray-700 transition-colors' do %>
            View
          <% end %>
          <%= link_to edit_software_groupware_path(group.software, group), class: 'flex-1 inline-flex items-center justify-center gap-1.5 bg-[#131D58] hover:bg-[#0E1642] px-3 py-2 rounded-lg font-semibold text-xs text-white transition-colors' do %>
            Edit
          <% end %>
          <% if can? :destroy, group %>
            <%= button_to 'Delete', [group.software, group], method: :delete,
                data: { 'turbo_method': :delete, 'turbo-confirm': 'Are you sure?' },
                class: 'flex-1 inline-flex items-center justify-center gap-1.5 bg-red-50 hover:bg-red-100 px-3 py-2 rounded-lg font-semibold text-xs text-red-600 transition-colors w-full' %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
