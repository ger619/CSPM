<div class="flex flex-row items-center justify-between bg-white px-4 py-3 border-b border-slate-100">
  <%= button_to root_path, method: :get, class: 'group flex items-center gap-1.5 bg-white hover:bg-slate-50 border border-[#131D58]/20 hover:border-[#131D58] px-4 py-2 rounded-lg font-semibold text-sm text-[#131D58] transition-all duration-200', id: 'back-button' do %>
    <svg class="w-4 h-4 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
    </svg>
    Back
  <% end %>

  <% if can? :create, @project %>
    <% if current_user.has_role? :admin or current_user.has_role?('project manager') %>
      <div class="flex gap-2">
        <%= button_to new_project_path, method: :get, class: 'group flex items-center gap-1.5 bg-[#0D9C66] hover:bg-[#0B8558] px-4 py-2 rounded-lg font-semibold text-sm text-white shadow-sm hover:shadow transition-all duration-200 active:scale-95', id: 'add-button' do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Add Service Desk
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>