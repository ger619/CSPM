<% if current_user.has_role?(:admin) || current_user.has_role?('project manager') || current_user.has_role?(:agent) %>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <!-- Craft Silicon Staff -->
    <div class="rounded-3xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900/60" data-controller="expandable-list">
      <div class="mb-3 flex items-center gap-2.5">
        <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-xl bg-[#3F8CFF]/10 text-[#3F8CFF]">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" class="h-4.5 w-4.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-sm font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Craft Silicon staff</h3>
      </div>

      <% craft_silicon_users = @craft_silicon_users || [] %>

      <% if craft_silicon_users.any? %>
        <div data-expandable-list-target="initialList">
          <div class="flex flex-wrap gap-1.5">
            <% craft_silicon_users.first(5).each do |user| %>
              <span class="rounded-full bg-white px-3 py-1 text-xs font-bold text-slate-700 shadow-sm dark:bg-slate-800 dark:text-slate-200"><%= user.name %></span>
            <% end %>
          </div>
        </div>

        <div class="mt-2 hidden" data-expandable-list-target="fullList">
          <div class="flex flex-wrap gap-1.5">
            <% craft_silicon_users.each do |user| %>
              <span class="rounded-full bg-white px-3 py-1 text-xs font-bold text-slate-700 shadow-sm dark:bg-slate-800 dark:text-slate-200"><%= user.name %></span>
            <% end %>
          </div>
        </div>

        <% if craft_silicon_users.count > 5 %>
          <button class="mt-3 flex items-center gap-1 text-xs font-bold text-[#3F8CFF] hover:text-[#3A81EB]"
                  data-action="expandable-list#toggle">
            <span data-expandable-list-target="showText">Show all (<%= craft_silicon_users.count %>)</span>
            <span class="hidden" data-expandable-list-target="hideText">Hide</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-200"
                 viewBox="0 0 20 20" fill="currentColor"
                 data-expandable-list-target="icon">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
        <% end %>
      <% else %>
        <p class="text-sm font-semibold text-slate-400">No staff assigned yet.</p>
      <% end %>
    </div>

    <!-- Clients -->
    <div class="rounded-3xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900/60" data-controller="expandable-list">
      <div class="mb-3 flex items-center gap-2.5">
        <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-xl bg-[#0D9C66]/10 text-[#0D9C66]">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" class="h-4.5 w-4.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
        </div>
        <h3 class="text-sm font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Clients</h3>
      </div>

      <% non_craft_silicon_users = @non_craft_silicon_users || [] %>

      <% if non_craft_silicon_users.any? %>
        <div data-expandable-list-target="initialList">
          <div class="flex flex-wrap gap-1.5">
            <% non_craft_silicon_users.first(5).each do |user| %>
              <span class="rounded-full bg-white px-3 py-1 text-xs font-bold text-slate-700 shadow-sm dark:bg-slate-800 dark:text-slate-200"><%= user.name %></span>
            <% end %>
          </div>
        </div>

        <div class="mt-2 hidden" data-expandable-list-target="fullList">
          <div class="flex flex-wrap gap-1.5">
            <% non_craft_silicon_users.each do |user| %>
              <span class="rounded-full bg-white px-3 py-1 text-xs font-bold text-slate-700 shadow-sm dark:bg-slate-800 dark:text-slate-200"><%= user.name %></span>
            <% end %>
          </div>
        </div>

        <% if non_craft_silicon_users.count > 5 %>
          <button class="mt-3 flex items-center gap-1 text-xs font-bold text-[#0D9C66] hover:text-[#0B8558]"
                  data-action="expandable-list#toggle">
            <span data-expandable-list-target="showText">Show all (<%= non_craft_silicon_users.count %>)</span>
            <span class="hidden" data-expandable-list-target="hideText">Hide</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-200"
                 viewBox="0 0 20 20" fill="currentColor"
                 data-expandable-list-target="icon">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
        <% end %>
      <% else %>
        <p class="text-sm font-semibold text-slate-400">No clients assigned yet.</p>
      <% end %>
    </div>
  </div>
<% end %>
