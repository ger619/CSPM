<% provide(:title, "Support Desk: #{@project.title}") %>

<div class="min-h-screen bg-slate-50 px-4 py-6 dark:bg-slate-950 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <% if flash[:notice] %>
      <div class="mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-4 text-emerald-800 shadow-sm dark:border-emerald-900 dark:bg-emerald-950 dark:text-emerald-200 sm:px-5">
        <div class="flex items-start gap-3">
          <div class="mt-0.5 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600 dark:bg-emerald-900 dark:text-emerald-300">
            ✓
          </div>
          <div>
            <p class="text-sm font-bold">Success</p>
            <p class="mt-1 text-sm"><%= flash[:notice] %></p>
          </div>
        </div>
      </div>
    <% elsif flash[:alert] %>
      <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-4 text-red-800 shadow-sm dark:border-red-900 dark:bg-red-950 dark:text-red-200 sm:px-5">
        <div class="flex items-start gap-3">
          <div class="mt-0.5 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-xl bg-red-100 text-red-600 dark:bg-red-900 dark:text-red-300">
            !
          </div>
          <div>
            <p class="text-sm font-bold">Alert</p>
            <p class="mt-1 text-sm"><%= flash[:alert] %></p>
          </div>
        </div>
      </div>
    <% end %>

    <%= render "tickets/ticket_topbar" %>

    <section class="mb-6 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-6">
      <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-bold uppercase tracking-wide text-[#3F8CFF]">
            Overview
          </p>
          <h2 class="text-xl font-black text-[#0A1629] dark:text-white sm:text-2xl">
            Support Desk Summary
          </h2>
        </div>

        <div class="rounded-full bg-[#3F8CFF]/10 px-4 py-2 text-xs font-bold text-[#3F8CFF]">
          <%= @ticket_count %> Total Tickets
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 xl:grid-cols-5">
        <div class="space-y-4 xl:col-span-1">
          <div class="rounded-3xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900/60">
            <div class="flex items-start gap-3">
              <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-2xl bg-[#3F8CFF]/10 text-[#3F8CFF]">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" class="h-5 w-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                </svg>
              </div>

              <div class="min-w-0">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-400">
                  Support Desk Manager
                </p>
                <p class="mt-1 truncate text-sm font-black text-[#0A1629] dark:text-white">
                  <%= @project.user&.name || "No Project Manager Assigned" %>
                </p>
              </div>
            </div>
          </div>

          <div class="rounded-3xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900/60">
            <div class="flex items-start gap-3">
              <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-2xl bg-[#3F8CFF]/10 text-[#3F8CFF]">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" class="h-5 w-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 2.994v2.25m10.5-2.25v2.25m-14.252 13.5V7.491a2.25 2.25 0 0 1 2.25-2.25h13.5a2.25 2.25 0 0 1 2.25 2.25v11.251m-18 0a2.25 2.25 0 0 0 2.25 2.25h13.5a2.25 2.25 0 0 0 2.25-2.25m-18 0v-7.5a2.25 2.25 0 0 1 2.25-2.25h13.5a2.25 2.25 0 0 1 2.25 2.25v7.5m-6.75-6h2.25m-9 2.25h4.5m.002-2.25h.005v.006H12v-.006Zm-.001 4.5h.006v.006h-.006v-.005Zm-2.25.001h.005v.006H9.75v-.006Zm-2.25 0h.005v.005h-.006v-.005Zm6.75-2.247h.005v.005h-.005v-.005Zm0 2.247h.006v.006h-.006v-.006Zm2.25-2.248h.006V15H16.5v-.005Z" />
                </svg>
              </div>

              <div class="min-w-0">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-400">
                  Date to Commence
                </p>
                <p class="mt-1 truncate text-sm font-black text-[#0A1629] dark:text-white">
                  <%= @project.start_date.present? ? @project.start_date.strftime("%d %b %Y") : "Not Set" %>
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:col-span-2">
          <%= link_to project_path(@project, filter: "Open"),
                      class: "group rounded-3xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900" do %>
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                  All Open Tickets
                </p>
                <p class="mt-2 text-3xl font-black text-[#0A1629] dark:text-white">
                  <%= @total_tickets_open %>
                </p>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#3F8CFF]/10 text-[#3F8CFF]">
                <span class="text-xl font-black">O</span>
              </div>
            </div>
            <p class="mt-4 text-xs font-bold text-[#3F8CFF]">
              View tickets →
            </p>
          <% end %>

          <%= link_to project_path(@project, filter: "Closed_for_all"),
                      class: "group rounded-3xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900" do %>
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                  All Closed Tickets
                </p>
                <p class="mt-2 text-3xl font-black text-[#0A1629] dark:text-white">
                  <%= @closed_tickets %>
                </p>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-green-100 text-green-600">
                <span class="text-xl font-black">✓</span>
              </div>
            </div>
            <p class="mt-4 text-xs font-bold text-[#3F8CFF]">
              View tickets →
            </p>
          <% end %>

          <%= link_to project_path(@project, filter: "Assigned_opened"),
                      class: "group rounded-3xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900" do %>
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                  My Open Tickets
                </p>
                <p class="mt-2 text-3xl font-black text-[#0A1629] dark:text-white">
                  <%= @assigned_and_tickets %>
                </p>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-600">
                <span class="text-xl font-black">!</span>
              </div>
            </div>
            <p class="mt-4 text-xs font-bold text-[#3F8CFF]">
              View tickets →
            </p>
          <% end %>

          <%= link_to project_path(@project, filter: "Assigned_closed"),
                      class: "group rounded-3xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-1 hover:border-[#3F8CFF]/40 hover:shadow-xl hover:shadow-blue-500/10 dark:border-slate-800 dark:bg-slate-900" do %>
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                  My Assigned & Closed
                </p>
                <p class="mt-2 text-3xl font-black text-[#0A1629] dark:text-white">
                  <%= @closed_assigned_tickets %>
                </p>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#0A1629]/10 text-[#0A1629] dark:bg-white/10 dark:text-white">
                <span class="text-xl font-black">C</span>
              </div>
            </div>
            <p class="mt-4 text-xs font-bold text-[#3F8CFF]">
              View tickets →
            </p>
          <% end %>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900/60 xl:col-span-2">
          <div class="mb-4 flex items-center justify-between gap-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-wide text-[#3F8CFF]">
                Products
              </p>
              <h3 class="text-lg font-black text-[#0A1629] dark:text-white">
                Active Sub Products
              </h3>
            </div>
          </div>

          <% active_groupwares = [] %>
          <% @project.softwares.each do |software| %>
            <% software.groupwares.each do |groupware| %>
              <% active_groupware = @project.tickets.where(groupware_id: groupware.id).count %>
              <% active_groupwares << groupware if active_groupware.positive? %>
            <% end %>
          <% end %>

          <% if active_groupwares.any? %>
            <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <% active_groupwares.uniq.each do |groupware| %>
                <li class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900">
                  <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center overflow-hidden rounded-xl bg-slate-100 dark:bg-slate-800">
                    <% if groupware.image.present? %>
                      <%= image_tag(groupware.image, class: "h-full w-full object-cover") %>
                    <% else %>
                      <%= image_tag "logo-mark.png", class: "h-8 w-8 object-contain" %>
                    <% end %>
                  </span>
                  <span class="truncate text-sm font-bold text-slate-700 dark:text-slate-200">
                    <%= groupware.name %>
                  </span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-5 text-center dark:border-slate-700 dark:bg-slate-900">
              <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                No active sub-products found.
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="border-b border-slate-200 bg-slate-50 px-4 py-4 dark:border-slate-800 dark:bg-slate-900/60 sm:px-6">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-sm font-bold uppercase tracking-wide text-[#3F8CFF]">
              Tickets
            </p>
            <h2 class="text-lg font-black text-[#0A1629] dark:text-white sm:text-xl">
              Support Desk Tickets
            </h2>
          </div>

          <div class="rounded-full bg-[#3F8CFF]/10 px-4 py-2 text-xs font-bold text-[#3F8CFF]">
            <%= @ticket_count %> Total
          </div>
        </div>
      </div>

      <div class="overflow-x-auto p-4 sm:p-6">
        <% if @project.assigned_to?(current_user) || current_user.has_role?(:admin) || current_user.has_role?(:agent) || current_user.has_role?(:observer) %>
          <%= render "tickets/ticket" %>
        <% else %>
          <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-8 text-center dark:border-slate-700 dark:bg-slate-900">
            <h3 class="text-lg font-black text-[#0A1629] dark:text-white">
              You do not have access to these tickets.
            </h3>
            <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
              Please contact an administrator if you believe this is incorrect.
            </p>
          </div>
        <% end %>
      </div>
    </section>

    <section class="mt-6 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-5">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-bold text-[#0A1629] dark:text-white">
            Pagination
          </p>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            Page <span class="font-bold text-[#3F8CFF]"><%= @page %></span>
            of
            <span class="font-bold text-[#3F8CFF]"><%= @total_pages.zero? ? 1 : @total_pages %></span>
          </p>
        </div>

        <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:items-center">
          <% if @page > 1 %>
            <%= link_to project_path(@project, params.permit!.merge(page: @page - 1)),
                        class: "inline-flex h-11 w-full items-center justify-center rounded-2xl border border-[#3F8CFF]/30 bg-white px-5 text-sm font-bold text-[#3F8CFF] shadow-sm transition hover:bg-[#3F8CFF] hover:text-white focus:outline-none focus:ring-4 focus:ring-[#3F8CFF]/20 sm:w-auto" do %>
              Previous
            <% end %>
          <% else %>
            <span class="inline-flex h-11 w-full cursor-not-allowed items-center justify-center rounded-2xl border border-slate-200 bg-slate-100 px-5 text-sm font-bold text-slate-400 dark:border-slate-800 dark:bg-slate-800 sm:w-auto">
              Previous
            </span>
          <% end %>

          <div class="hidden rounded-full bg-slate-100 px-4 py-2 text-sm font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300 sm:block">
            <%= @page %> / <%= @total_pages.zero? ? 1 : @total_pages %>
          </div>

          <% if @page < @total_pages %>
            <%= link_to project_path(@project, params.permit!.merge(page: @page + 1)),
                        class: "inline-flex h-11 w-full items-center justify-center rounded-2xl bg-[#3F8CFF] px-5 text-sm font-bold text-white shadow-lg shadow-blue-500/20 transition hover:bg-[#3A81EB] focus:outline-none focus:ring-4 focus:ring-[#3F8CFF]/25 sm:w-auto" do %>
              Next
            <% end %>
          <% else %>
            <span class="inline-flex h-11 w-full cursor-not-allowed items-center justify-center rounded-2xl border border-slate-200 bg-slate-100 px-5 text-sm font-bold text-slate-400 dark:border-slate-800 dark:bg-slate-800 sm:w-auto">
              Next
            </span>
          <% end %>
        </div>
      </div>
    </section>
  </div>
</div>