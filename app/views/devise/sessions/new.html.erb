<% provide(:title, "Sign In") %>

<div class="relative left-1/2 right-1/2 -mx-[50vw] w-screen min-h-screen grid grid-cols-1 lg:grid-cols-2 bg-white overflow-x-hidden">

  <%# ── Left panel: brand ────────────────────────────────────────────── %>
  <div class="relative hidden lg:flex flex-col items-center justify-center overflow-hidden px-14 py-12"
       style="background: radial-gradient(circle at 30% 20%, #eaf7f1 0%, #f5faf7 45%, #ffffff 100%);">

    <%# faint organic accent, kept quiet so the mark stays the focus %>
    <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-[#0D9C66]/[0.06]"></div>
    <div class="pointer-events-none absolute -bottom-32 -left-16 h-80 w-80 rounded-full bg-[#131D58]/[0.05]"></div>

    <div class="relative z-10 flex flex-col items-center text-center">
      <%= image_tag 'logo.png', class: 'w-64 xl:w-72 mb-8' %>

      <h2 class="max-w-sm text-xl font-medium leading-relaxed text-[#131D58]">
        Where your care team stays connected.
      </h2>

      <%# signature: a quiet pulse line, echoing the mark's cross %>
      <svg class="mt-10 w-56 pulse-line" viewBox="0 0 220 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 20 H70 L82 6 L94 34 L106 20 H220" stroke="#0D9C66" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>

  <%# ── Right panel: sign-in form ─────────────────────────────────────── %>
  <div class="flex items-center justify-center px-6 py-12 sm:px-12">
    <div class="w-full max-w-sm">

      <div class="mb-10 flex justify-center lg:hidden">
        <%= image_tag 'logo.png', class: 'w-40' %>
      </div>

      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#0D9C66] mb-2">Account access</p>
      <h1 class="text-2xl font-bold text-[#131D58] mb-8">Sign in to your account</h1>

      <%= render "devise/shared/error_messages", resource: resource %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), data: { turbo: false }) do |f| %>
        <div class="space-y-5">
          <div>
            <label for="email" class="block mb-2 text-sm font-medium text-gray-700">Email</label>
            <%= f.email_field :email,
                              autofocus: true,
                              autocomplete: "email",
                              required: true,
                              class: "h-12 w-full rounded-xl border border-gray-200 px-4 text-gray-900 placeholder-gray-400 transition focus:border-[#0D9C66] focus:outline-none focus:ring-2 focus:ring-[#0D9C66]/20" %>
          </div>

          <div>
            <label for="password" class="block mb-2 text-sm font-medium text-gray-700">Password</label>
            <div class="relative">
              <%= f.password_field :password,
                                   autocomplete: "current-password",
                                   placeholder: "••••••••",
                                   required: true,
                                   id: "session_password",
                                   class: "h-12 w-full rounded-xl border border-gray-200 pl-4 pr-12 text-gray-900 placeholder-gray-400 transition focus:border-[#0D9C66] focus:outline-none focus:ring-2 focus:ring-[#0D9C66]/20" %>
              <button type="button"
                      id="toggle-password"
                      aria-label="Show password"
                      aria-pressed="false"
                      class="absolute inset-y-0 right-0 flex items-center px-4 text-gray-400 hover:text-[#0D9C66] focus:outline-none focus:text-[#0D9C66]">
                <svg id="icon-eye" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1.5 12s4-7.5 10.5-7.5S22.5 12 22.5 12s-4 7.5-10.5 7.5S1.5 12 1.5 12Z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
                <svg id="icon-eye-off" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 3l18 18"/>
                  <path d="M10.6 5.1A10.9 10.9 0 0 1 12 5c6.5 0 10.5 7 10.5 7a13.8 13.8 0 0 1-3.1 3.9M6.3 6.4C3.4 8.1 1.5 12 1.5 12s4 7 10.5 7c1.6 0 3-.3 4.2-.9"/>
                  <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/>
                </svg>
              </button>
            </div>
          </div>

          <div class="flex items-center justify-between pt-1">
            <div class="flex items-center">
              <% if devise_mapping.rememberable? %>
                <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-gray-300 accent-[#0D9C66] focus:ring-2 focus:ring-[#0D9C66]/30" %>
                <%= f.label :remember_me, class: "ml-2 text-sm text-gray-600" %>
              <% end %>
            </div>
            <div class="text-sm font-medium text-[#0D9C66] hover:text-[#0b8557] hover:underline">
              <%= render "devise/shared/forgot_password" %>
            </div>
          </div>

          <%= f.submit "Log in",
                       class: "h-12 w-full rounded-xl bg-[#131D58] font-semibold text-white shadow-sm shadow-[#131D58]/20 transition-colors duration-150 hover:bg-[#0f1745] active:bg-[#0c1338]" %>
        </div>
      <% end %>

      <p class="mt-8 text-sm text-gray-500">
        <%= render "devise/shared/links" %>
      </p>
    </div>
  </div>
</div>

<style>
    .pulse-line path {
        stroke-dasharray: 220;
        stroke-dashoffset: 220;
        animation: pulse-draw 3.2s ease-in-out infinite;
    }
    @keyframes pulse-draw {
        0%   { stroke-dashoffset: 220; opacity: 0.3; }
        45%  { stroke-dashoffset: 0; opacity: 1; }
        70%  { stroke-dashoffset: 0; opacity: 1; }
        100% { stroke-dashoffset: -220; opacity: 0.3; }
    }
    @media (prefers-reduced-motion: reduce) {
        .pulse-line path { animation: none; stroke-dashoffset: 0; }
    }
</style>

<script>
  (function () {
    const input = document.getElementById("session_password");
    const toggle = document.getElementById("toggle-password");
    const eye = document.getElementById("icon-eye");
    const eyeOff = document.getElementById("icon-eye-off");
    if (!input || !toggle) return;

    toggle.addEventListener("click", function () {
      const showing = input.type === "text";
      input.type = showing ? "password" : "text";
      eye.classList.toggle("hidden", !showing);
      eyeOff.classList.toggle("hidden", showing);
      toggle.setAttribute("aria-label", showing ? "Show password" : "Hide password");
      toggle.setAttribute("aria-pressed", String(!showing));
    });
  })();
</script>
