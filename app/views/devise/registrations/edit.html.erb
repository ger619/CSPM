<div class="min-h-screen bg-slate-50 px-4 py-10 dark:bg-slate-950 sm:px-6">
  <div class="mx-auto max-w-2xl">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }, data: {turbo: true}) do |f| %>
      <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-6">
        <p class="text-xs font-bold uppercase tracking-wide text-[#131D58] dark:text-[#8FA3E6]">Account</p>
        <h2 class="mt-1 text-lg font-black text-[#0A1024] dark:text-white">Update profile</h2>

        <div class="mt-4">
          <%= render "devise/shared/error_messages", resource: resource %>
        </div>

        <div class="mt-5 space-y-5">
          <div>
            <label for="first_name" class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">
              First name
            </label>
            <% if current_user.has_role?(:admin) %>
              <%= f.text_field :first_name, autofocus: true, autocomplete: 'name',
                               class: "block h-12 w-full rounded-lg border-2 border-[#131D58]/30 px-3 text-sm font-medium shadow-sm transition hover:border-[#131D58] focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:bg-slate-800 dark:text-white",
                               placeholder: 'Jay', required: true %>
            <% else %>
              <%= f.text_field :first_name, autofocus: true, autocomplete: 'name',
                               class: "block h-12 w-full rounded-lg border-2 border-slate-200 px-3 text-sm font-medium shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white",
                               placeholder: 'Jay', readonly: true %>
            <% end %>
          </div>

          <div>
            <label for="last_name" class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">
              Last name
            </label>
            <% if current_user.has_role?(:admin) %>
              <%= f.text_field :last_name, autofocus: true, autocomplete: 'name',
                               class: "block h-12 w-full rounded-lg border-2 border-[#131D58]/30 px-3 text-sm font-medium shadow-sm transition hover:border-[#131D58] focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:bg-slate-800 dark:text-white",
                               placeholder: 'Strong', required: true %>
            <% else %>
              <%= f.text_field :last_name, autofocus: true, autocomplete: 'name',
                               class: "block h-12 w-full rounded-lg border-2 border-slate-200 px-3 text-sm font-medium shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white",
                               placeholder: 'Strong', readonly: true %>
            <% end %>
          </div>

          <div>
            <label for="email" class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">
              Your email
            </label>
            <% if current_user.has_role?(:admin) %>
              <%= f.email_field :email, autofocus: true, autocomplete: 'email',
                                class: "block h-12 w-full rounded-lg border-2 border-[#131D58]/30 px-3 text-sm font-medium shadow-sm transition hover:border-[#131D58] focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:bg-slate-800 dark:text-white",
                                placeholder: 'name@craftsilicon.com', required: true %>
            <% else %>
              <%= f.email_field :email, autofocus: true, autocomplete: 'email',
                                class: "block h-12 w-full rounded-lg border-2 border-slate-200 px-3 text-sm font-medium shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white",
                                placeholder: 'name@craftsilicon.com', readonly: true %>
            <% end %>
          </div>

          <div>
            <label for="profile_picture" class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">
              Profile picture
            </label>
            <%= f.file_field :profile_picture, class: "block w-full rounded-lg border-2 border-[#131D58]/30 p-2 text-sm shadow-sm transition hover:border-[#131D58] dark:bg-slate-800 dark:text-slate-200" %>
          </div>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <div class="rounded-lg bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-800 dark:bg-amber-500/10 dark:text-amber-300">
              Currently waiting confirmation for: <%= resource.unconfirmed_email %>
            </div>
          <% end %>
        </div>

        <div class="mt-6 grid grid-cols-1 gap-4 border-t border-slate-100 pt-5 dark:border-slate-800 sm:grid-cols-3">
          <div>
            <%= f.label :password, class: "mb-1 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
            <p class="mb-1.5 text-xs font-medium text-slate-400">(leave blank if you don't want to change it)</p>
            <%= f.password_field :password, autocomplete: "new-password", class: "block h-11 w-full rounded-lg border-2 border-[#131D58]/30 px-3 text-sm font-medium shadow-sm transition hover:border-[#131D58] focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:bg-slate-800 dark:text-white" %>
            <% if @minimum_password_length %>
              <p class="mt-1.5 text-xs font-medium italic text-slate-400"><%= @minimum_password_length %> characters minimum</p>
            <% end %>
          </div>

          <div>
            <%= f.label :password_confirmation, class: "mb-1 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
            <p class="mb-1.5 text-xs font-medium text-slate-400">(confirm your password)</p>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "block h-11 w-full rounded-lg border-2 border-[#131D58]/30 px-3 text-sm font-medium shadow-sm transition hover:border-[#131D58] focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:bg-slate-800 dark:text-white" %>
          </div>

          <div>
            <%= f.label :current_password, class: "mb-1 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
            <p class="mb-1.5 text-xs font-medium text-slate-400">(we need your current password to confirm your changes)</p>
            <%= f.password_field :current_password, autocomplete: "current-password", class: "block h-11 w-full rounded-lg border-2 border-[#131D58]/30 px-3 text-sm font-medium shadow-sm transition hover:border-[#131D58] focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:bg-slate-800 dark:text-white" %>
          </div>
        </div>

        <div class="mt-6">
          <%= f.submit "Update", class: "w-full rounded-lg bg-[#0D9C66] px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-[#0B8558] hover:shadow active:scale-[0.98] sm:w-auto" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
