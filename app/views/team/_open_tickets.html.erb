<div class="bg-white border border-gray-100 rounded-xl shadow-sm overflow-hidden">
  <div class="flex items-center gap-2 px-4 sm:px-6 py-4 border-b border-gray-100">
    <span class="w-2 h-2 rounded-full bg-[#0D9C67]"></span>
    <h2 class="text-base font-semibold text-[#131D58]">Open Tickets</h2>
    <span class="text-xs font-semibold bg-[#E3F6EC] text-[#0B4A32] rounded-full px-2 py-0.5"><%= @open_tickets.size %></span>
  </div>

  <% if @open_tickets.blank? %>
    <div class="px-6 py-10 text-center">
      <p class="text-sm text-gray-500">No open tickets right now.</p>
    </div>
  <% else %>
    <!-- Desktop / tablet table -->
    <div class="hidden md:block overflow-x-auto">
      <table class="w-full text-sm text-left text-gray-600">
        <thead class="text-xs uppercase bg-[#F4F5FA] text-[#131D58] font-semibold">
        <tr>
          <th scope="col" class="px-4 py-3 whitespace-nowrap">Client Name</th>
          <th scope="col" class="px-4 py-3 whitespace-nowrap">Ticket ID</th>
          <th scope="col" class="px-4 py-3 whitespace-nowrap">Issue</th>
          <th scope="col" class="px-4 py-3 whitespace-nowrap">Priority</th>
          <th scope="col" class="px-4 py-3 whitespace-nowrap">Summary</th>
          <th scope="col" class="px-4 py-3 whitespace-nowrap">Status</th>
          <th scope="col" class="px-4 py-3 whitespace-nowrap text-right">View</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
        <% @open_tickets.each do |ticket| %>
          <% next unless ticket.present? %>
          <tr class="bg-white hover:bg-[#F4F5FA] transition-colors">
            <td class="px-4 py-3 font-medium capitalize whitespace-nowrap">
              <%= link_to ticket.project.title, project_ticket_path(ticket.project, ticket), class: "text-[#131D58] hover:text-[#0D9C67] font-semibold" %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap uppercase text-gray-500">
              <% if ticket.unique_id.present? %>
                <%= link_to ticket.unique_id, project_ticket_path(ticket.project, ticket), class: "hover:text-[#0D9C67]" %>
              <% end %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap">
              <%= link_to ticket.issue, project_ticket_path(ticket.project, ticket), class: "hover:text-[#0D9C67]" %>
            </td>
            <td class="px-4 py-3">
              <%= render partial: 'team/ticket_priority_badge', locals: { ticket: ticket } %>
            </td>
            <td class="px-4 py-3 truncate max-w-xs">
              <%= ticket.subject.present? ? ticket.subject.truncate(50) : "" %>
            </td>
            <td class="px-4 py-3">
              <%= render partial: 'team/ticket_status_badge', locals: { ticket: ticket } %>
            </td>
            <td class="px-4 py-3 text-right">
              <%= link_to 'View', project_ticket_path(ticket.project, ticket), class: 'inline-flex items-center gap-1.5 bg-[#131D58] hover:bg-[#0E1642] px-3 py-1.5 rounded-lg font-semibold text-xs text-white transition-colors' %>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>

    <!-- Mobile cards -->
    <div class="md:hidden divide-y divide-gray-100">
      <% @open_tickets.each do |ticket| %>
        <% next unless ticket.present? %>
        <div class="p-4">
          <div class="flex items-start justify-between gap-2 mb-2">
            <div class="min-w-0">
              <p class="text-sm font-semibold text-[#131D58] capitalize truncate"><%= ticket.project.title %></p>
              <% if ticket.unique_id.present? %>
                <p class="text-xs text-gray-400 uppercase"><%= ticket.unique_id %></p>
              <% end %>
            </div>
            <%= link_to 'View', project_ticket_path(ticket.project, ticket), class: 'flex-shrink-0 inline-flex items-center gap-1.5 bg-[#131D58] hover:bg-[#0E1642] px-3 py-1.5 rounded-lg font-semibold text-xs text-white transition-colors' %>
          </div>
          <p class="text-sm text-gray-700 mb-2"><%= ticket.issue %></p>
          <% if ticket.subject.present? %>
            <p class="text-xs text-gray-500 mb-3"><%= ticket.subject.truncate(60) %></p>
          <% end %>
          <div class="flex flex-wrap items-center gap-2">
            <%= render partial: 'team/ticket_priority_badge', locals: { ticket: ticket } %>
            <%= render partial: 'team/ticket_status_badge', locals: { ticket: ticket } %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
