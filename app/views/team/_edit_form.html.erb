<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 sm:p-6">
  <h1 class="text-xl sm:text-2xl font-bold text-[#131D58] mb-6">Edit Team: <%= @team.name %></h1>

  <%= form_with model: @team, url: team_path(@team), method: :patch, data: { turbo: false }, local: true do |f| %>
    <div class="space-y-5">
      <div class="bg-[#F4F5FA] p-4 rounded-xl">
        <%= f.label :name, 'Team Name*', class: "block mb-2 text-sm font-medium text-[#131D58]" %>
        <%= f.text_field :name, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", placeholder: 'Enter team name', required: true %>
      </div>

      <div class="bg-[#F4F5FA] p-4 rounded-xl">
        <%= f.label :description, 'Description', class: "block mb-2 text-sm font-medium text-[#131D58]" %>
        <%= f.text_area :description, rows: 3, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", placeholder: 'Enter team description' %>
      </div>

      <div class="bg-[#F4F5FA] p-4 rounded-xl">
        <%= f.label :user_ids, 'Pick Agents and Project Managers', class: "block mb-2 text-sm font-medium text-[#131D58]" %>

        <div class="relative w-full">
          <div class="relative">
            <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
              <svg class="w-4 h-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
              </svg>
            </div>
            <input type="text" id="searchUser"
                   class="border border-gray-300 rounded-lg font-medium placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] w-full pl-9 pr-4 py-2.5 text-sm bg-white"
                   placeholder="Search user..." onclick="showDropdown()" onkeyup="filterUserDropdown()" autocomplete="off">
          </div>

          <!-- Selected Items Container -->
          <div id="selectedUsers" class="flex flex-wrap gap-2 mt-3">
            <% @team.users.each do |user| %>
              <div class="inline-flex items-center gap-2 bg-[#E8EAF3] text-[#131D58] text-sm font-medium px-3 py-1.5 rounded-full">
                <%= user.name %> <span onclick="removeUser('<%= user.id %>', this)" class="cursor-pointer text-[#131D58]/50 hover:text-red-600 font-bold">&times;</span>
              </div>
              <input type="hidden" name="team[user_ids][]" value="<%= user.id %>" class="user-input-<%= user.id %>">
            <% end %>
          </div>

          <!-- Hidden Inputs for Rails Form -->
          <div id="hiddenUserInputs"></div>

          <!-- Dropdown List -->
          <div id="userDropdown" class="absolute w-full bg-white border border-gray-200 rounded-lg mt-1 shadow-lg max-h-48 overflow-y-auto hidden z-10">
            <div class="flex justify-end p-2 border-b border-gray-100">
              <button type="button" onclick="hideDropdown()" class="text-gray-400 hover:text-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                  <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm-1.72 6.97a.75.75 0 1 0-1.06 1.06L10.94 12l-1.72 1.72a.75.75 0 1 0 1.06 1.06L12 13.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L13.06 12l1.72-1.72a.75.75 0 1 0-1.06-1.06L12 10.94l-1.72-1.72Z" clip-rule="evenodd" />
                </svg>
              </button>
            </div>
            <% users = User.with_assigned_role.distinct - @team.users %>
            <% users.each do |user| %>
              <div class="dropdown-item px-4 py-2 text-sm text-gray-700 hover:bg-[#F4F5FA] hover:text-[#131D58] cursor-pointer" data-user-id="<%= user.id %>" onclick="selectUser(this)">
                <%= user.name %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="flex justify-end pt-2">
        <%= f.submit 'Update Team', class: "bg-[#0D9C67] hover:bg-[#0B8659] text-white px-5 py-2.5 rounded-lg font-semibold text-sm transition-colors cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>

<script>
  let selectedUsers = <%= @team.users.map { |user| { id: user.id, name: user.name } }.to_json.html_safe %>;

  function showDropdown() {
    document.getElementById("userDropdown").classList.remove("hidden");
  }

  function hideDropdown() {
    document.getElementById("userDropdown").classList.add("hidden");
  }

  function filterUserDropdown() {
    let input = document.getElementById("searchUser").value.toLowerCase();
    let items = document.querySelectorAll("#userDropdown .dropdown-item");

    items.forEach(item => {
      let text = item.textContent.toLowerCase();
      item.style.display = text.includes(input) ? "block" : "none";
    });
  }

  function selectUser(element) {
    let userId = element.getAttribute("data-user-id");
    let userName = element.textContent;

    if (!selectedUsers.some(user => user.id === userId)) {
      selectedUsers.push({ id: userId, name: userName });

      let tag = document.createElement("div");
      tag.className = "inline-flex items-center gap-2 bg-[#E8EAF3] text-[#131D58] text-sm font-medium px-3 py-1.5 rounded-full";
      tag.innerHTML = `${userName} <span onclick="removeUser('${userId}', this)" class="cursor-pointer text-[#131D58]/50 hover:text-red-600 font-bold">&times;</span>`;
      document.getElementById("selectedUsers").appendChild(tag);

      let input = document.createElement("input");
      input.type = "hidden";
      input.name = "team[user_ids][]";
      input.value = userId;
      input.classList.add(`user-input-${userId}`);
      document.getElementById("hiddenUserInputs").appendChild(input);

      element.remove();
    }

    hideDropdown();
  }

  function removeUser(userId, element) {
    selectedUsers = selectedUsers.filter(user => user.id !== userId);
    element.parentElement.remove();

    let input = document.querySelector(`.user-input-${userId}`);
    if (input) {
      input.remove();
    }

    let userDropdown = document.getElementById("userDropdown");
    let userName = element.parentElement.textContent.trim().slice(0, -1);
    let dropdownItem = document.createElement("div");
    dropdownItem.className = "dropdown-item px-4 py-2 text-sm text-gray-700 hover:bg-[#F4F5FA] hover:text-[#131D58] cursor-pointer";
    dropdownItem.setAttribute("data-user-id", userId);
    dropdownItem.setAttribute("onclick", "selectUser(this)");
    dropdownItem.textContent = userName;
    userDropdown.appendChild(dropdownItem);
  }
</script>
