<% teams = @team.select { |t| current_user.has_role?(:admin) || current_user.has_role?(:observer) || current_user.has_role?('project manager') } %>

<% if teams.empty? %>
  <div class="flex flex-col items-center justify-center text-center py-16 px-4 bg-white border border-gray-100 rounded-xl shadow-sm">
    <div class="w-14 h-14 rounded-full bg-[#E8EAF3] flex items-center justify-center mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#131D58]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
      </svg>
    </div>
    <p class="text-sm font-semibold text-[#131D58] mb-1">No teams yet</p>
    <p class="text-sm text-gray-500">Create a team to group agents and project managers for faster project staffing.</p>
  </div>
<% else %>

  <!-- Desktop / tablet table -->
  <div class="hidden sm:block overflow-x-auto rounded-xl border border-gray-100 shadow-sm bg-white">
    <table class="w-full text-sm text-left text-gray-600">
      <thead class="text-xs uppercase bg-[#F4F5FA] text-[#131D58] font-semibold">
      <tr>
        <th scope="col" class="px-6 py-3 whitespace-nowrap">Name of Team</th>
        <th scope="col" class="px-6 py-3 whitespace-nowrap">Description</th>
        <th scope="col" class="px-6 py-3 whitespace-nowrap">Members</th>
        <th scope="col" class="px-6 py-3 whitespace-nowrap text-right">Actions</th>
      </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
      <% teams.each do |team| %>
        <tr class="bg-white hover:bg-[#F4F5FA] transition-colors">
          <td class="px-6 py-4 font-semibold whitespace-nowrap">
            <%= link_to team.name, team_path(team.id), class: "text-[#131D58] hover:text-[#0D9C67] font-semibold" %>
          </td>
          <td class="px-6 py-4 text-gray-600">
            <%= team.description.present? ? team.description.truncate(45) : "\u2014" %>
          </td>
          <td class="px-6 py-4">
            <span class="inline-flex items-center gap-1.5 bg-[#E8EAF3] text-[#131D58] text-xs font-semibold px-2.5 py-1 rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.001-.001a5.988 5.988 0 0 1-.94-3.197m5.058-9.021A5.25 5.25 0 1 0 12 15.75 5.25 5.25 0 0 0 15.058 5.25Z" />
              </svg>
              <%= team.users.count %>
            </span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-right" data-controller="dropdown" data-dropdown-ticket-id-value="<%= team.id %>">
            <div class="relative flex justify-end">
              <%= render partial: 'team/action_dropdown', locals: { team: team } %>
            </div>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>

  <!-- Mobile cards -->
  <div class="sm:hidden grid grid-cols-1 gap-3">
    <% teams.each do |team| %>
      <div class="bg-white border border-gray-100 rounded-xl shadow-sm p-4">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <%= link_to team.name, team_path(team.id), class: "text-[#131D58] font-semibold text-base truncate block" %>
            <p class="text-sm text-gray-500 mt-0.5">
              <%= team.description.present? ? team.description.truncate(60) : "No description" %>
            </p>
          </div>
          <div data-controller="dropdown" data-dropdown-ticket-id-value="<%= team.id %>" class="flex-shrink-0">
            <%= render partial: 'team/action_dropdown', locals: { team: team } %>
          </div>
        </div>
        <div class="mt-3">
          <span class="inline-flex items-center gap-1.5 bg-[#E8EAF3] text-[#131D58] text-xs font-semibold px-2.5 py-1 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.001-.001a5.988 5.988 0 0 1-.94-3.197m5.058-9.021A5.25 5.25 0 1 0 12 15.75 5.25 5.25 0 0 0 15.058 5.25Z" />
            </svg>
            <%= team.users.count %> member<%= 's' unless team.users.count == 1 %>
          </span>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
