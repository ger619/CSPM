<% if ticket.priority == 'SEVERITY 1' %>
  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md font-semibold text-xs bg-red-50 text-red-700 ring-1 ring-red-200 whitespace-nowrap">
    <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
    SEVERITY 1
  </span>
<% elsif ticket.priority == 'SEVERITY 2' %>
  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md font-semibold text-xs bg-orange-50 text-orange-700 ring-1 ring-orange-200 whitespace-nowrap">
    <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
    SEVERITY 2
  </span>
<% elsif ticket.priority == 'SEVERITY 3' %>
  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md font-semibold text-xs bg-yellow-50 text-yellow-700 ring-1 ring-yellow-200 whitespace-nowrap">
    <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>
    SEVERITY 3
  </span>
<% else %>
  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md font-semibold text-xs bg-[#E8EAF3] text-[#131D58] ring-1 ring-[#131D58]/10 whitespace-nowrap">
    <span class="w-1.5 h-1.5 rounded-full bg-[#131D58]"></span>
    <%= ticket.priority %>
  </span>
<% end %>
