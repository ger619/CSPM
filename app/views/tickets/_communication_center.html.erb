<div class="flex w-full flex-col gap-4">
  <div class="flex items-center gap-2.5">
    <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-xl bg-[#131D58]/10 text-[#131D58] dark:bg-[#131D58]/30 dark:text-[#8FA3E6]">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 0 1-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8Z" />
      </svg>
    </div>
    <h2 class="text-lg font-black text-[#0A1024] dark:text-white">Communication center</h2>
  </div>

  <!-- Tabs Section -->
  <div id="history" class="tabcontent active">
    <%= render partial: 'issues/issues_table' %>
  </div>

  <% if current_page?(project_ticket_path(@project, @ticket)) %>
    <!-- New message button -->
    <% unless @ticket.statuses.first&.name == 'Closed' %>
      <div data-controller="messages">
        <div class="border-t border-slate-100 pt-4 dark:border-slate-800">
          <button id="newMessageButton"
                  class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#0D9C66] px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#0B8558] hover:shadow active:scale-[0.98] sm:w-auto"
                  data-action="click->messages#toggleForm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
            </svg>
            New message
          </button>
        </div>

        <!-- Form Container (initially hidden) -->
        <div id="messageFormContainer" class="hidden mt-4" data-messages-target="form">
          <%= render 'issues/form', project: @project, ticket: @ticket, issue: Issue.new %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
