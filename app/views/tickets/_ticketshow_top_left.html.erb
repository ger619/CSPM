<div class="mb-6 flex flex-col gap-6 md:flex-row">
  <!-- Left side - Image -->
  <div class="w-full md:w-1/3">
    <% if @ticket.ticket_image.present? %>
      <%= image_tag @ticket.ticket_image, class: 'h-48 w-full cursor-pointer rounded-2xl border border-slate-200 object-contain dark:border-slate-700', data: { action: 'click->image-modal#openModal' } %>
    <% elsif @project.image.present? %>
      <%= image_tag @project.image, class: 'h-48 w-full rounded-2xl border border-slate-200 object-contain dark:border-slate-700' %>
    <% else %>
      <div class="flex h-48 w-full items-center justify-center rounded-2xl border border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-800">
        <span class="text-sm font-semibold text-slate-400">No image</span>
      </div>
    <% end %>
  </div>

  <!-- Right side - Details -->
  <div class="w-full space-y-4 md:w-2/3">
    <div class="grid grid-cols-2 gap-4">
      <div>
        <p class="mb-1 text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Priority</p>
        <%= render partial: 'tickets/priority_severity', locals: { ticket: @ticket } %>
      </div>

      <div data-controller="status-modal">
        <p class="mb-1 text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Status</p>

        <div class="group relative flex items-center gap-1.5">
          <%= render partial: 'ticket_status', locals: { ticket: @ticket } %>

          <% unless (@ticket.statuses.first&.name == 'Closed') && !current_user.has_role?(:admin) %>
            <button type="button"
                    class="flex h-7 w-7 items-center justify-center rounded-lg text-slate-400 transition hover:bg-[#131D58]/10 hover:text-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/30 dark:hover:bg-[#131D58]/20"
                    data-action="click->status-modal#toggleDropdown"
                    aria-label="Change status">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
              </svg>
            </button>
          <% end %>

          <!-- Status Change Modal -->
          <div class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm"
               data-status-modal-target="dropdown">
            <div class="w-[90%] max-w-sm overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl dark:border-slate-700 dark:bg-slate-800">
              <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4 dark:border-slate-700">
                <h3 class="text-base font-black text-[#0A1024] dark:text-white">Update ticket status</h3>
                <button type="button"
                        class="rounded-lg p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-700"
                        data-action="click->status-modal#closeDropdown"
                        aria-label="Close">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div class="p-5">
                <%= render 'tickets/ticket_action', project: @project, ticket: @ticket %>
              </div>

              <div class="flex justify-end border-t border-slate-100 px-5 py-3 dark:border-slate-700">
                <button type="button"
                        class="rounded-lg px-4 py-2 text-sm font-bold text-red-600 transition hover:bg-red-50 dark:hover:bg-red-500/10"
                        data-action="click->status-modal#closeDropdown">
                  Cancel
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div>
        <p class="mb-1 text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Product</p>
        <p class="text-sm font-bold text-[#0A1024] dark:text-white">
          <% if @ticket.software.present? %>
            <%= @ticket.software&.name || 'No software assigned' %>
          <% else %>
            —
          <% end %>
        </p>
      </div>

      <div>
        <p class="mb-1 text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Sub-Product</p>
        <p class="text-sm font-bold text-[#0A1024] dark:text-white">
          <% if @ticket.software.present? %>
            <% selected_groupware = @ticket.software.groupwares.find_by(id: @ticket.groupware_id) %>
            <%= selected_groupware ? selected_groupware.name : 'No groupware assigned' %>
          <% else %>
            —
          <% end %>
        </p>
      </div>

      <div>
        <p class="mb-1 text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Time Created</p>
        <p class="text-sm font-bold text-[#0A1024] dark:text-white"><%= @ticket.created_at.strftime("%d %b %Y at %I:%M %p") %></p>
      </div>
    </div>
  </div>
</div>
