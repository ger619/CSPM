<%= render 'tickets/new_back' %>

<%= form_with(model: [@project, @ticket], method: :put,
              data: {
                controller: 'edit-ticket-form',
                'edit-ticket-form-project-id-value': @project.id,
                'edit-ticket-form-selected-groupware-id-value': @ticket.groupware_id
              }) do |f| %>
  <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-6">
    <h1 class="mb-5 text-lg font-black text-[#0A1024] dark:text-white">Edit ticket</h1>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :issue, 'Issue *', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
        <% if @project.special %>
          <%= f.select :issue, options_for_select(['SUPPORT', 'NEW FEATURE', 'BUG', 'REQUEST', 'INCIDENT', 'CHANGE REQUEST']), {},
                       class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white",
                       required: true %>
        <% else %>
          <%= f.select :issue, options_for_select(['SUPPORT', 'NEW FEATURE', 'BUG', 'REQUEST', 'INCIDENT']), {},
                       class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white",
                       placeholder: 'Select the issue' %>
        <% end %>
      </div>

      <div>
        <%= f.label :priority, 'Priority *', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
        <%= f.select :priority, ['SEVERITY 1', 'SEVERITY 2', 'SEVERITY 3', 'SEVERITY 4'], {},
                     class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white",
                     placeholder: 'Select the severity' %>
      </div>

      <!-- Software Field -->
      <div>
        <%= f.label :software_id, 'Product category *', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
        <%= f.collection_select :software_id, @project.softwares, :id, :name,
                                { prompt: "Select product" },
                                { class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white",
                                  id: "software-select",
                                  data: {
                                    'edit-ticket-form-target': "software",
                                    action: "change->edit-ticket-form#updateGroupwareOptions"
                                  } }
        %>
      </div>

      <!-- Groupware Field -->
      <div id="groupware-field"
           data-edit-ticket-form-target="groupwareField"
           style="display: none;">
        <%= f.label :groupware_id, 'Sub category *', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
        <%= f.collection_select :groupware_id,
                                [],
                                :id,
                                :name,
                                { prompt: "Select the product" },
                                { class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white",
                                  id: "groupware-select",
                                  data: { 'edit-ticket-form-target': "groupware" },
                                  required: true }
        %>
      </div>

      <div>
        <%= f.label :image, 'Current image', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
        <% if f.object.ticket_image.present? %>
          <%= image_tag f.object.ticket_image, class: "h-20 w-20 rounded-xl object-cover" %>
        <% else %>
          <p class="text-sm font-semibold text-slate-400">No image uploaded.</p>
        <% end %>
      </div>

      <div>
        <%= f.label :image, 'Upload image', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
        <%= f.file_field :ticket_image, accept: "image/jpeg,image/png", class: "block w-full text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-[#131D58]/10 file:px-3 file:py-2 file:text-xs file:font-bold file:text-[#131D58] hover:file:bg-[#131D58]/20 dark:text-slate-300" %>
      </div>

      <div>
        <%= f.label :attachments, 'Current attachments', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
        <% if f.object.attachments.attached? %>
          <div class="space-y-1.5">
            <% f.object.attachments.each do |attachment| %>
              <div class="flex items-center gap-3 rounded-lg border border-slate-100 bg-slate-50 px-3 py-2 dark:border-slate-800 dark:bg-slate-900/60">
                <%= link_to attachment.filename.to_s, rails_blob_path(attachment, disposition: "inline"), target: "_blank", class: "truncate text-sm font-bold text-[#131D58] hover:underline dark:text-[#8FA3E6]" %>
                <%= link_to "Download", rails_blob_path(attachment, disposition: "attachment"), class: "flex-shrink-0 text-xs font-bold text-[#0D9C66] hover:underline" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm font-semibold text-slate-400">No files uploaded.</p>
        <% end %>
      </div>

      <div>
        <%= f.label :attachments, 'Upload attachments', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
        <%= f.file_field :attachments, multiple: true, class: "block w-full text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-[#131D58]/10 file:px-3 file:py-2 file:text-xs file:font-bold file:text-[#131D58] hover:file:bg-[#131D58]/20 dark:text-slate-300" %>
      </div>
    </div>

    <div class="mt-4">
      <%= f.label :subject, 'Subject *', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
      <%= f.text_field :subject, class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white", required: true %>
      <% if @ticket.errors[:subject].any? %>
        <div class="mt-1.5 text-xs font-semibold text-red-600"><%= @ticket.errors[:subject].join(", ") %></div>
      <% end %>
    </div>

    <div class="mt-4">
      <%= f.label :title, 'Description *', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
      <div data-controller="text-limit" data-text-limit-limit-value="3000">
        <p id="char-count" class="mb-1.5 text-xs font-semibold text-slate-400">0/3000</p>
        <%= f.rich_text_area :content, id: "content", data: { text_limit_target: "content", is_admin: current_user.has_role?(:admin) || current_user.has_role?('project manager') || current_user.has_role?('agent') }, class: "min-h-[300px] rounded-lg border border-slate-200 dark:border-slate-700 #{'border-red-500' if @ticket.errors[:content].any?}" %>
      </div>
    </div>

    <%= f.submit "Submit", class: 'mt-5 w-full rounded-lg bg-[#0D9C66] px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-[#0B8558] hover:shadow active:scale-[0.98] sm:w-auto' %>
  </div>
<% end %>
