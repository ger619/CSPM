<% if current_user.has_role?(:admin) || current_user.has_role?('project manager') || current_user.has_role?(:agent) %>
  <section class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900" data-controller="status-modal">
    <div class="mb-3 flex items-center justify-between">
      <p class="text-xs font-bold uppercase tracking-wide text-slate-400">Assigned users</p>
      <% unless (@ticket.statuses.first&.name == 'Closed' or @ticket.statuses.first&.name == 'Resolved') && !current_user.has_role?(:admin) %>
        <button
          data-action="click->status-modal#openModal"
          class="rounded-lg bg-[#3F8CFF] px-3 py-1.5 text-xs font-bold text-white shadow-sm transition hover:bg-[#3A81EB] hover:shadow active:scale-[0.98]"
          aria-label="Assign users"
        >
          Select
        </button>
      <% end %>
    </div>

    <div class="flex flex-wrap items-center gap-1.5">
      <% if @ticket.users.any? %>
        <% @ticket.users.each do |user| %>
          <span class="rounded-full bg-[#3F8CFF]/10 px-3 py-1 text-xs font-bold text-[#3F8CFF]">
            <%= user.name %>
          </span>
        <% end %>
      <% else %>
        <p class="text-sm font-semibold text-red-500">
          No agents assigned. Please assign at least one agent to this ticket.
        </p>
      <% end %>
    </div>

    <!-- Assign Users Modal -->
    <div class="hidden fixed inset-0 z-50 h-full w-full overflow-y-auto bg-slate-900/50 backdrop-blur-sm"
         data-status-modal-target="modal">
      <div class="relative top-20 mx-auto w-[90%] max-w-sm rounded-2xl border border-slate-200 bg-white p-5 shadow-xl dark:border-slate-700 dark:bg-slate-800">
        <div class="mb-4 flex items-center justify-between">
          <h3 class="text-base font-black text-[#0A1629] dark:text-white">Assign users</h3>
          <button
            data-action="click->status-modal#closeModal"
            class="rounded-lg p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-700"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            <span class="sr-only">Close</span>
          </button>
        </div>

        <%= form_with url: assign_tag_project_ticket_path(@project, @ticket, data: { turbo: false }), local: true do %>
          <div class="mb-4">
            <%= label_tag :user_id, "Select user", class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
            <% available_users = User.with_assigned_role.where.not(id: @ticket.users.pluck(:id)).where(id: @project.users.pluck(:id)).order(:first_name).distinct %>
            <% if available_users.any? %>
              <%= select_tag :user_id, options_from_collection_for_select(available_users, :id, :name || :email),
                             class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#3F8CFF] focus:outline-none focus:ring-2 focus:ring-[#3F8CFF]/20 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-200" %>
            <% else %>
              <p class="text-sm font-semibold text-slate-400">No available users to assign.</p>
            <% end %>
          </div>

          <div class="flex justify-end gap-2">
            <button
              type="button"
              data-action="click->status-modal#closeModal"
              class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-bold text-slate-600 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700"
            >
              Cancel
            </button>
            <% if available_users.any? %>
              <%= submit_tag "Assign user", class: "rounded-lg bg-[#3F8CFF] px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-[#3A81EB] hover:shadow active:scale-[0.98]" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
