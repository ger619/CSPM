<% progress = ticket.progress_percentage || 0 %>
<% radius = 20 %>
<% stroke = 5 %>
<% normalized_radius = radius - stroke %>
<% circumference = 2 * Math::PI * normalized_radius %>
<% stroke_dashoffset = circumference - (progress.to_f / 100) * circumference %>

<% color = if ticket.progress_percentage.nil?
             '#9CA3AF' # gray-400, no data yet
           elsif ticket.progress_percentage < 30
             '#DC2626' # red-600, needs attention
           elsif ticket.progress_percentage < 60
             '#131D58' # brand navy, in progress
           else
             ticket.progress_percentage >= 100 ? '#131D58' : '#0D9C66' # brand navy at 100%, brand green while trending to done
           end %>

<div class="relative flex h-12 w-12 flex-shrink-0 items-center justify-center sm:h-14 sm:w-14">
  <svg
    height="100%"
    width="100%"
    viewBox="0 0 <%= radius * 2 %> <%= radius * 2 %>"
    class="-rotate-90 transform"
    role="img"
    aria-label="<%= progress %>% complete"
  >
    <circle
      stroke="#E5E7EB"
      fill="transparent"
      stroke-width="<%= stroke %>"
      r="<%= normalized_radius %>"
      cx="<%= radius %>"
      cy="<%= radius %>"
      />
    <circle
      stroke="<%= color %>"
      fill="transparent"
      stroke-width="<%= stroke %>"
      stroke-dasharray="<%= circumference %>"
      stroke-dashoffset="<%= stroke_dashoffset %>"
      stroke-linecap="round"
      r="<%= normalized_radius %>"
      cx="<%= radius %>"
      cy="<%= radius %>"
      />
  </svg>
  <div class="absolute text-xs font-black sm:text-sm" style="color: <%= color %>">
    <%= progress %>%
  </div>
</div>
