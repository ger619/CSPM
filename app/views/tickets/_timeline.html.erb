<div class="relative bottom-0 w-full">
  <!-- Left Scroll Button -->
  <button
    id="scroll-left"
    class="absolute left-0 z-10 flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-500 shadow-sm transition hover:border-[#3F8CFF]/40 hover:text-[#3F8CFF] focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
    style="top: 50%; transform: translateY(-50%); display: none;"
    aria-label="Scroll left">
    &#8592;
  </button>

  <!-- Timeline -->
  <div id="timeline-container" class="relative flex overflow-hidden scroll-smooth px-2">
    <ol class="flex items-start">
      <% @events.each_with_index do |event, index| %>
        <li class="relative mb-6 inline-block w-48 flex-shrink-0 sm:mb-0">
          <div class="flex items-center">
            <div class="z-10 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-[#3F8CFF]/10 ring-8 ring-white dark:bg-[#3F8CFF]/20 dark:ring-slate-900">
              <span class="text-xs font-black text-[#3F8CFF]"><%= index + 1 %></span>
            </div>
            <div class="hidden h-0.5 w-full bg-slate-200 dark:bg-slate-700 sm:flex"></div>
          </div>
          <div class="mt-3 pe-4">
            <h3 class="truncate text-sm font-black text-[#0A1629] dark:text-white"><%= event.user.name %></h3>
            <time class="mb-1.5 block text-xs font-medium text-slate-400"><%= event.created_at.strftime("%B %d, %Y %H:%M") %></time>
            <p class="text-sm leading-snug text-slate-600 dark:text-slate-300"><%= event.details %></p>
          </div>
        </li>
      <% end %>
    </ol>
  </div>

  <!-- Right Scroll Button -->
  <button
    id="scroll-right"
    class="absolute right-0 z-10 flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-500 shadow-sm transition hover:border-[#3F8CFF]/40 hover:text-[#3F8CFF] focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
    style="top: 50%; transform: translateY(-50%); display: none;"
    aria-label="Scroll right">
    &#8594;
  </button>
</div>

<style>
    /* Hide the horizontal scrollbar */
    #timeline-container {
        overflow-x: hidden;
        display: flex;
        white-space: nowrap;
    }
</style>

<script>
  document.addEventListener('turbo:load', () => {
    const timelineContainer = document.getElementById('timeline-container');
    const scrollLeftButton = document.getElementById('scroll-left');
    const scrollRightButton = document.getElementById('scroll-right');

    const updateButtonVisibility = () => {
      const scrollWidth = timelineContainer.scrollWidth;
      const clientWidth = timelineContainer.clientWidth;
      const scrollLeft = timelineContainer.scrollLeft;

      if (scrollWidth > clientWidth) {
        scrollLeftButton.style.display = scrollLeft > 0 ? 'block' : 'none';
        scrollRightButton.style.display = scrollLeft < scrollWidth - clientWidth ? 'block' : 'none';
      } else {
        scrollLeftButton.style.display = 'none';
        scrollRightButton.style.display = 'none';
      }
    };

    scrollLeftButton.addEventListener('click', () => {
      timelineContainer.scrollBy({ left: -200, behavior: 'smooth' });
    });

    scrollRightButton.addEventListener('click', () => {
      timelineContainer.scrollBy({ left: 200, behavior: 'smooth' });
    });

    timelineContainer.addEventListener('scroll', updateButtonVisibility);
    window.addEventListener('resize', updateButtonVisibility);

    // Initial check
    updateButtonVisibility();
  });
</script>
