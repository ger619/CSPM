<% if ticket.statuses.present? %>
  <% ticket.statuses.each do |status| %>
    <% case status.name %>
<% when 'Resolved' %>
      <span class="whitespace-nowrap rounded-full bg-[#0D9C66]/10 px-2.5 py-1 text-xs font-bold text-[#0D9C66]">Resolved</span>
    <% when 'Closed' %>
      <span class="whitespace-nowrap rounded-full bg-slate-200 px-2.5 py-1 text-xs font-bold text-slate-700 dark:bg-slate-700 dark:text-slate-200">Closed</span>
    <% when 'Reopened' %>
      <span class="whitespace-nowrap rounded-full bg-red-100 px-2.5 py-1 text-xs font-bold text-red-800 dark:bg-red-500/15 dark:text-red-300">Reopened</span>
    <% when 'New' %>
      <span class="whitespace-nowrap rounded-full bg-red-100 px-2.5 py-1 text-xs font-bold text-red-800 dark:bg-red-500/15 dark:text-red-300">New</span>
    <% when 'Under Development' %>
      <span class="whitespace-nowrap rounded-full bg-[#131D58]/10 px-2.5 py-1 text-xs font-bold text-[#131D58] dark:bg-[#131D58]/30 dark:text-[#8FA3E6]">Under Development</span>
    <% when 'Work in Progress' %>
      <span class="whitespace-nowrap rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300">Work in Progress</span>
    <% when 'QA Testing' %>
      <span class="whitespace-nowrap rounded-full bg-pink-100 px-2.5 py-1 text-xs font-bold text-pink-800 dark:bg-pink-500/15 dark:text-pink-300">QA Testing</span>
    <% when 'Awaiting Build' %>
      <span class="whitespace-nowrap rounded-full border border-slate-300 px-2.5 py-1 text-xs font-bold text-slate-600 dark:border-slate-600 dark:text-slate-300">Awaiting Build</span>
    <% when 'Client Confirmation Pending' %>
      <span class="whitespace-nowrap rounded-full bg-purple-100 px-2.5 py-1 text-xs font-bold text-purple-800 dark:bg-purple-500/15 dark:text-purple-300">Client Confirmation Pending</span>
    <% when 'On-Hold' %>
      <span class="whitespace-nowrap rounded-full bg-amber-100 px-2.5 py-1 text-xs font-bold text-amber-800 dark:bg-amber-500/15 dark:text-amber-300">On-Hold</span>
    <% when 'Assigned' %>
      <span class="whitespace-nowrap rounded-full bg-[#131D58]/10 px-2.5 py-1 text-xs font-bold text-[#131D58] dark:bg-[#131D58]/30 dark:text-[#8FA3E6]">Assigned</span>
    <% when 'Approved' %>
      <span class="whitespace-nowrap rounded-full bg-[#0D9C66]/10 px-2.5 py-1 text-xs font-bold text-[#0D9C66]">Approved</span>
    <% when 'Pending' %>
      <span class="whitespace-nowrap rounded-full bg-amber-100 px-2.5 py-1 text-xs font-bold text-amber-800 dark:bg-amber-500/15 dark:text-amber-300">Pending</span>
    <% when 'Declined' %>
      <span class="whitespace-nowrap rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300">Declined</span>
    <% end %>
  <% end %>
<% end %>
