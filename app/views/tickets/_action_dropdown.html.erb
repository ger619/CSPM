<div class="relative inline-block text-left">
  <button
    type="button"
    class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3F8CFF]/50 dark:text-slate-400 dark:hover:bg-slate-700 dark:hover:text-slate-200"
    id="menu-button-<%= ticket.id %>"
    aria-expanded="false"
    aria-haspopup="true"
    data-ticket-menu-trigger
    data-menu-target="menu-<%= ticket.id %>"
  >
    <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM12.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM18.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
    </svg>
    <span class="sr-only">Open actions for ticket <%= ticket.unique_id.presence || ticket.id %></span>
  </button>

  <div
    id="menu-<%= ticket.id %>"
    role="menu"
    aria-labelledby="menu-button-<%= ticket.id %>"
    class="hidden w-52 origin-top-right rounded-xl border border-slate-200 bg-white py-1.5 shadow-lg focus:outline-none dark:border-slate-700 dark:bg-slate-800"
    data-ticket-menu
  >
    <%= link_to project_ticket_path(ticket.project, ticket),
                class: "flex items-center gap-2.5 px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700",
                role: "menuitem" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-[18px] w-[18px] flex-shrink-0 text-slate-400" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
      View
    <% end %>

    <%= link_to modal_show_project_ticket_path(ticket.project, ticket),
                data: { turbo_frame: "modal" },
                oncontextmenu: "return false;",
                class: "flex items-center gap-2.5 px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700",
                role: "menuitem" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-[18px] w-[18px] flex-shrink-0 text-slate-400" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12s3.75-6.75 9.75-6.75 9.75 6.75 9.75 6.75-3.75 6.75-9.75 6.75S2.25 12 2.25 12z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      Quick view
    <% end %>

    <% if can?(:edit, ticket) %>
      <%= link_to edit_project_ticket_path(ticket.project, ticket),
                  class: "flex items-center gap-2.5 px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700",
                  role: "menuitem" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-[18px] w-[18px] flex-shrink-0 text-slate-400" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
        </svg>
        Edit
      <% end %>
    <% end %>

    <% if can?(:destroy, ticket) %>
      <div class="my-1.5 border-t border-slate-100 dark:border-slate-700"></div>
      <%= button_to [ticket.project, ticket],
                    method: :delete,
                    data: { turbo_confirm: "Are you sure?" },
                    form_class: "block w-full",
                    class: "flex w-full items-center gap-2.5 px-3 py-2 text-left text-sm font-medium text-red-600 transition hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-500/10",
                    role: "menuitem" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-[18px] w-[18px] flex-shrink-0" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
        </svg>
        Delete
      <% end %>
    <% end %>
  </div>
</div>

<script>
  (function () {
    if (window.__ticketMenusInitialized) return;
    window.__ticketMenusInitialized = true;

    let openMenu = null;
    let openTrigger = null;

    function positionMenu(trigger, menu) {
      const rect = trigger.getBoundingClientRect();
      const menuWidth = menu.offsetWidth || 208;
      const viewportWidth = window.innerWidth;
      const viewportHeight = window.innerHeight;

      let left = rect.right - menuWidth;
      left = Math.max(8, Math.min(left, viewportWidth - menuWidth - 8));

      let top = rect.bottom + 6;
      const menuHeight = menu.offsetHeight || 0;
      if (top + menuHeight > viewportHeight - 8) {
        top = Math.max(8, rect.top - menuHeight - 6);
      }

      menu.style.left = left + "px";
      menu.style.top = top + "px";
    }

    function closeMenu() {
      if (!openMenu) return;
      openMenu.classList.add("hidden");
      if (openTrigger) openTrigger.setAttribute("aria-expanded", "false");
      openMenu = null;
      openTrigger = null;
    }

    document.addEventListener("click", function (event) {
      const trigger = event.target.closest("[data-ticket-menu-trigger]");

      if (trigger) {
        event.preventDefault();
        event.stopPropagation();

        const targetId = trigger.getAttribute("data-menu-target");
        const menu = document.getElementById(targetId);
        if (!menu) return;

        const alreadyOpen = openMenu === menu;
        closeMenu();
        if (alreadyOpen) return;

        if (menu.parentElement !== document.body) {
          document.body.appendChild(menu);
        }
        menu.style.position = "fixed";
        menu.style.zIndex = "1000";
        menu.classList.remove("hidden");

        positionMenu(trigger, menu);

        openMenu = menu;
        openTrigger = trigger;
        trigger.setAttribute("aria-expanded", "true");
        return;
      }

      if (openMenu && !openMenu.contains(event.target)) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape") closeMenu();
    });

    window.addEventListener(
      "scroll",
      function () {
        if (openMenu && openTrigger) positionMenu(openTrigger, openMenu);
      },
      true
    );

    window.addEventListener("resize", function () {
      if (openMenu && openTrigger) positionMenu(openTrigger, openMenu);
    });

    document.addEventListener("turbo:before-cache", closeMenu);
    document.addEventListener("turbo:visit", closeMenu);
  })();
</script>
