<div class="mb-6 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
  <div class="bg-gradient-to-r from-[#131D58] via-[#1a2670] to-[#0D9C66] px-4 py-5 text-white sm:px-6 lg:px-8">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex min-w-0 items-start gap-4">
        <div class="flex h-16 w-16 flex-shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-white/20 bg-white/10 shadow-lg backdrop-blur sm:h-20 sm:w-20">
          <% if @project.image.present? %>
            <%= image_tag(@project.image, class: "h-full w-full object-cover") %>
          <% else %>
            <%= image_tag "logo-mark.png", class: "h-12 w-12 object-contain sm:h-14 sm:w-14" %>
          <% end %>
        </div>

        <div class="min-w-0">
          <p class="text-xs font-bold uppercase tracking-[0.25em] text-white/60">
            Support Desk
          </p>
          <h1 class="mt-1 line-clamp-2 text-xl font-black tracking-tight text-white sm:text-3xl">
            <%= @project.title %>
          </h1>
          <p class="mt-2 line-clamp-2 max-w-3xl text-sm leading-6 text-white/80 sm:text-base">
            <%= @project.description.presence || "No project description available." %>
          </p>
        </div>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row lg:flex-shrink-0">
        <%= link_to new_project_ticket_path(@project),
                    class: "inline-flex h-12 w-full items-center justify-center gap-2 rounded-2xl bg-[#0D9C66] px-5 text-sm font-black text-white shadow-lg shadow-black/10 transition hover:-translate-y-0.5 hover:bg-[#0B8558] focus:outline-none focus:ring-4 focus:ring-white/30 sm:w-auto" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
          <span>New Ticket</span>
        <% end %>

        <% unless current_user.has_role?(:client) %>
          <%= link_to manage_users_project_path(@project),
                      data: { turbo_frame: "modal" },
                      class: "inline-flex h-12 w-full items-center justify-center gap-2 rounded-2xl border border-white/30 bg-white/10 px-5 text-sm font-black text-white shadow-lg shadow-black/10 backdrop-blur transition hover:-translate-y-0.5 hover:bg-white hover:text-[#131D58] focus:outline-none focus:ring-4 focus:ring-white/30 sm:w-auto" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z" />
            </svg>
            <span>Manage Users</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-3 bg-slate-50 px-4 py-4 dark:bg-slate-900/60 sm:grid-cols-2 lg:grid-cols-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs font-bold uppercase tracking-wide text-slate-400">
        Tickets
      </p>
      <p class="mt-1 text-2xl font-black text-[#0A1024] dark:text-white">
        <%= @project.tickets.count %>
      </p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs font-bold uppercase tracking-wide text-slate-400">
        Client
      </p>
      <p class="mt-1 truncate text-sm font-bold text-slate-700 dark:text-slate-200">
        <%= @project.client&.name || "No Client Assigned" %>
      </p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs font-bold uppercase tracking-wide text-slate-400">
        Owner
      </p>
      <p class="mt-1 truncate text-sm font-bold text-slate-700 dark:text-slate-200">
        <%= @project.user&.name || "Unassigned" %>
      </p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs font-bold uppercase tracking-wide text-slate-400">
        Start Date
      </p>
      <p class="mt-1 truncate text-sm font-bold text-slate-700 dark:text-slate-200">
        <%= @project.start_date.present? ? @project.start_date.strftime("%d %b %Y") : "Not Set" %>
      </p>
    </div>
  </div>
</div>

<% if flash[:prompt] %>
  <div id="custom-alert" class="fixed inset-0 z-50 flex items-center justify-center bg-[#0A1024]/70 px-4 backdrop-blur-sm">
    <div class="w-full max-w-md overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl dark:border-slate-800 dark:bg-slate-900">
      <div class="bg-gradient-to-r from-[#131D58] via-[#1a2670] to-[#0D9C66] px-6 py-5 text-white">
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-white/60">
          Notice
        </p>
        <h2 class="mt-1 text-xl font-black">
          Important Message
        </h2>
      </div>

      <div class="p-6">
        <p class="text-sm leading-6 text-slate-600 dark:text-slate-300">
          <%= flash[:prompt] %>
        </p>

        <div class="mt-6 flex justify-end">
          <button id="close-alert"
                  class="inline-flex h-11 items-center justify-center rounded-2xl bg-[#131D58] px-6 text-sm font-black text-white shadow-lg shadow-[#131D58]/20 transition hover:bg-[#1a2670] focus:outline-none focus:ring-4 focus:ring-[#131D58]/25">
            OK
          </button>
        </div>
      </div>
    </div>
  </div>

  <script type="text/javascript">
    document.addEventListener("turbo:load", () => {
      const alertBox = document.getElementById("custom-alert");
      const closeButton = document.getElementById("close-alert");

      if (!alertBox || !closeButton) return;

      closeButton.addEventListener("click", () => {
        alertBox.remove();
      });
    });
  </script>
<% end %>
