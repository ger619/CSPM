<div class="space-y-2">
  <div class="flex items-baseline justify-between gap-3">
    <p class="text-sm font-semibold text-slate-500 dark:text-slate-400">Product</p>
    <p class="text-right text-sm font-bold text-[#0A1024] dark:text-white">
      <% if @ticket.software.present? %>
        <%= @ticket.software&.name || 'No software assigned' %>
      <% else %>
        —
      <% end %>
    </p>
  </div>
  <div class="flex items-baseline justify-between gap-3">
    <p class="text-sm font-semibold text-slate-500 dark:text-slate-400">Sub-product</p>
    <p class="text-right text-sm font-bold text-[#0A1024] dark:text-white">
      <% if @ticket.software.present? %>
        <% selected_groupware = @ticket.software.groupwares.find_by(id: @ticket.groupware_id) %>
        <% if selected_groupware %>
          <%= selected_groupware.name %>
        <% else %>
          No groupware assigned
        <% end %>
      <% else %>
        —
      <% end %>
    </p>
  </div>
</div>
