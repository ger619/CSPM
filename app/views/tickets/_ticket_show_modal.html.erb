<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 overflow-hidden" data-controller="modal">
    <!-- Blurred background -->
    <div class="absolute inset-0 bg-[#0A1024]/60 backdrop-blur-sm transition-opacity duration-300"></div>

    <!-- Modal container - two columns -->
    <div class="fixed inset-y-0 right-0 flex w-full max-w-6xl overflow-hidden shadow-2xl">
      <!-- Left panel (ticket details) -->
      <div class="relative w-1/2 overflow-y-auto bg-white dark:bg-gray-800">
        <!-- Accent header bar -->
        <div class="sticky top-0 z-10 bg-gradient-to-r from-[#131D58] via-[#1a2670] to-[#0D9C66] px-6 py-5">
          <button
            class="absolute right-4 top-4 rounded-lg p-1.5 text-white/70 transition hover:bg-white/10 hover:text-white"
            data-action="click->modal#close"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            <span class="sr-only">Close</span>
          </button>

          <p class="text-xs font-bold uppercase tracking-wider text-white/60">Ticket details</p>
          <h2 class="mt-1 text-xl font-black text-white">Issue ID <%= @ticket.unique_id %></h2>
          <p class="mt-2 text-sm text-white/80">
            <span class="font-semibold text-white">Created by</span> <%= @ticket.user.name %>
            <span class="mx-1.5 text-white/40">·</span>
            <span class="font-semibold text-white">Issue type</span> <%= @ticket.issue %>
          </p>
        </div>

        <div class="p-6">
          <!-- SECTION 2: Image and Details row -->
          <%#= render partial: "tickets/ticketshow_top_left" %>

          <!-- SECTION 3: Target Times and SLA sections of the ticket show-->
          <%= render partial: "tickets/tickets_targets_sla", locals: { ticket: @tickets} %>

          <!-- Subject and Content -->
          <div class="col-span-2 mt-6 space-y-5">
            <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4 dark:border-gray-700 dark:bg-gray-900/40">
              <div class="mb-1 text-xs font-bold uppercase tracking-wider text-[#131D58] dark:text-[#8FA3E6]">Subject</div>
              <div class="text-base font-semibold text-gray-900 dark:text-white">
                <%= @ticket.subject %>
              </div>
            </div>

            <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4 dark:border-gray-700 dark:bg-gray-900/40">
              <div class="mb-1 text-xs font-bold uppercase tracking-wider text-[#131D58] dark:text-[#8FA3E6]">Content</div>
              <div class="whitespace-pre-wrap text-base text-gray-700 dark:text-gray-300">
                <% if @ticket.content.present? %>
                  <%= sanitize raw(@ticket.content.to_trix_html.gsub(/\[.*?\]/, '').strip) %>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Assigned Users -->
          <div class="mt-6 border-t border-slate-100 pt-6 dark:border-gray-700">
            <%= render 'tickets/assign_people_tickets' %>
          </div>

          <!-- Due Date, Severity, Issue Type -->
          <div class="mt-6 border-t border-slate-100 pt-6 dark:border-gray-700">
            <%= render 'tickets/custom_field' %>
          </div>
        </div>
      </div>

      <!-- Right panel (messaging) -->
      <div class="flex w-1/2 flex-col border-l border-slate-200 bg-slate-50 dark:border-gray-600 dark:bg-gray-700">
        <!-- Messages header -->
        <div class="flex items-center gap-2 border-b border-slate-200 bg-white px-5 py-4 dark:border-gray-600 dark:bg-gray-800">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#0D9C66]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 0 1-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8Z" />
          </svg>
          <h3 class="font-black text-gray-900 dark:text-white">Messages</h3>
        </div>

        <!-- Messages content -->
        <div class="flex-1 space-y-4 overflow-y-auto p-4" id="messages">
          <%= render 'issues/issues_table', ticket_items: @ticket %>
        </div>

        <!-- New message button -->
        <% unless @ticket.statuses.first&.name == 'Closed' %>
          <div data-controller="messages">
            <!-- Single New Message Button -->
            <div class="border-t border-slate-200 bg-white p-4 dark:border-gray-600 dark:bg-gray-800">
              <button
                id="newMessageButton"
                class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#0D9C66] px-4 py-2.5 font-semibold text-white shadow-sm transition hover:bg-[#0B8558] hover:shadow active:scale-[0.98]"
                data-action="click->messages#toggleForm"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                </svg>
                New message
              </button>
            </div>

            <!-- Form Container (initially hidden) -->
            <div id="messageFormContainer" class="hidden" data-messages-target="form">
              <%= render 'issues/form', project: @project, ticket: @ticket, issue: Issue.new %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Image modal -->
  <div id="imageModal" class="modal hidden fixed inset-0 z-50 overflow-auto bg-[#0A1024]/80" data-controller="image-modal" data-image-modal-target="modal">
    <span class="close absolute top-4 right-4 cursor-pointer text-3xl text-white/80 transition hover:text-white" data-action="click->image-modal#closeModal" data-image-modal-target="closeButton">&times;</span>
    <img class="modal-content m-auto block max-h-screen max-w-full" id="fullImage" data-image-modal-target="modalImage" alt='show image'>
  </div>
<% end %>
