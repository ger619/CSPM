<div class="p-2">
  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[700px] text-left text-sm text-slate-700 dark:text-slate-300">
        <thead class="bg-gradient-to-r from-[#131D58] via-[#1a2670] to-[#0D9C66] text-xs uppercase tracking-wide text-white">
        <tr>
          <th class="px-3 py-3 text-center font-bold">ID</th>
          <th class="px-3 py-3 text-center font-bold">Issue</th>
          <th class="px-3 py-3 text-center font-bold">Priority</th>
          <th class="px-3 py-3 font-bold">Subject</th>
          <th class="px-3 py-3 text-center font-bold">Actions</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        <% @tickets.each do |ticket| %>
          <tr class="bg-white transition hover:bg-[#131D58]/[0.03] dark:bg-slate-900 dark:hover:bg-slate-800">
            <td class="px-3 py-3 text-center">
              <%= link_to ticket.unique_id, project_ticket_path(ticket.project, ticket), class: "text-xs font-black uppercase text-[#131D58] hover:underline dark:text-[#8FA3E6]" if ticket.unique_id.present? %>
            </td>
            <td class="px-3 py-3 text-center">
              <%= link_to ticket.issue, project_ticket_path(ticket.project, ticket), class: "text-sm font-semibold text-slate-700 hover:text-[#131D58] dark:text-slate-200 dark:hover:text-white" %>
            </td>

            <!-- Priority and severity -->
            <td class="px-3 py-3">
              <div class="flex w-full justify-center">
                <%= render partial: "tickets/priority_severity", locals: { ticket: ticket } %>
              </div>
            </td>

            <!-- Ticket subject -->
            <td class="max-w-xs truncate px-3 py-3 text-sm font-semibold text-slate-700 dark:text-slate-200">
              <%= ticket.subject.truncate(50) if ticket.subject.present? %>
            </td>

            <!-- View button -->
            <td class="px-3 py-3 text-center">
              <%= link_to 'View', project_ticket_path(ticket.project, ticket), class: 'rounded-lg bg-[#0D9C66] px-3 py-1.5 text-xs font-bold text-white shadow-sm transition hover:bg-[#0B8558] hover:shadow active:scale-[0.98]' %>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pagination Links -->
  <div class="mt-4 flex items-center gap-2">
    <% if @page > 1 %>
      <%= link_to 'Previous', sla_breached_tickets_project_tickets_path(@project, page: @page - 1),
                  class: 'rounded-lg border border-[#131D58]/20 bg-white px-4 py-2 text-sm font-bold text-[#131D58] shadow-sm transition hover:border-[#131D58] hover:bg-[#131D58]/5 dark:border-slate-700 dark:bg-slate-900 dark:text-[#8FA3E6]'
      %>
    <% end %>
    <% if @page < @total_pages %>
      <%= link_to 'Next', sla_breached_tickets_project_tickets_path(@project, page: @page + 1),
                  class: 'rounded-lg bg-[#0D9C66] px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-[#0B8558] hover:shadow active:scale-[0.98]'
      %>
    <% end %>
  </div>
</div>
