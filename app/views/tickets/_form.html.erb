<% provide(:title, "New Ticket for: #{@project.title}") %>

<%= render 'tickets/new_back' %>

<%= form_with(model: [project, project.tickets.build],
              data: {
                turbo: false,
                controller: 'ticket-form',
                'ticket-form-project-id-value': @project.id
              }) do |f| %>
  <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-6">
    <h1 class="mb-5 text-lg font-black text-[#0A1024] dark:text-white">New ticket</h1>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <!-- Issue Field -->
      <div>
        <%= f.label :issue, 'Issue *', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
        <% if project.special %>
          <%= f.select :issue, options_for_select(['SUPPORT', 'NEW FEATURE', 'BUG', 'REQUEST', 'INCIDENT', 'CHANGE REQUEST']), {},
                       class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white",
                       placeholder: 'Select the issue', required: true %>
        <% else %>
          <%= f.select :issue, options_for_select(['SUPPORT', 'NEW FEATURE', 'BUG', 'REQUEST', 'INCIDENT']), {},
                       class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white",
                       placeholder: 'Select the issue', required: true %>
        <% end %>
        <% if @ticket.errors[:issue].any? %>
          <div class="mt-1.5 text-xs font-semibold text-red-600"><%= @ticket.errors[:issue].join(", ") %></div>
        <% end %>
      </div>

      <!-- Priority Field -->
      <div>
        <%= f.label :priority, 'Severity *', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
        <%= f.select :priority, options_for_select(['SEVERITY 1', 'SEVERITY 2', 'SEVERITY 3', 'SEVERITY 4']), {},
                     class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white",
                     placeholder: 'Select the severity', required: true %>
        <% if @ticket.errors[:priority].any? %>
          <div class="mt-1.5 text-xs font-semibold text-red-600"><%= @ticket.errors[:priority].join(", ") %></div>
        <% end %>
      </div>

      <!-- Software Field -->
      <div>
        <%= f.label :software_id, 'Product category *', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
        <%= f.collection_select :software_id, @project.softwares, :id, :name,
                                { prompt: "Select product" },
                                { class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white",
                                  id: "software-select",
                                  data: {
                                    'ticket-form-target': "software",
                                    action: "change->ticket-form#updateGroupwareOptions"
                                  } }
        %>
      </div>

      <!-- Groupware Field -->
      <div id="groupware-field"
           data-ticket-form-target="groupwareField"
           style="display: none;">
        <%= f.label :groupware_id, 'Sub category *', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
        <%= f.collection_select :groupware_id,
                                [],
                                :id,
                                :name,
                                { prompt: "Select the product" },
                                { class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white",
                                  id: "groupware-select",
                                  data: { 'ticket-form-target': "groupware" },
                                  required: true }
        %>
      </div>

      <!-- File Upload Field -->
      <div>
        <%= f.label :image, 'Upload image', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
        <%= f.file_field :ticket_image, accept: "image/jpeg,image/png", class: "block w-full text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-[#131D58]/10 file:px-3 file:py-2 file:text-xs file:font-bold file:text-[#131D58] hover:file:bg-[#131D58]/20 dark:text-slate-300" %>
        <% if @ticket.errors[:ticket_image].any? %>
          <div class="mt-1.5 text-xs font-semibold text-red-600"><%= @ticket.errors[:ticket_image].join(", ") %></div>
        <% end %>
      </div>

      <div>
        <%= f.label :attachments, 'Upload files (PDF/Excel/SQL/RPT)', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
        <%= f.file_field :attachments, multiple: true, accept: ".pdf , .xlsx , .xls , .exe , .rpt , .sql ", class: "block w-full text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-[#131D58]/10 file:px-3 file:py-2 file:text-xs file:font-bold file:text-[#131D58] hover:file:bg-[#131D58]/20 dark:text-slate-300" %>
        <% if @ticket.errors[:attachments].any? %>
          <div class="mt-1.5 text-xs font-semibold text-red-600"><%= @ticket.errors[:attachments].join(", ") %></div>
        <% end %>
      </div>

      <div class="sm:col-span-2">
        <%= f.label :subject, 'Subject *', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
        <%= f.text_field :subject, class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white", placeholder: 'A short summary of the issue', required: true %>
        <% if @ticket.errors[:subject].any? %>
          <div class="mt-1.5 text-xs font-semibold text-red-600"><%= @ticket.errors[:subject].join(", ") %></div>
        <% end %>
      </div>
    </div>

    <!-- Content Field -->
    <div class="mt-4">
      <%= f.label :title, 'Description *', class: "mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
      <div data-controller="text-limit" data-text-limit-limit-value="3000">
        <p id="char-count" class="mb-1.5 text-xs font-semibold text-slate-400">0/3000</p>
        <%= f.rich_text_area :content, id: "content", data: { text_limit_target: "content", is_admin: current_user.has_role?(:admin) || current_user.has_role?('project manager') || current_user.has_role?('agent') }, class: "min-h-[300px] rounded-lg border border-slate-200 dark:border-slate-700 #{'border-red-500' if @ticket.errors[:content].any?}" %>
      </div>

      <!-- Attachments -->
      <% if @ticket.attachments.any? %>
        <div class="mt-4 space-y-1.5">
          <p class="text-xs font-bold uppercase tracking-wide text-slate-400">Attachments</p>
          <% @ticket.attachments.each do |attachment| %>
            <div class="rounded-lg border border-slate-100 bg-slate-50 px-3 py-2 dark:border-slate-800 dark:bg-slate-900/60">
              <%= link_to attachment.filename.to_s, url_for(attachment), target: "_blank", class: "text-sm font-bold text-[#131D58] hover:underline dark:text-[#8FA3E6]" %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% @ticket.attachments.each do |attachment| %>
        <div class="mt-3">
          <% if attachment.previewable? %>
            <%= image_tag attachment.preview(resize: "300x300"), class: "rounded-xl" %>
          <% else %>
            <%= link_to attachment.filename.to_s, url_for(attachment), target: "_blank", class: "text-sm font-bold text-[#131D58] hover:underline dark:text-[#8FA3E6]" %>
          <% end %>
        </div>
      <% end %>

      <% if @ticket.errors[:content].any? %>
        <div class="mt-1.5 text-xs font-semibold text-red-600"><%= @ticket.errors[:content].join(", ") %></div>
      <% end %>
    </div>

    <%= f.submit "Submit", class: 'mt-5 w-full rounded-lg bg-[#0D9C66] px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-[#0B8558] hover:shadow active:scale-[0.98] sm:w-auto' %>
  </div>
<% end %>
