<% @tickets.each do |ticket| %>
  <tr class="border-b border-slate-100 bg-white transition hover:bg-[#131D58]/[0.03] dark:border-slate-800 dark:bg-slate-900 dark:hover:bg-slate-800">
    <th scope="row" class="whitespace-nowrap px-3 py-3 text-left text-xs font-black uppercase text-[#131D58] dark:text-[#8FA3E6]">
      <%= link_to ticket.unique_id, project_ticket_path(ticket.project, ticket), class: "hover:underline" if ticket.unique_id.present? %>
    </th>

    <th scope="row" class="whitespace-nowrap px-3 py-3 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">
      <%= link_to ticket.created_at.strftime("%d %b %Y"), project_ticket_path(ticket.project, ticket), class: "hover:text-[#131D58] dark:hover:text-white" %>
    </th>

    <th scope="row" class="max-w-[160px] truncate px-3 py-3 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">
      <%= link_to ticket.project.title, project_ticket_path(ticket.project, ticket), class: "hover:text-[#131D58] dark:hover:text-white" %>
    </th>

    <th scope="row" class="whitespace-nowrap px-3 py-3 text-left text-sm font-semibold text-slate-700 dark:text-slate-200">
      <%= link_to ticket.issue, project_ticket_path(ticket.project, ticket), class: "hover:text-[#131D58] dark:hover:text-white" %>
    </th>

    <!-- Priority -->
    <td class="px-3 py-3">
      <div class="flex w-full justify-center">
        <%= render partial: "tickets/priority_severity", locals: { ticket: ticket } %>
      </div>
    </td>

    <!-- Summary -->
    <td class="max-w-xs px-3 py-3">
      <%= render partial: 'tickets/summary', locals: { ticket: ticket } %>
    </td>

    <!-- Assigned to -->
    <td class="px-3 py-3">
      <div class="flex max-w-[220px] flex-wrap gap-1.5">
        <% ticket.users.each do |user| %>
          <% if user.name.present? %>
            <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
              <%= user.name %>
              <% if user.teams.any? %>
                <span class="font-medium text-slate-400">· <%= user.teams.map(&:name).join(', ') %></span>
              <% else %>
                <span class="font-medium text-slate-400">· No team</span>
              <% end %>
            </span>
          <% end %>
        <% end %>
      </div>
    </td>

    <!-- Ticket Status -->
    <td class="px-3 py-3">
      <div class="flex w-full justify-center">
        <%= render partial: "tickets/ticket_status", locals: { ticket: ticket } %>
      </div>
    </td>

    <!-- Progress Bar -->
    <td class="px-3 py-3">
      <div class="flex w-full justify-center">
        <%= render partial: "tickets/progress_bar", locals: { ticket: ticket } %>
      </div>
    </td>

    <!-- View button -->
    <td class="whitespace-nowrap px-3 py-3 text-right" data-controller="dropdown" data-dropdown-ticket-id-value="<%= ticket.id %>">
      <%= render partial: 'tickets/action_dropdown', locals: { ticket: ticket } %>
    </td>
  </tr>
<% end %>
