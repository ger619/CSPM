<% if ticket.priority == 'SEVERITY 1' %>
  <span class="whitespace-nowrap rounded-full bg-red-100 px-2.5 py-1 text-xs font-black text-red-800 dark:bg-red-500/15 dark:text-red-300">SEVERITY 1</span>
<% elsif ticket.priority == 'SEVERITY 2' %>
  <span class="whitespace-nowrap rounded-full bg-orange-100 px-2.5 py-1 text-xs font-black text-orange-800 dark:bg-orange-500/15 dark:text-orange-300">SEVERITY 2</span>
<% elsif ticket.priority == 'SEVERITY 3' %>
  <span class="whitespace-nowrap rounded-full bg-yellow-100 px-2.5 py-1 text-xs font-black text-yellow-800 dark:bg-yellow-500/15 dark:text-yellow-300">SEVERITY 3</span>
<% else %>
  <span class="whitespace-nowrap rounded-full bg-[#131D58]/10 px-2.5 py-1 text-xs font-black text-[#131D58] dark:bg-[#131D58]/30 dark:text-[#8FA3E6]">SEVERITY 4</span>
<% end %>
