<div class="mb-4 flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900 lg:flex-row lg:items-center lg:justify-between">
  <!-- Search Input -->
  <div class="relative w-full lg:max-w-md">
    <%= form_with url: project_path(@project), method: :get, class: 'flex gap-2' do |f| %>
      <%= f.text_field :query, class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition placeholder-slate-400 focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:placeholder-slate-500", placeholder: "Search by issue or subject" %>
    <% end %>
  </div>

  <!-- Right Side Controls -->
  <div class="flex flex-wrap items-center gap-2">
    <!-- Filter Dropdown -->
    <div class="relative">
      <button id="filterDropdownButton" class="flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-bold text-slate-600 shadow-sm transition hover:border-[#131D58]/40 hover:text-[#131D58] dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L12 11.414V15a1 1 0 01-.293.707l-2 2A1 1 0 018 17v-5.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd" />
        </svg>
        Filter
      </button>

      <!-- Filter Dropdown Menu -->
      <div id="filterDropdown" class="hidden absolute right-0 z-20 mt-2 w-72 origin-top-right rounded-xl border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-800">
        <%= form_with url: project_path(@project), method: :get, class: 'space-y-3 p-3' do %>
          <!-- Order Filter -->
          <div>
            <%= label_tag :order, 'Sort by', class: 'mb-1 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400' %>
            <%= select_tag :order, options_for_select([['Latest First', 'desc'], ['Oldest First', 'asc']], params[:order]),
                           class: "w-full rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200" %>
          </div>

          <!-- Date Range -->
          <div class="grid grid-cols-2 gap-2">
            <div>
              <%= label_tag :start_date, 'From', class: 'mb-1 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400' %>
              <%= date_field_tag :start_date, params[:start_date], class: "w-full rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200" %>
            </div>
            <div>
              <%= label_tag :end_date, 'To', class: 'mb-1 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400' %>
              <%= date_field_tag :end_date, params[:end_date], class: "w-full rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200" %>
            </div>
          </div>

          <!-- Status Filter -->
          <div>
            <%= label_tag 'status[]', 'Status', class: 'mb-1 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400' %>
            <div class="relative w-full">
              <button type="button"
                      id="statusDropdownButton"
                      class="flex w-full items-center justify-between rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-left text-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
                      onclick="document.getElementById('statusDropdown').classList.toggle('hidden')">
                Filter by status
                <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>

              <div id="statusDropdown"
                   class="absolute z-10 mt-1 hidden w-full rounded-lg border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-800">
                <div class="max-h-60 space-y-1.5 overflow-y-auto p-2">
                  <% @statuses.each do |status| %>
                    <div class="flex items-center">
                      <%= check_box_tag 'status[]', status, Array(params[:status]).include?(status),
                                        id: "status_#{status.parameterize}",
                                        class: "mr-2 rounded border-slate-300 text-[#131D58] focus:ring-[#131D58]" %>
                      <%= label_tag "status_#{status.parameterize}", status.capitalize, class: "text-sm text-slate-700 dark:text-slate-200" %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Priority Filter -->
          <div>
            <%= label_tag :priority, 'Priority', class: 'mb-1 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400' %>
            <%= select_tag :priority, options_for_select(['SEVERITY 1', 'SEVERITY 2', 'SEVERITY 3', 'SEVERITY 4'], params[:priority]),
                           include_blank: 'All priorities',
                           class: "w-full rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200" %>
          </div>

          <!-- Issue Type Filter -->
          <div>
            <%= label_tag :issue, 'Issue type', class: 'mb-1 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400' %>
            <%= select_tag :issue, options_for_select(['SUPPORT', 'NEW FEATURE', 'BUG', 'REQUEST', 'INCIDENT'], params[:issue]),
                           include_blank: 'All types',
                           class: "w-full rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200" %>
          </div>

          <% if current_user.has_role?(:agent) || current_user.has_role?('project manager') || current_user.has_role?(:admin) || current_user.has_role?(:observer) %>
            <div>
              <%= label_tag :user_id, 'Assignee', class: 'mb-1 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400' %>
              <%= select_tag :user_id, options_from_collection_for_select(@project.users.with_assigned_role, :id, ->(u) { "#{u.first_name} #{u.last_name}" }, params[:user_id]),
                             include_blank: 'All assignees',
                             class: "w-full rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200" %>
            </div>
          <% end %>

          <div class="flex items-center justify-between border-t border-slate-100 pt-3 dark:border-slate-700">
            <%= link_to 'Reset', project_path(@project), class: 'text-sm font-bold text-red-600 hover:underline' %>
            <%= submit_tag 'Apply', class: 'rounded-lg bg-[#131D58] px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-[#1a2670] active:scale-[0.98]' %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Last Month Filter -->
    <%= form_with url: project_path(@project), method: :get do %>
      <%= hidden_field_tag :last_month, true %>
      <button type="submit" class="flex items-center gap-1.5 rounded-lg border px-3 py-2 text-sm font-bold shadow-sm transition <%= @use_last_month_filter ? 'border-[#131D58] bg-[#131D58]/10 text-[#131D58]' : 'border-slate-200 bg-white text-slate-600 hover:border-[#131D58]/40 hover:text-[#131D58] dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300' %>">
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
        </svg>
        Last month
      </button>
    <% end %>

    <!-- View All Link -->
    <%= link_to project_path(@project), class: "flex items-center gap-1 rounded-lg bg-[#0D9C66] px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-[#0B8558] hover:shadow active:scale-[0.98]" do %>
      <span>View all</span>
      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
      </svg>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", function () {
    const filterButton = document.getElementById("filterDropdownButton");
    const filterDropdown = document.getElementById("filterDropdown");

    // Remove any previously attached event listeners (cleanup)
    const newButton = filterButton.cloneNode(true);
    filterButton.parentNode.replaceChild(newButton, filterButton);

    const newDropdown = filterDropdown.cloneNode(true);
    filterDropdown.parentNode.replaceChild(newDropdown, filterDropdown);

    // Re-query after DOM replacement
    const button = document.getElementById("filterDropdownButton");
    const dropdown = document.getElementById("filterDropdown");

    if (button && dropdown) {
      button.addEventListener("click", function (e) {
        e.stopPropagation();
        dropdown.classList.toggle("hidden");
      });

      document.addEventListener("click", function () {
        dropdown.classList.add("hidden");
      });

      dropdown.addEventListener("click", function (e) {
        e.stopPropagation();
      });
    }
  });
</script>
