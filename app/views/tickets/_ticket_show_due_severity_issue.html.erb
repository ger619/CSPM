<section class="space-y-5 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
  <p class="text-xs font-bold uppercase tracking-wide text-slate-400">Ticket details</p>

  <!-- Due Date Field -->
  <% if current_user.has_role?(:agent) || current_user.has_role?(:admin) || current_user.has_role?('project manager') || current_user.has_role?(:observer) %>
    <div>
      <div class="mb-1.5 text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Due date</div>
      <%= form_with model: @ticket, url: update_due_date_project_ticket_path(@ticket.project, @ticket), method: :patch, remote: true, class: "flex items-center gap-2" do |f| %>
        <div class="relative flex-1">
          <%= f.date_field :due_date, value: @ticket.due_date,
                           class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#3F8CFF] focus:outline-none focus:ring-2 focus:ring-[#3F8CFF]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200",
                           required: true %>
        </div>
        <button type="submit" class="flex-shrink-0 rounded-lg bg-[#3F8CFF] px-3 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#3A81EB] hover:shadow active:scale-[0.98]">
          Update
        </button>
      <% end %>
    </div>
  <% end %>

  <!-- Priority Field -->
  <% if current_user.has_role?(:admin) || current_user.has_role?('project manager') || current_user.has_role?(:observer) %>
    <div>
      <div class="mb-1.5 text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Severity <span class="text-red-500">*</span></div>
      <%= form_with model: @ticket, url: update_priority_project_ticket_path(@ticket.project, @ticket), method: :patch, remote: true do |f| %>
        <div class="flex items-center gap-2">
          <div class="relative flex-1">
            <%= f.select :priority, options_for_select(['SEVERITY 1', 'SEVERITY 2', 'SEVERITY 3', 'SEVERITY 4'], @ticket.priority), {},
                         class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#3F8CFF] focus:outline-none focus:ring-2 focus:ring-[#3F8CFF]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200",
                         required: true %>
          </div>
          <button type="submit" class="flex-shrink-0 rounded-lg bg-[#3F8CFF] px-3 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#3A81EB] hover:shadow active:scale-[0.98]">
            Update
          </button>
        </div>
        <% if @ticket.errors[:priority].any? %>
          <div class="mt-1.5 text-xs font-semibold text-red-600"><%= @ticket.errors[:priority].join(", ") %></div>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <!-- Issue Type Field -->
  <% if current_user.has_role?(:admin) || current_user.has_role?('project manager') || current_user.has_role?(:observer) %>
    <div>
      <div class="mb-1.5 text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Issue type <span class="text-red-500">*</span></div>
      <%= form_with model: @ticket, url: update_issue_type_project_ticket_path(@ticket.project, @ticket), method: :patch, remote: true do |f| %>
        <div class="flex items-center gap-2">
          <div class="relative flex-1">
            <% if @ticket.project.special %>
              <%= f.select :issue, options_for_select(['SUPPORT', 'NEW FEATURE', 'BUG', 'REQUEST', 'INCIDENT', 'CHANGE REQUEST'], @ticket.issue), {},
                           class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#3F8CFF] focus:outline-none focus:ring-2 focus:ring-[#3F8CFF]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200",
                           required: true %>
            <% else %>
              <%= f.select :issue, options_for_select(['SUPPORT', 'NEW FEATURE', 'BUG', 'REQUEST', 'INCIDENT'], @ticket.issue), {},
                           class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#3F8CFF] focus:outline-none focus:ring-2 focus:ring-[#3F8CFF]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200",
                           required: true %>
            <% end %>
          </div>
          <button type="submit" class="flex-shrink-0 rounded-lg bg-[#3F8CFF] px-3 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#3A81EB] hover:shadow active:scale-[0.98]">
            Update
          </button>
        </div>
        <% if @ticket.errors[:issue].any? %>
          <div class="mt-1.5 text-xs font-semibold text-red-600"><%= @ticket.errors[:issue].join(", ") %></div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
