<section class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-6">
  <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-wide text-[#131D58] dark:text-[#8FA3E6]">Feedback</p>
      <h3 class="text-lg font-black text-[#0A1024] dark:text-white">Ratings</h3>
    </div>
    <div class="flex items-center gap-1.5 rounded-full bg-[#0D9C66]/10 px-3 py-1.5 text-sm font-bold text-[#0D9C66]">
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.447a1 1 0 00-.363 1.118l1.287 3.958c.3.922-.755 1.688-1.538 1.118l-3.367-2.447a1 1 0 00-1.176 0l-3.367 2.447c-.784.57-1.838-.196-1.539-1.118l1.287-3.958a1 1 0 00-.363-1.118L2.062 9.385c-.783-.57-.38-1.81.588-1.81h4.163a1 1 0 00.95-.69l1.286-3.958z" />
      </svg>
      <%= @ticket.ratings.average(:value).to_f.round(1) %> / 5
    </div>
  </div>

  <div data-controller="ticket-ratings">
    <button id="open-modal"
            class="w-full rounded-lg border border-[#131D58]/20 bg-white px-4 py-2.5 text-sm font-bold text-[#131D58] shadow-sm transition hover:border-[#131D58] hover:bg-[#131D58]/5 dark:border-slate-700 dark:bg-slate-900 dark:text-[#8FA3E6] sm:w-auto"
            data-action="click->ticket-ratings#openModal">
      Submit a review
    </button>

    <div id="rating-modal"
         class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm"
         data-ticket-ratings-target="modal">
      <div class="w-full max-w-lg overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl dark:border-slate-700 dark:bg-slate-800">
        <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4 dark:border-slate-700">
          <h3 class="text-base font-black text-[#0A1024] dark:text-white">Submit review</h3>
          <button id="close-modal"
                  class="rounded-lg p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-700"
                  data-action="click->ticket-ratings#closeModal">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
            <span class="sr-only">Close</span>
          </button>
        </div>

        <div class="px-5 py-5">
          <%= form_with model: [@project, @ticket, Rating.new], local: true do |f| %>
            <ul class="stars mb-4 flex gap-2">
              <% (1..5).each do |star| %>
                <li class="star cursor-pointer text-2xl text-slate-300 transition hover:scale-110 dark:text-slate-600"
                    data-value="<%= star %>"
                    data-action="mouseover->ticket-ratings#highlightStars
                                mouseout->ticket-ratings#resetStars
                                click->ticket-ratings#setRating"
                    data-ticket-ratings-star-value="<%= star %>">
                  <i class="fa fa-star"></i>
                </li>
              <% end %>
            </ul>
            <%= f.hidden_field :value, id: 'rating-value', data: { 'ticket-ratings-target': 'ratingValue' } %>
            <%= f.text_area :comment, class: 'block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200', placeholder: 'Leave a comment...', rows: 4 %>
            <%= f.submit 'Submit', class: 'mt-3 w-full rounded-lg bg-[#0D9C66] px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#0B8558] hover:shadow active:scale-[0.98] sm:w-auto' %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
