<div class="p-2">
  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[900px] text-left text-sm text-slate-700 dark:text-slate-300">
        <thead class="bg-gradient-to-r from-[#131D58] via-[#1a2670] to-[#0D9C66] text-xs uppercase tracking-wide text-white">
        <tr>
          <th class="px-3 py-3 font-bold">ID</th>
          <th class="px-3 py-3 font-bold">Date</th>
          <th class="px-3 py-3 font-bold">Service Desk Name</th>
          <th class="px-3 py-3 font-bold">Issue</th>
          <th class="px-3 py-3 text-center font-bold">Priority</th>
          <th class="px-3 py-3 font-bold">Summary</th>
          <th class="px-3 py-3 font-bold">Assignee</th>
          <th class="px-3 py-3 text-center font-bold">Status</th>
          <th class="px-3 py-3 text-center font-bold">Progress</th>
          <th class="px-3 py-3 text-right font-bold">View</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        <%= render partial: "tickets/all_open_tickets_body" %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pagination Links -->
  <div class="mt-4 flex items-center gap-2">
    <% if @page > 1 %>
      <%= link_to 'Previous', project_tickets_path(@project, page: @page - 1),
                  class: 'rounded-lg border border-[#131D58]/20 bg-white px-4 py-2 text-sm font-bold text-[#131D58] shadow-sm transition hover:border-[#131D58] hover:bg-[#131D58]/5 dark:border-slate-700 dark:bg-slate-900 dark:text-[#8FA3E6]'
      %>
    <% end %>
    <% if @page < @total_pages %>
      <%= link_to 'Next', project_tickets_path(@project, page: @page + 1),
                  class: 'rounded-lg bg-[#0D9C66] px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-[#0B8558] hover:shadow active:scale-[0.98]'
      %>
    <% end %>
  </div>
</div>
