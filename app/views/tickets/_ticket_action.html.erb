<% if @project.special && @ticket.issue == 'CHANGE REQUEST' %>
  <% if current_user.has_role?(:admin) || current_user.has_role?(:observer) %>
    <%= form_with url: add_status_project_ticket_path(@project, @ticket, data: { turbo: false}), local: true do %>
      <% current_status = @ticket.statuses.first&.name %>
      <div class="flex flex-col gap-2">
        <% if @ticket.statuses.empty? %>
          <%= select_tag :status_id, options_for_select(Status.where(name: ['Assigned']).pluck(:name, :id)), class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" %>
        <% elsif current_status == 'Assigned' %>
          <%= select_tag :status_id, options_for_select(Status.where(name: %w[Approved Declined Pending]).pluck(:name, :id), @ticket.statuses.first.id), class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" %>
          <%= submit_tag "Update status", class: 'w-full rounded-lg bg-[#131D58] px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#1a2670] active:scale-[0.98]' %>
        <% elsif current_status == 'Pending' %>
          <%= select_tag :status_id, options_for_select(Status.where(name: %w[Approved Declined]).pluck(:name, :id), @ticket.statuses.first.id), class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" %>
          <%= submit_tag "Update", class: 'w-full rounded-lg bg-[#131D58] px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#1a2670] active:scale-[0.98]' %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% allowed_statuses = ['Approved', 'Work in Progress', 'On-Hold', 'Under Development', 'QA Testing', 'Client Confirmation Pending', 'Awaiting Build', 'Reopened', 'Resolved', 'Closed', 'Declined'] %>
  <% current_status = @ticket.statuses.first&.name %>
  <% if allowed_statuses.include?(current_status) && !current_user.has_role?(:client) %>
    <%= form_with url: add_status_project_ticket_path(@project, @ticket, local: true, data: { turbo: false }) do %>
      <% current_status = @ticket.statuses.first&.name %>
      <% transition_map = {
        'Approved' => ['Work in Progress'],
        'Work in Progress' => ['Declined', 'Resolved', 'On-Hold', 'Under Development', 'Client Confirmation Pending'],
        'On-Hold' => ['Under Development', 'Work in Progress'],
        'Under Development' => ['QA Testing', 'Awaiting Build', 'On-Hold'],
        'QA Testing' => ['Resolved', 'Client Confirmation Pending', 'Under Development'],
        'Client Confirmation Pending' => ['Resolved', 'Reopened', 'Work in Progress'],
        'Awaiting Build' => ['QA Testing'],
        'Reopened' => ['Work in Progress'],
        'Resolved' => ['Closed', 'Reopened'],
        'Closed' => ['Reopened'],
        'Declined' => ['Reopened']
      } %>

      <% if transition_map[current_status] %>
        <div class="flex flex-col gap-2">
          <%= select_tag :status_id, options_for_select(Status.where(name: transition_map[current_status]).pluck(:name, :id), @ticket.statuses.first.id), class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" %>
          <%= submit_tag "Update status", class: 'w-full rounded-lg bg-[#131D58] px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#1a2670] active:scale-[0.98]' %>
        </div>
      <% end %>
    <% end %>
  <% end %>

<% else %>
  <% if !current_user.has_role?(:observer) && (current_user.has_role?(:admin) || current_user.has_role?(:agent) || current_user.has_role?('project manager')) %>
    <%= form_with url: add_status_project_ticket_path(@project, @ticket, data: { turbo: false}), local: true do %>
      <% current_status = @ticket.statuses.first&.name %>
      <% transition_map = {
        'New' => ['Assigned', ""],
        'Assigned' => ['Work in Progress'],
        ['Assigned','Assigned'] => ['Work in Progress'],
        'Work in Progress' => ['Declined', 'Resolved', 'On-Hold', 'Under Development', 'Client Confirmation Pending'],
        'On-Hold' => ['Under Development', 'Work in Progress'],
        'Under Development' => ['QA Testing', 'Awaiting Build', 'On-Hold'],
        'QA Testing' => ['Resolved', 'Client Confirmation Pending', 'Under Development'],
        'Client Confirmation Pending' => ['Resolved', 'Reopened', 'Work in Progress'],
        'Awaiting Build' => ['QA Testing'],
        'Reopened' => ['Work in Progress'],
        'Resolved' => ['Closed', 'Reopened'],
        'Closed' => ['Reopened'],
        'Declined' => ['Reopened']
      } %>

      <div class="flex flex-col gap-2">
        <% if @ticket.statuses.empty? %>
          <%= select_tag :status_id, options_for_select(Status.where(name: ['Assigned']).pluck(:name, :id)), class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" %>
        <% elsif transition_map[current_status] %>
          <%= select_tag :status_id, options_for_select(Status.where(name: transition_map[current_status]).pluck(:name, :id), @ticket.statuses.first.id), class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" %>
        <% end %>
        <%= submit_tag "Update status", class: 'w-full rounded-lg bg-[#131D58] px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#1a2670] active:scale-[0.98]' %>
      </div>
    <% end %>
  <% elsif current_user.has_role?(:client) %>
    <%= form_with url: add_status_project_ticket_path(@project, @ticket, data: { turbo: false}), local: true do %>
      <% current_status = @ticket.statuses.first&.name %>
      <% allowed = ["Client Confirmation Pending", "Resolved", "Reopened",  "Closed",  "Declined"] %>
      <% if allowed.include?(current_status) %>
        <div class="flex flex-col gap-2">
          <%= select_tag :status_id, options_for_select(Status.where(name: %w[Closed Reopened]).pluck(:name, :id), @ticket.statuses.first.id), class: "block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" %>
          <%= submit_tag "Update status", class: 'w-full rounded-lg bg-[#131D58] px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#1a2670] active:scale-[0.98]' %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
