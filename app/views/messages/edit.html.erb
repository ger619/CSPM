<div class="min-h-screen bg-gray-50 px-3 py-4 sm:px-6 sm:py-6 lg:px-8">
  <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-sm border border-gray-100 p-5 sm:p-6">
    <h1 class="text-xl sm:text-2xl font-bold text-[#131D58] mb-6">Edit Message</h1>

    <%= form_with(model: [@task, @message], local: true) do |f| %>
      <div class="mb-5">
        <%= f.label :content, "Content", class: "block text-sm font-medium text-[#131D58] mb-2" %>
        <%= f.rich_text_area :content,
            class: "w-full min-h-[350px] rounded-lg border border-gray-300 p-2.5 bg-white focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67]",
            required: true %>
      </div>

      <div class="flex gap-3">
        <%= f.submit "Update Message",
            class: "px-4 py-2.5 bg-[#0D9C67] hover:bg-[#0B8659] text-white text-sm font-semibold rounded-lg transition-colors cursor-pointer" %>
        <%= link_to "Cancel",
            task_messages_path(@task),
            class: "px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-lg transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
