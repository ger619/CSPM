<% if flash[:notice] %>
  <div class="flex items-start gap-3 bg-[#E3F6EC] border border-[#0D9C67]/30 text-[#0B4A32] px-4 py-3 rounded-xl mb-4 shadow-sm">
    <svg class="w-5 h-5 flex-shrink-0 text-[#0D9C67] mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
    </svg>
    <p class="text-sm font-medium"><%= flash[:notice] %></p>
  </div>
<% elsif flash[:alert] %>
  <div class="flex items-start gap-3 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl mb-4 shadow-sm">
    <svg class="w-5 h-5 flex-shrink-0 text-red-600 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
    </svg>
    <p class="text-sm font-medium"><%= flash[:alert] %></p>
  </div>
<% end %>

<div class="flex items-center gap-2 mb-4">
  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#131D58]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
  </svg>
  <h2 class="text-lg font-bold text-[#131D58]">Messages</h2>
  <% if @task.messages.any? %>
    <span class="text-xs font-semibold bg-[#E8EAF3] text-[#131D58] rounded-full px-2 py-0.5"><%= @task.messages.count %></span>
  <% end %>
</div>

<% if @task.messages.any? %>
  <div class="space-y-3">
    <% @task.messages.order(created_at: :desc).each do |message| %>
      <div class="p-4 rounded-xl border border-gray-100 bg-white shadow-sm">
        <div class="flex justify-between items-start gap-3">
          <div class="flex items-center gap-3 min-w-0">
            <span class="w-9 h-9 flex-shrink-0 flex items-center justify-center rounded-full bg-[#131D58] text-white text-xs font-semibold uppercase">
              <%= message.user&.first_name&.first || "?" %>
            </span>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-gray-800 truncate">
                <%= message.user&.first_name || "Unknown User" %>
              </p>
              <div class="flex items-center gap-2 flex-wrap">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold <%= message.message_type == 'internal' ? 'bg-[#E8EAF3] text-[#131D58]' : 'bg-[#E3F6EC] text-[#0B4A32]' %>">
                  <%= message.message_type&.capitalize || "Unknown Visibility" %>
                </span>
                <p class="text-xs text-gray-400">
                  <%= message.created_at&.strftime("%d %b %Y, %H:%M") || "Unknown Date" %>
                </p>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-2 flex-shrink-0">
            <%= link_to edit_task_message_path(@task, message),
                        class: "p-1.5 rounded-lg hover:bg-[#F4F5FA] text-gray-400 hover:text-[#131D58] transition-colors" do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
              </svg>
            <% end %>

            <%= button_to task_message_path(@task, message),
                        method: :delete,
                        data: { confirm: 'Are you sure?' },
                        class: "p-1.5 rounded-lg hover:bg-red-50 text-gray-400 hover:text-red-600 transition-colors" do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
              </svg>
            <% end %>
          </div>
        </div>

        <div class="mt-3 pl-12 text-sm text-gray-700">
          <% if message.content.present? %>
            <div class="prose prose-sm max-w-none break-words overflow-hidden">
              <%= sanitize raw (message.content.to_trix_html.gsub(/\[.*?\]/, '').strip) %>
              <% if message.content.body.attachments.any? %>
                <% message.content.body.attachments.each do |attachment| %>
                  <div class="mb-2">
                    <% if attachment.attachable.is_a?(ActionText::Attachables::RemoteImage) %>
                      <a href="<%= attachment.attachable.url %>" download class="block">
                        <img src="<%= attachment.attachable.url %>" alt="Remote Image" class="max-w-xs rounded-lg border border-gray-100 cursor-pointer">
                      </a>
                      <br>
                      <% if attachment.attachable.is_a?(ActiveStorage::Blob) %>
                        <%= link_to attachment.attachable.filename.to_s, rails_blob_path(attachment.attachable, disposition: 'attachment', only_path: true), target: "_blank", download: true, class: "text-sm text-[#0D9C67] hover:text-[#0B8659] hover:underline" %>
                      <% end %>
                    <% elsif attachment.attachable.is_a?(ActiveStorage::Blob) %>
                      <% if attachment.attachable.variable? %>
                          <a href="<%= rails_blob_path(attachment.attachable, disposition: 'attachment', only_path: true) %>" download class="block">
                            <img src="<%= rails_representation_url(attachment.attachable.variant(resize_to_limit: [300, 300])) %>" alt="Attachment Preview" class="max-w-xs rounded-lg border border-gray-100 cursor-pointer">
                          </a>
                      <% elsif attachment.attachable.previewable? %>
                        <%= link_to 'Download previewable file', rails_blob_path(attachment.attachable, disposition: 'attachment', only_path: true), class: "text-sm text-[#0D9C67] hover:text-[#0B8659] hover:underline" %>
                      <% else %>
                        <%= link_to attachment.filename.to_s, rails_blob_path(attachment.attachable, disposition: 'attachment', only_path: true), class: "text-sm text-[#0D9C67] hover:text-[#0B8659] hover:underline" %>
                      <% end %>
                  <% else %>
                      <p class="text-sm text-gray-500">Attachment: <%= attachment.filename.to_s %></p>
                      <%= link_to attachment.filename.to_s, rails_blob_path(attachment.attachable, disposition: 'attachment', only_path: true), class: "text-sm text-[#0D9C67] hover:text-[#0B8659] hover:underline" %>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>

        <% if message.attachments.attached? %>
          <div class="mt-3 pl-12">
            <h4 class="text-xs font-semibold text-[#131D58] uppercase tracking-wide mb-1.5">Attachments</h4>
            <div class="flex flex-wrap gap-2">
              <% message.attachments.each do |attachment| %>
                <% if attachment.persisted? %>
                  <%= link_to rails_blob_path(attachment, disposition: "attachment"),
                      class: "inline-flex items-center gap-1.5 bg-[#F4F5FA] hover:bg-[#E8EAF3] text-[#131D58] text-xs font-medium px-2.5 py-1.5 rounded-lg transition-colors" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13" />
                    </svg>
                    <%= attachment.filename.to_s %>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="flex flex-col items-center justify-center text-center py-10 px-4 bg-[#F4F5FA] rounded-xl">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-gray-300 mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
    </svg>
    <p class="text-sm text-gray-500">No messages found.</p>
  </div>
<% end %>
