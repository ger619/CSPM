<% allowed_roles = ["external", :admin, :agent, :observer, "project manager"] %>
<div class="flex h-full flex-col" data-controller="messages">
  <!-- Messages Container -->
  <div class="flex-1 overflow-y-auto">
    <% if @ticket_items.present? %>
      <ol class="messages-list relative space-y-4" id="messages-list">
        <% @ticket_items.each do |item| %>
          <% if item.is_a?(Comment) || (item.is_a?(Issue) && (allowed_roles.include?(item.message_type) || allowed_roles.any? { |role| current_user.has_role?(role) })) %>
            <%= render 'issues/message', item: item %>
          <% end %>
        <% end %>
      </ol>
    <% else %>
      <div class="flex h-64 flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-slate-200 bg-slate-50 text-center dark:border-slate-700 dark:bg-slate-900/40">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#131D58]/10 text-[#131D58] dark:bg-[#131D58]/30 dark:text-[#8FA3E6]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-bold text-[#0A1024] dark:text-white">No messages yet</p>
          <p class="mt-0.5 text-xs font-medium text-slate-400">Start the conversation below</p>
        </div>
      </div>
    <% end %>
  </div>

  <% if @total_pages.present? && @total_pages > 1 %>
    <div class="mt-6 flex items-center justify-between border-t border-slate-100 pt-4 dark:border-slate-800">
      <% if @page > 1 %>
        <%= link_to project_ticket_path(@project, @ticket, ticket_items_page: @page - 1),
                    class: 'flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-bold text-[#131D58] transition hover:bg-[#131D58]/10 dark:text-[#8FA3E6]' do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Previous
        <% end %>
      <% else %>
        <span></span>
      <% end %>

      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-400">
        Page <%= @page %> of <%= @total_pages %>
      </span>

      <% if @page < @total_pages %>
        <%= link_to project_ticket_path(@project, @ticket, ticket_items_page: @page + 1),
                    class: 'flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-bold text-[#131D58] transition hover:bg-[#131D58]/10 dark:text-[#8FA3E6]' do %>
          Next
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        <% end %>
      <% else %>
        <span></span>
      <% end %>
    </div>
  <% end %>
</div>
