<div class="mb-6 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
  <div class="bg-gradient-to-r from-[#131D58] via-[#1a2670] to-[#0D9C66] px-4 py-5 text-white sm:px-6 lg:px-8">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex min-w-0 items-start gap-3 sm:gap-4">
        <button onclick="history.back()"
                class="group flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-2xl border border-white/30 bg-white/10 text-white shadow-lg shadow-black/10 backdrop-blur transition hover:-translate-y-0.5 hover:bg-white hover:text-[#131D58] focus:outline-none focus:ring-4 focus:ring-white/30"
                aria-label="Go back">
          <svg class="h-5 w-5 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
        </button>

        <div class="flex h-16 w-16 flex-shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-white/20 bg-white/10 shadow-lg backdrop-blur sm:h-20 sm:w-20">
          <% if @project.image.present? %>
            <%= image_tag(@project.image, class: "h-full w-full object-cover") %>
          <% else %>
            <%= image_tag "logo-mark.png", class: "h-12 w-12 object-contain sm:h-14 sm:w-14" %>
          <% end %>
        </div>

        <div class="min-w-0">
          <p class="text-xs font-bold uppercase tracking-[0.25em] text-white/60">
            <%= @project.title %>
          </p>
          <h1 class="mt-1 line-clamp-2 text-lg font-black tracking-tight text-white sm:text-2xl">
            <%= @ticket.issue %>
          </h1>
          <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-white/80 sm:text-sm">
            <span class="font-bold text-white"><%= @ticket.user.name %></span>
            <span class="text-white/40">·</span>
            <span class="font-bold uppercase tracking-wide text-white"><%= @ticket.unique_id %></span>
            <span class="text-white/40">·</span>
            <%= render partial: 'tickets/priority_severity', locals: { ticket: @ticket } %>
          </p>
        </div>
      </div>

      <!-- Search -->
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center lg:flex-shrink-0">
        <%= form_with url: project_ticket_path(@project, @ticket), method: :get, class: 'flex gap-2' do |f| %>
          <%= f.text_field :query, placeholder: "Search...", class: "h-11 w-full rounded-xl border-0 bg-white/10 px-4 text-sm font-medium text-white placeholder-white/60 shadow-inner backdrop-blur transition focus:bg-white focus:text-[#0A1024] focus:placeholder-slate-400 focus:outline-none focus:ring-4 focus:ring-white/30 sm:w-56" %>
          <button type="submit" class="flex h-11 flex-shrink-0 items-center justify-center rounded-xl bg-[#0D9C66] px-4 text-sm font-black text-white shadow-lg shadow-black/10 transition hover:-translate-y-0.5 hover:bg-[#0B8558] focus:outline-none focus:ring-4 focus:ring-white/30">
            Search
          </button>
        <% end %>
        <%= form_with url: project_ticket_path(@project, @ticket), method: :get do |f| %>
          <button type="submit" class="flex h-11 w-full items-center justify-center rounded-xl border border-white/30 bg-white/10 px-4 text-sm font-black text-white shadow-lg shadow-black/10 backdrop-blur transition hover:-translate-y-0.5 hover:bg-white hover:text-[#131D58] focus:outline-none focus:ring-4 focus:ring-white/30 sm:w-auto">
            Clear
          </button>
        <% end %>
      </div>
    </div>
  </div>
</div>
