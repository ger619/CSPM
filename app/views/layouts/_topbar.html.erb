<% if current_user && user_signed_in? %>
  <header class="mb-6 rounded-none border-b border-slate-200 bg-white px-4 py-4 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:rounded-3xl sm:border sm:px-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="min-w-0">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#3F8CFF]">
          Welcome back
        </p>
        <h1 class="mt-1 truncate text-lg font-bold capitalize text-[#0A1629] dark:text-white sm:text-2xl">
          <%= greeting_message %>, <%= current_user.first_name %> <%= current_user.last_name %>
        </h1>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Search projects, check alerts, and manage your account.
        </p>
      </div>

      <div class="flex flex-col gap-3 lg:min-w-[520px] xl:min-w-[620px]">
        <div class="flex items-center gap-3">
          <div class="relative flex-1">
            <%= form_with url: project_index_path, method: :get, class: "relative flex items-center" do |f| %>
              <%= f.text_field :query,
                               value: params[:query],
                               placeholder: "Search support desks...",
                               class: "h-12 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 pl-11 pr-20 text-sm font-medium text-slate-700 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-[#3F8CFF] focus:bg-white focus:ring-4 focus:ring-[#3F8CFF]/15 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:placeholder:text-slate-400",
                               id: "searchInput" %>

              <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 56.966 56.966" fill="currentColor">
                <path d="M55.146,51.887L41.588,37.786c3.486-4.144,5.396-9.358,5.396-14.786c0-12.682-10.318-23-23-23s-23,10.318-23,23 s10.318,23,23,23c4.761,0,9.298-1.436,13.177-4.162l13.661,14.208c0.571,0.593,1.339,0.92,2.162,0.92 c0.779,0,1.518-0.297,2.079-0.837C56.255,54.982,56.293,53.08,55.146,51.887z M23.984,6c9.374,0,17,7.626,17,17s-7.626,17-17,17 s-17-7.626-17-17S14.61,6,23.984,6z"/>
              </svg>

              <button type="button"
                      id="clearSearch"
                      class="absolute right-12 top-1/2 hidden h-7 w-7 -translate-y-1/2 items-center justify-center rounded-full text-lg font-bold text-slate-400 transition hover:bg-slate-200 hover:text-slate-700 dark:hover:bg-slate-700 dark:hover:text-white">
                &times;
              </button>

              <button type="submit"
                      class="absolute right-2 top-1/2 inline-flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-xl bg-[#3F8CFF] text-white shadow-sm transition hover:bg-[#3A81EB] focus:outline-none focus:ring-4 focus:ring-[#3F8CFF]/25"
                      aria-label="Search">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 56.966 56.966" fill="currentColor">
                  <path d="M55.146,51.887L41.588,37.786c3.486-4.144,5.396-9.358,5.396-14.786c0-12.682-10.318-23-23-23s-23,10.318-23,23 s10.318,23,23,23c4.761,0,9.298-1.436,13.177-4.162l13.661,14.208c0.571,0.593,1.339,0.92,2.162,0.92 c0.779,0,1.518-0.297,2.079-0.837C56.255,54.982,56.293,53.08,55.146,51.887z M23.984,6c9.374,0,17,7.626,17,17s-7.626,17-17,17 s-17-7.626-17-17S14.61,6,23.984,6z"/>
                </svg>
              </button>
            <% end %>
          </div>

          <div class="relative">
            <button id="dropdownNotificationButton"
                    class="relative inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-slate-200 bg-slate-50 text-[#0A1629] shadow-sm transition hover:border-[#3F8CFF] hover:bg-[#3F8CFF]/10 focus:outline-none focus:ring-4 focus:ring-[#3F8CFF]/15 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                    type="button"
                    aria-label="Notifications">
              <svg class="h-6 w-6 animate-wiggle" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 21 21">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                      d="M15.585 15.5H5.415A1.65 1.65 0 0 1 4 13a10.526 10.526 0 0 0 1.5-5.415V6.5a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v1.085c0 1.907.518 3.78 1.5 5.415a1.65 1.65 0 0 1-1.415 2.5zm1.915-11c-.267-.934-.6-1.6-1-2s-1.066-.733-2-1m-10.912 3c.209-.934.512-1.6.912-2s1.096-.733 2.088-1M13 17c-.667 1-1.5 1.5-2.5 1.5S8.667 18 8 17" />
              </svg>

              <% if @notifications&.any? { |notification| !notification.read } %>
                <span class="absolute right-3 top-3 h-3 w-3 rounded-full border-2 border-white bg-red-500 dark:border-slate-900"></span>
              <% end %>
            </button>

            <div id="dropdownNotification"
                 class="absolute right-0 z-50 mt-3 hidden w-[calc(100vw-2rem)] max-w-sm overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl shadow-slate-300/40 dark:border-slate-700 dark:bg-slate-900 sm:w-96">
              <%= link_to notifications_path, class: "block bg-gradient-to-r from-[#1a237e] via-[#2563eb] to-[#3F8CFF] px-5 py-4 text-white" do %>
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <p class="text-sm font-bold">Notifications</p>
                    <p class="text-xs text-blue-100">View all activity and alerts</p>
                  </div>
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14V10A6 6 0 006 10v4c0 .386-.149.76-.405 1.04L4 17h5m6 0a3 3 0 01-6 0"></path>
                  </svg>
                </div>
              <% end %>

              <div class="divide-y divide-slate-100 dark:divide-slate-800">
                <% if @notifications.present? && @notifications.any? %>
                  <div class="px-5 py-3 text-sm">
                    <span class="font-semibold text-[#3F8CFF]">You have new notifications</span>
                  </div>

                  <ul class="max-h-80 overflow-y-auto">
                    <% @notifications.each do |notification| %>
                      <li class="flex items-start justify-between gap-3 px-5 py-4 transition hover:bg-slate-50 dark:hover:bg-slate-800">
                        <div class="flex min-w-0 items-start gap-3">
                          <span class="mt-1 inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-2xl bg-[#3F8CFF]/10 text-[#3F8CFF]">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12.74A9 9 0 1112 3a9 9 0 019 9.74z"></path>
                            </svg>
                          </span>
                          <div class="min-w-0">
                            <p class="text-sm font-medium text-slate-700 dark:text-slate-200">
                              <%= notification.message %>
                            </p>
                            <p class="mt-1 text-xs text-slate-400">
                              <%= notification.created_at.strftime("%d %b %Y, %I:%M %p") %>
                            </p>
                          </div>
                        </div>

                        <% unless notification.read %>
                          <%= button_to "Read",
                                        mark_as_read_notification_path(notification),
                                        method: :patch,
                                        class: "rounded-full bg-[#3F8CFF]/10 px-3 py-1 text-xs font-bold text-[#3F8CFF] transition hover:bg-[#3F8CFF] hover:text-white" %>
                        <% else %>
                          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-400">Read</span>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% else %>
                  <div class="px-5 py-8 text-center text-slate-500 dark:text-slate-400">
                    <svg class="mx-auto h-12 w-12 text-slate-300 dark:text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12.74A9 9 0 1112 3a9 9 0 019 9.74z"></path>
                    </svg>
                    <p class="mt-3 text-sm font-semibold">No new notifications</p>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <div class="relative">
            <button id="dropdownProfile"
                    class="inline-flex h-12 items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-2 pr-3 shadow-sm transition hover:border-[#3F8CFF] hover:bg-[#3F8CFF]/10 focus:outline-none focus:ring-4 focus:ring-[#3F8CFF]/15 dark:border-slate-700 dark:bg-slate-800"
                    type="button">
              <% if current_user.profile_picture.attached? %>
                <%= image_tag current_user.profile_picture, class: "h-9 w-9 rounded-xl object-cover" %>
              <% elsif current_user.name_initials.present? %>
                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-[#1a237e] to-[#3F8CFF] text-sm font-bold text-white">
                  <%= current_user.name_initials %>
                </span>
              <% else %>
                <%= image_tag "logo-mark.png", class: "h-9 w-9 rounded-xl object-cover" %>
              <% end %>

              <span class="hidden text-left sm:block">
                <% unless current_user.roles.first && %w[editor creator].include?(current_user.roles.first.name.downcase) %>
                  <span class="block text-xs font-semibold uppercase tracking-wide text-slate-400">Role</span>
                  <span class="block max-w-[120px] truncate text-sm font-bold capitalize text-slate-700 dark:text-slate-100">
                    <%= current_user.roles.first&.name || "User" %>
                  </span>
                <% else %>
                  <span class="block max-w-[120px] truncate text-sm font-bold text-slate-700 dark:text-slate-100">
                    Account
                  </span>
                <% end %>
              </span>

              <svg class="h-3 w-3 text-slate-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
              </svg>
            </button>

            <ul id="dropdownItem"
                class="absolute right-0 z-50 mt-3 hidden w-48 overflow-hidden rounded-2xl border border-slate-200 bg-white py-2 shadow-2xl shadow-slate-300/40 dark:border-slate-700 dark:bg-slate-900">
              <li>
                <%= link_to edit_user_registration_path,
                            class: "flex items-center gap-3 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-[#3F8CFF]/10 hover:text-[#3F8CFF] dark:text-slate-200" do %>
                  Edit Profile
                <% end %>
              </li>
              <li>
                <%= button_to destroy_user_session_path,
                            method: :delete,
                            data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                            class: "flex w-full items-center gap-3 px-4 py-3 text-sm font-semibold text-red-600 transition hover:bg-red-50" do %>
                 Sign Out
                <% end %>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </header>
<% end %>

<script>
  document.addEventListener("turbo:load", () => {
    const searchInput = document.getElementById("searchInput");
    const clearSearch = document.getElementById("clearSearch");
    const notificationButton = document.getElementById("dropdownNotificationButton");
    const notificationDropdown = document.getElementById("dropdownNotification");
    const profileButton = document.getElementById("dropdownProfile");
    const profileDropdown = document.getElementById("dropdownItem");

    if (searchInput && clearSearch) {
      const toggleClearButton = () => {
        if (searchInput.value.trim().length > 0) {
          clearSearch.classList.remove("hidden");
          clearSearch.classList.add("inline-flex");
        } else {
          clearSearch.classList.add("hidden");
          clearSearch.classList.remove("inline-flex");
        }
      };

      toggleClearButton();

      searchInput.addEventListener("input", toggleClearButton);

      clearSearch.addEventListener("click", () => {
        searchInput.value = "";
        toggleClearButton();
        searchInput.focus();
      });
    }

    const closeDropdowns = (except = null) => {
      if (notificationDropdown && except !== "notification") {
        notificationDropdown.classList.add("hidden");
      }

      if (profileDropdown && except !== "profile") {
        profileDropdown.classList.add("hidden");
      }
    };

    if (notificationButton && notificationDropdown) {
      notificationButton.addEventListener("click", (event) => {
        event.stopPropagation();
        closeDropdowns("notification");
        notificationDropdown.classList.toggle("hidden");
      });
    }

    if (profileButton && profileDropdown) {
      profileButton.addEventListener("click", (event) => {
        event.stopPropagation();
        closeDropdowns("profile");
        profileDropdown.classList.toggle("hidden");
      });
    }

    document.addEventListener("click", () => {
      closeDropdowns();
    });

    [notificationDropdown, profileDropdown].forEach((dropdown) => {
      if (!dropdown) return;

      dropdown.addEventListener("click", (event) => {
        event.stopPropagation();
      });
    });
  });
</script>