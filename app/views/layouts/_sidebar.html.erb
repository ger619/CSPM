<% if current_user && user_signed_in? %>
  <div data-controller="sidebar" class="relative">
    <!-- =========================================================
         MOBILE MENU BUTTON
         ========================================================= -->
    <button
      type="button"
      data-action="click->sidebar#open"
      class="fixed left-4 top-4 z-40 flex h-11 w-11 items-center justify-center rounded-xl bg-[#131D58] text-white shadow-lg transition hover:bg-[#0D9C67] lg:hidden"
      aria-label="Open navigation"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- =========================================================
         MOBILE OVERLAY
         ========================================================= -->
    <div
      data-sidebar-target="overlay"
      data-action="click->sidebar#close"
      class="fixed inset-0 z-40 hidden bg-black/50 backdrop-blur-sm lg:hidden"
    ></div>

    <!-- =========================================================
         SIDEBAR
         ========================================================= -->
    <aside
      data-sidebar-target="sidebar"
      class="fixed inset-y-0 left-0 z-50 flex w-[280px] -translate-x-full flex-col border-r border-slate-200 bg-white shadow-2xl transition-all duration-300 ease-in-out dark:border-slate-800 dark:bg-[#0B1020] lg:translate-x-0 lg:shadow-none"
    >
      <!-- =======================================================
           BRAND HEADER
           ======================================================= -->
      <div class="flex h-[78px] shrink-0 items-center justify-between border-b border-slate-200 px-5 dark:border-slate-800">
        <%= link_to(
              current_user.has_role?(:ceo) ? cease_fire_report_path : root_path,
              class: "flex items-center"
            ) do %>
          <%= image_tag("logo.png", alt: "GreaterCare", class: "h-12 w-auto object-contain") %>
        <% end %>

        <!-- Desktop collapse -->
        <button
          type="button"
          data-action="click->sidebar#toggle"
          class="hidden h-9 w-9 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-[#131D58] dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-[#0D9C67] lg:flex"
          aria-label="Collapse sidebar"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <!-- Mobile close -->
        <button
          type="button"
          data-action="click->sidebar#close"
          class="flex h-9 w-9 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800 lg:hidden"
          aria-label="Close navigation"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- =======================================================
           USER CARD
           ======================================================= -->
      <div class="px-4 pt-4">
        <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/70">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#131D58] text-sm font-bold text-white">
            <%= current_user.email.to_s.first.upcase %>
          </div>

          <div class="min-w-0">
            <p class="truncate text-sm font-semibold text-slate-900 dark:text-white"><%= current_user.email %></p>
            <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
              <% if current_user.has_role?(:admin) %>
                Administrator
              <% elsif current_user.has_role?(:observer) %>
                Observer
              <% elsif current_user.has_role?(:agent) %>
                Agent
              <% elsif current_user.has_role?(:client) %>
                Client
              <% else %>
                User
              <% end %>
            </p>
          </div>
        </div>
      </div>

      <!-- =======================================================
           NAVIGATION
           ======================================================= -->
      <nav class="flex-1 overflow-y-auto px-3 py-5">
        <% unless current_user.has_role?(:ceo) %>
          <!-- ===================================================
               WORKSPACE
               =================================================== -->
          <div class="mb-7">
            <p class="mb-2 px-3 text-[10px] font-bold uppercase tracking-[0.15em] text-slate-400 dark:text-slate-500">Workspace</p>

            <div class="space-y-1">
              <!-- Dashboard -->
              <%= link_to(
                    root_path,
                    class: "group flex min-h-[44px] items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition #{current_page?(root_path) ? 'bg-[#131D58] text-white shadow-md shadow-[#131D58]/20' : 'text-slate-600 hover:bg-slate-100 hover:text-[#131D58] dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white'}"
                  ) do %>
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 10.5L12 3l9 7.5M5 9v10a1 1 0 001 1h3v-6h6v6h3a1 1 0 001-1V9" />
                  </svg>
                </span>
                <span>Dashboard</span>
              <% end %>

              <!-- Support Desk -->
              <%= link_to(
                    project_index_path,
                    class: "group flex min-h-[44px] items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition #{current_page?(project_index_path) ? 'bg-[#131D58] text-white shadow-md shadow-[#131D58]/20' : 'text-slate-600 hover:bg-slate-100 hover:text-[#131D58] dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white'}"
                  ) do %>
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 4h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 8h8M8 12h5M8 16h3" />
                  </svg>
                </span>
                <span class="flex-1">Support Desk</span>
                <span class="rounded-full bg-[#0D9C67]/10 px-2 py-0.5 text-[11px] font-bold text-[#0D9C67]">
                  <% if current_user.projects.exists? %>
                    <%= current_user.projects.count %>
                  <% elsif current_user.has_role?(:admin) %>
                    <%= Project.count %>
                  <% else %>
                    0
                  <% end %>
                </span>
              <% end %>

              <!-- Project -->
              <% unless current_user.has_role?(:client) %>
                <%= link_to(
                      product_index_path,
                      class: "group flex min-h-[44px] items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition #{current_page?(product_index_path) ? 'bg-[#131D58] text-white shadow-md shadow-[#131D58]/20' : 'text-slate-600 hover:bg-slate-100 hover:text-[#131D58] dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white'}"
                    ) do %>
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M4 12h10M4 17h16" />
                    </svg>
                  </span>
                  <span class="flex-1">Projects</span>
                <% end %>

                <!-- Quality Assurance -->
                <%= link_to(
                      defect_index_path,
                      class: "group flex min-h-[44px] items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition #{current_page?(defect_index_path) ? 'bg-[#131D58] text-white shadow-md shadow-[#131D58]/20' : 'text-slate-600 hover:bg-slate-100 hover:text-[#131D58] dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white'}"
                    ) do %>
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3l8 4v5c0 4.5-3.4 7.8-8 9-4.6-1.2-8-4.5-8-9V7l8-4z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4" />
                    </svg>
                  </span>
                  <span class="flex-1">Quality Assurance</span>
                  <span class="rounded-full bg-[#0D9C67]/10 px-2 py-0.5 text-[11px] font-bold text-[#0D9C67]">
                    <% if current_user.defects.exists? %>
                      <%= current_user.defects.count %>
                    <% elsif current_user.has_role?(:admin) %>
                      <%= Defect.count %>
                    <% else %>
                      0
                    <% end %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>

          <!-- ===================================================
               MANAGEMENT
               =================================================== -->
          <% if current_user.has_role?(:admin) || current_user.has_role?(:observer) %>
            <div class="mb-7">
              <p class="mb-2 px-3 text-[10px] font-bold uppercase tracking-[0.15em] text-slate-400 dark:text-slate-500">Management</p>
              <div class="space-y-1">
                <%= link_to(software_index_path, class: "group flex min-h-[44px] items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition #{current_page?(software_index_path) ? 'bg-[#131D58] text-white shadow-md shadow-[#131D58]/20' : 'text-slate-600 hover:bg-slate-100 hover:text-[#131D58] dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white'}") do %>
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 7h14M5 12h14M5 17h9" />
                    </svg>
                  </span>
                  <span class="flex-1">CS Products</span>
                  <span class="rounded-full bg-[#0D9C67]/10 px-2 py-0.5 text-[11px] font-bold text-[#0D9C67]"><%= Software.count %></span>
                <% end %>

                <%= link_to(client_index_path, class: "group flex min-h-[44px] items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition #{current_page?(client_index_path) ? 'bg-[#131D58] text-white shadow-md shadow-[#131D58]/20' : 'text-slate-600 hover:bg-slate-100 hover:text-[#131D58] dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white'}") do %>
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM22 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" />
                    </svg>
                  </span>
                  <span class="flex-1">Clients</span>
                  <span class="rounded-full bg-[#0D9C67]/10 px-2 py-0.5 text-[11px] font-bold text-[#0D9C67]"><%= Client.count %></span>
                <% end %>

                <%= link_to(status_index_path, class: "group flex min-h-[44px] items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition #{current_page?(status_index_path) ? 'bg-[#131D58] text-white shadow-md shadow-[#131D58]/20' : 'text-slate-600 hover:bg-slate-100 hover:text-[#131D58] dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white'}") do %>
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 19V5h10v14M14 9h6v10h-6" />
                    </svg>
                  </span>
                  <span class="flex-1">Status</span>
                  <span class="rounded-full bg-[#0D9C67]/10 px-2 py-0.5 text-[11px] font-bold text-[#0D9C67]"><%= Status.count %></span>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- ===================================================
               PEOPLE
               =================================================== -->
          <% if current_user.has_role?(:admin) || current_user.has_role?('project manager') || current_user.has_role?(:observer) %>
            <div class="mb-7">
              <p class="mb-2 px-3 text-[10px] font-bold uppercase tracking-[0.15em] text-slate-400 dark:text-slate-500">People</p>
              <div class="space-y-1">
                <%= link_to(team_index_path, class: "group flex min-h-[44px] items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition #{current_page?(team_index_path) ? 'bg-[#131D58] text-white shadow-md shadow-[#131D58]/20' : 'text-slate-600 hover:bg-slate-100 hover:text-[#131D58] dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white'}") do %>
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2M10 10a4 4 0 100-8 4 4 0 000 8zM21 20v-2a4 4 0 00-3-3.87M17 3.13a4 4 0 010 7.75" />
                    </svg>
                  </span>
                  <span class="flex-1">Teams</span>
                  <span class="rounded-full bg-[#0D9C67]/10 px-2 py-0.5 text-[11px] font-bold text-[#0D9C67]"><%= Team.count %></span>
                <% end %>

                <%= link_to(users_path, class: "group flex min-h-[44px] items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition #{current_page?(users_path) ? 'bg-[#131D58] text-white shadow-md shadow-[#131D58]/20' : 'text-slate-600 hover:bg-slate-100 hover:text-[#131D58] dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white'}") do %>
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8z" />
                    </svg>
                  </span>
                  <span class="flex-1">Users</span>
                  <span class="rounded-full bg-[#0D9C67]/10 px-2 py-0.5 text-[11px] font-bold text-[#0D9C67]"><%= User.where(active: true).count %></span>
                <% end %>

                <% if current_user.has_role?(:admin) || current_user.has_role?(:observer) %>
                  <%= link_to(
                        new_user_invitation_path,
                        class: "group flex min-h-[44px] items-center gap-3 rounded-xl border border-[#0D9C67]/20 bg-[#0D9C67]/5 px-3 py-2.5 text-sm font-medium text-[#0D9C67] transition hover:bg-[#0D9C67]/10"
                      ) do %>
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg">
                      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 5v14M5 12h14" />
                      </svg>
                    </span>
                    <span>Add New User</span>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- ===================================================
               REPORTING / DATA CENTER
               =================================================== -->
          <div class="mb-7">
            <p class="mb-2 px-3 text-[10px] font-bold uppercase tracking-[0.15em] text-slate-400 dark:text-slate-500">Reporting</p>

            <button
              type="button"
              data-action="click->sidebar#toggleReports"
              class="flex min-h-[44px] w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-[#131D58] dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white"
            >
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 19V5m0 14h16M8 16v-5m4 5V7m4 9v-8" />
                </svg>
              </span>

              <span class="flex-1 text-left">Data Center</span>

              <svg data-sidebar-target="reportChevron" class="h-4 w-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6" />
              </svg>
            </button>

            <div data-sidebar-target="reports" class="hidden space-y-1 pl-4 pt-1">
              <%= link_to(cease_fire_report_path, class: "flex rounded-lg px-3 py-2 text-xs font-medium text-slate-500 transition hover:bg-slate-100 hover:text-[#0D9C67] dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-[#0D9C67]") do %>
                Tickets Status
              <% end %>

              <% if current_user.has_role?(:admin) || current_user.has_role?(:observer) || current_user.has_role?('project manager') %>
                <%= link_to user_report_path, class: "flex rounded-lg px-3 py-2 text-xs font-medium text-slate-500 transition hover:bg-slate-100 hover:text-[#0D9C67] dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-[#0D9C67]" do %>
                  User Report
                <% end %>

                <%= link_to project_report_path, class: "flex rounded-lg px-3 py-2 text-xs font-medium text-slate-500 transition hover:bg-slate-100 hover:text-[#0D9C67] dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-[#0D9C67]" do %>
                  Workload Report
                <% end %>

                <%= link_to daily_summary_report_path, class: "flex rounded-lg px-3 py-2 text-xs font-medium text-slate-500 transition hover:bg-slate-100 hover:text-[#0D9C67] dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-[#0D9C67]" do %>
                  Daily Report
                <% end %>

                <%= link_to dashboard_path, class: "flex rounded-lg px-3 py-2 text-xs font-medium text-slate-500 transition hover:bg-slate-100 hover:text-[#0D9C67] dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-[#0D9C67]" do %>
                  SLA Report
                <% end %>
              <% end %>

              <% if current_user.has_role?(:agent) || current_user.has_role?(:admin) || current_user.has_role?(:observer) || current_user.has_role?('project manager') %>
                <%= link_to breach_report_path, class: "flex rounded-lg px-3 py-2 text-xs font-medium text-slate-500 transition hover:bg-slate-100 hover:text-[#0D9C67] dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-[#0D9C67]" do %>
                  Breach Report
                <% end %>

                <%= link_to orm_report_path, class: "flex rounded-lg px-3 py-2 text-xs font-medium text-slate-500 transition hover:bg-slate-100 hover:text-[#0D9C67] dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-[#0D9C67]" do %>
                  ORM Report
                <% end %>

                <%= link_to orm_team_report_path, class: "flex rounded-lg px-3 py-2 text-xs font-medium text-slate-500 transition hover:bg-slate-100 hover:text-[#0D9C67] dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-[#0D9C67]" do %>
                  ORM Team Report
                <% end %>

                <%= link_to sod_report_path, class: "flex rounded-lg px-3 py-2 text-xs font-medium text-slate-500 transition hover:bg-slate-100 hover:text-[#0D9C67] dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-[#0D9C67]" do %>
                  Start/End of Day Report
                <% end %>

                <%= link_to cbk_groupware_report_path, class: "flex rounded-lg px-3 py-2 text-xs font-medium text-slate-500 transition hover:bg-slate-100 hover:text-[#0D9C67] dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-[#0D9C67]" do %>
                  CBK Report
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </nav>

      <!-- =======================================================
           FOOTER
           ======================================================= -->
      <div class="shrink-0 border-t border-slate-200 p-4 dark:border-slate-800">
        <div class="flex items-center gap-2 rounded-lg bg-[#0D9C67]/5 px-3 py-2">
          <span class="h-2 w-2 rounded-full bg-[#0D9C67] shadow-sm shadow-[#0D9C67]/50"></span>
          <span class="text-xs font-medium text-[#0D9C67]">System operational</span>
        </div>
      </div>
    </aside>
  </div>
<% end %>