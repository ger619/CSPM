<% provide(:title, "Tickets Status") %>

<div class="min-h-screen bg-slate-50 px-4 py-6 dark:bg-slate-950 sm:px-6 lg:px-8">
  <div>

    <div class="mb-6 flex flex-col items-center gap-4 sm:flex-row sm:items-start sm:justify-between">
      <!-- Title and Subtext -->
      <div class="flex flex-1 flex-col items-center text-center sm:items-start sm:text-left">
        <h1 class="text-xl font-black text-[#0A1024] dark:text-white sm:text-2xl">
          <% if current_user.has_role?(:admin) || current_user.has_role?('project manager') %>
            Cease Fire Report
          <% else %>
            Status Report
          <% end %>
        </h1>
        <span class="mt-1 text-xs font-semibold text-red-600 dark:text-red-400">
          (Leave the date field blank if you want all the data from inception to date*)
        </span>
        <div id="flash-container" class="w-full"></div>
      </div>

      <!-- Manage Button (admin only) -->
      <% if current_user.has_role?(:admin) %>
        <%= link_to commonly_selected_clients_path, data: { turbo_frame: "modal" },
                    class: "flex flex-shrink-0 items-center gap-2 rounded-lg border-2 border-[#131D58] bg-white px-4 py-2 font-bold text-[#131D58] transition-colors duration-200 hover:bg-[#131D58] hover:text-white dark:bg-slate-900" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
          </svg>
          <span>Manage Common Clients</span>
        <% end %>
      <% end %>
    </div>

    <!-- Filter Form -->
    <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-6">
      <%= form_with url: cease_fire_report_path, method: :get, local: true do |f| %>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-7">

          <!-- Status dropdown -->
          <div class="relative flex flex-col gap-1.5">
            <label for="searchStatus" class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Status</label>
            <input type="text" id="searchStatus"
                   class="w-full rounded-lg border-2 border-[#131D58]/30 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition placeholder-slate-400 hover:border-[#131D58] focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:bg-slate-800 dark:text-slate-100 dark:placeholder-slate-500"
                   placeholder="Search status...">

            <div id="statusDropdown" class="absolute top-full z-10 mt-1 hidden max-h-60 w-full overflow-y-auto rounded-lg border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-800">
              <% ['New', 'Resolved', 'Closed', 'Reopened', 'Under Development', 'QA Testing', 'Awaiting Build', 'Client Confirmation Pending', 'On-Hold', 'Assigned', 'Declined', 'Work in Progress'].each do |status| %>
                <div class="dropdown-item cursor-pointer px-3 py-2 text-sm font-medium text-slate-700 hover:bg-[#131D58]/10 dark:text-slate-100">
                  <label class="flex cursor-pointer items-center gap-2">
                    <input type="checkbox" value="<%= status %>" data-status-name="<%= status %>" class="status-checkbox h-4 w-4 rounded border-slate-300 text-[#131D58] focus:ring-[#131D58]">
                    <%= status %>
                  </label>
                </div>
              <% end %>
            </div>

            <div id="selectedStatusesWrapper"></div>
          </div>

          <!-- Clients dropdown -->
          <% if !current_user.has_role?(:ceo) %>
            <div class="relative flex flex-col gap-1.5">
              <label for="searchClient" class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Client</label>
              <input type="text" id="searchClient"
                     class="w-full rounded-lg border-2 border-[#131D58]/30 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition placeholder-slate-400 hover:border-[#131D58] focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:bg-slate-800 dark:text-slate-100 dark:placeholder-slate-500"
                     placeholder="Search client...">

              <div id="clientDropdown" class="absolute top-full z-10 mt-1 hidden max-h-60 w-full overflow-y-auto rounded-lg border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-800">
                <div class="dropdown-item cursor-pointer px-3 py-2 text-sm font-medium text-slate-700 hover:bg-[#131D58]/10 dark:text-slate-100">
                  <label class="flex cursor-pointer items-center gap-2">
                    <input type="checkbox" value="" data-client-name="All Clients" class="client-checkbox h-4 w-4 rounded border-slate-300 text-[#131D58] focus:ring-[#131D58]">
                    All Clients
                  </label>
                </div>
                <% (current_user.has_role?(:admin) || current_user.has_role?(:observer) ? Client.all : Client.joins(:projects).where(projects: { id: current_user.projects.pluck(:id) }).distinct).each do |client| %>
                  <div class="dropdown-item cursor-pointer px-3 py-2 text-sm font-medium text-slate-700 hover:bg-[#131D58]/10 dark:text-slate-100">
                    <label class="flex cursor-pointer items-center gap-2">
                      <input type="checkbox" value="<%= client.id %>" data-client-name="<%= client.name %>" class="client-checkbox h-4 w-4 rounded border-slate-300 text-[#131D58] focus:ring-[#131D58] capitalize">
                      <%= client.name %>
                    </label>
                  </div>
                <% end %>
              </div>

              <div id="selectedClientsWrapper"></div>
            </div>
          <% end %>

          <!-- Date range -->
          <div class="flex flex-col gap-1.5">
            <%= f.label :start_date, "Start date", class: "text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
            <%= f.date_field :start_date, value: params[:start_date], class: "w-full rounded-lg border-2 border-[#131D58]/30 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:border-[#131D58] focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:bg-slate-800 dark:text-slate-100" %>
          </div>

          <div class="flex flex-col gap-1.5">
            <%= f.label :end_date, "End date", class: "text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
            <%= f.date_field :end_date, value: params[:end_date], class: "w-full rounded-lg border-2 border-[#131D58]/30 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:border-[#131D58] focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:bg-slate-800 dark:text-slate-100" %>
          </div>

          <div class="flex flex-col gap-1.5">
            <%= f.label :priority, "Severity", class: "text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" %>
            <%= f.select :priority,
                         options_for_select(['SEVERITY 1', 'SEVERITY 2', 'SEVERITY 3', 'SEVERITY 4'], params[:priority]),
                         { include_blank: 'All Severities' },
                         prompt: 'Select priority',
                         class: "w-full rounded-lg border-2 border-[#131D58]/30 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:border-[#131D58] focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:bg-slate-800 dark:text-slate-100" %>
          </div>

          <div class="flex flex-col gap-1.5 mt-5">
            <% if current_user.has_role? :admin %>
              <button type="button" id="precheckCommonClientsBtn" class="rounded-lg border-2 border-green-500 p-2.5 text-sm font-bold text-green-600 transition duration-200 hover:bg-green-600 hover:text-white">
                Preselect Clients
              </button>
            <% end %>
          </div>
          <div class="flex flex-col gap-1.5 mt-5">
            <%= f.submit "Generate Report", class: 'w-full rounded-lg bg-[#0D9C66] p-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#0B8558] hover:shadow active:scale-[0.98] sm:w-auto' %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-6">
      <%= render 'data_center/ticket_cease' %>
    </div>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", () => {
    // Common function to update selections
    function updateSelections(inputId, wrapperId, checkboxClass, inputName, dataAttr) {
      const searchInput = document.getElementById(inputId);
      const selectedWrapper = document.getElementById(wrapperId);
      let selectedNames = [];
      selectedWrapper.innerHTML = ""; // Clear previous hidden fields

      document.querySelectorAll(`.${checkboxClass}:checked`).forEach((checkbox) => {
        const name = checkbox.dataset[dataAttr];
        const value = checkbox.value;

        if (name) selectedNames.push(name);
        if (value) {
          const input = document.createElement("input");
          input.type = "hidden";
          input.name = inputName;
          input.value = value;
          selectedWrapper.appendChild(input);
        }
      });

      searchInput.value = selectedNames.join(", ");
    }

    // Common function to handle dropdown visibility and filtering
    function setupDropdown(inputId, dropdownId, checkboxClass, wrapperId, inputName, dataAttr) {
      const searchInput = document.getElementById(inputId);
      const dropdown = document.getElementById(dropdownId);

      // Show dropdown on click
      searchInput.addEventListener("click", () => {
        dropdown.classList.remove("hidden");
      });

      // Filter dropdown based on search input
      searchInput.addEventListener("keyup", () => {
        const searchValue = searchInput.value.toLowerCase();
        const items = dropdown.querySelectorAll(".dropdown-item");

        items.forEach((item) => {
          const label = item.textContent.toLowerCase();
          item.style.display = label.includes(searchValue) ? "block" : "none";
        });
      });

      // Apply selection logic to all checkboxes
      document.querySelectorAll(`.${checkboxClass}`).forEach((cb) => {
        cb.addEventListener("change", () => {
          updateSelections(inputId, wrapperId, checkboxClass, inputName, dataAttr);
        });
      });

      // Hide dropdown when clicking outside
      document.addEventListener("click", function (event) {
        if (!dropdown.contains(event.target) && !searchInput.contains(event.target)) {
          dropdown.classList.add("hidden");
        }
      });
    }

    let commonClientsPreselected = false;
    let originalDropdownOrder = null; // Store the original dropdown order

    document.getElementById("precheckCommonClientsBtn").addEventListener("click", async () => {
      const button = document.getElementById("precheckCommonClientsBtn");
      const clientDropdown = document.getElementById("clientDropdown");
      const searchInput = document.getElementById("searchClient");

      try {
        const response = await fetch("/commonly_selected_clients/ids");
        const data = await response.json();
        const commonIds = data.client_ids.map(id => id.toString());
        const commonClientNames = data.client_names;

        if (commonIds.length === 0) {
          showFlashNotice("No commonly selected clients found. Please click 'Manage common clients' to add them first.");
          return;
        }

        // Store original dropdown order on first click if not already stored
        if (!originalDropdownOrder) {
          originalDropdownOrder = clientDropdown.innerHTML;
        }

        if (!commonClientsPreselected) {
          // When selecting common clients (original behavior)
          const dropdownItems = Array.from(clientDropdown.querySelectorAll(".dropdown-item"));
          const commonClientItems = dropdownItems.filter(item => {
            return commonIds.includes(item.querySelector(".client-checkbox").value);
          });
          const otherClientItems = dropdownItems.filter(item => {
            return !commonIds.includes(item.querySelector(".client-checkbox").value);
          });

          clientDropdown.innerHTML = '';

          // Add common clients first with a separator
          if (commonClientItems.length > 0) {
            const header = document.createElement("div");
            header.className = "px-4 py-2 font-semibold text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700";
            header.textContent = "Common Clients";
            clientDropdown.appendChild(header);

            commonClientItems.forEach(item => {
              item.classList.add("common-client");
              clientDropdown.appendChild(item);
            });

            const separator = document.createElement("div");
            separator.className = "border-t border-gray-200 dark:border-gray-600 my-1";
            clientDropdown.appendChild(separator);
          }

          // Add other clients
          otherClientItems.forEach(item => clientDropdown.appendChild(item));

          // Check common client checkboxes
          document.querySelectorAll(".client-checkbox").forEach((checkbox) => {
            if (commonIds.includes(checkbox.value)) {
              checkbox.checked = true;
            }
          });

          searchInput.value = commonClientNames.map(c => c[0]).join(", ");
        } else {
          // When deselecting - restore original order
          clientDropdown.innerHTML = originalDropdownOrder;

          // Uncheck all checkboxes
          document.querySelectorAll(".client-checkbox").forEach((checkbox) => {
            checkbox.checked = false;
          });

          searchInput.value = "";
        }

        updateSelections("searchClient", "selectedClientsWrapper", "client-checkbox", "client_ids[]", "clientName");
        clientDropdown.classList.remove("hidden");

        // Toggle state and button appearance
        commonClientsPreselected = !commonClientsPreselected;
        if (commonClientsPreselected) {
          button.textContent = "Deselect Common Clients";
          button.classList.remove("border-green-500", "text-green-600", "hover:bg-green-600");
          button.classList.add("border-red-500", "text-red-600", "hover:bg-red-600");
        } else {
          button.textContent = "Preselect Common Clients";
          button.classList.remove("border-red-500", "text-red-600", "hover:bg-red-600");
          button.classList.add("border-green-500", "text-green-600", "hover:bg-green-600");
        }
      } catch (err) {
        console.error("Failed to load common clients:", err);
        alert("Failed to load common clients.");
      }
    });

    // Helper function to display flash-like notice
    function showFlashNotice(message) {
      const flashDiv = document.createElement("div");
      flashDiv.className = "flash-notice bg-yellow-100 border border-yellow-400 text-yellow-800 px-4 py-2 rounded mt-4";
      flashDiv.textContent = message;

      const target = document.getElementById("flash-container") || document.body;
      target.prepend(flashDiv);

      setTimeout(() => {
        flashDiv.remove();
      }, 5000);
    }

    // Setup for "Status" dropdown
    setupDropdown(
      "searchStatus",
      "statusDropdown",
      "status-checkbox",
      "selectedStatusesWrapper",
      "status[]",
      "statusName"
    );

    // Setup for "Client" dropdown
    setupDropdown(
      "searchClient",
      "clientDropdown",
      "client-checkbox",
      "selectedClientsWrapper",
      "client_ids[]",
      "clientName"
    );
  });
</script>
