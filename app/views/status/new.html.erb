<% provide(:title, "New Status") %>

<div class="min-h-screen bg-gray-50 px-3 py-4 sm:px-6 sm:py-6 lg:px-8">
  <div class="max-w-lg mx-auto bg-white rounded-xl shadow-sm border border-gray-100 p-5 sm:p-6">
    <h1 class="text-xl sm:text-2xl font-bold text-[#131D58] mb-6">New Status</h1>

    <%= form_with model: @status, url: status_index_url, method: :post, data: { turbo: false }, local: true do |f| %>
      <div class="bg-[#F4F5FA] p-4 rounded-xl mb-5">
        <%= f.label :name, 'Name*', class: "capitalize block mb-2 text-sm font-medium text-[#131D58]" %>
        <%= f.text_field :name, class: "border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0D9C67] focus:border-[#0D9C67] block w-full p-2.5 text-sm bg-white", placeholder: 'e.g. In Progress', required: true %>
      </div>

      <div class="flex justify-end">
        <%= f.submit 'Create Status', class: 'bg-[#0D9C67] hover:bg-[#0B8659] text-white px-5 py-2.5 rounded-lg font-semibold text-sm transition-colors cursor-pointer' %>
      </div>
    <% end %>
  </div>
</div>
