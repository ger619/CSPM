<div class="mb-6 flex flex-col gap-3 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-6 lg:flex-row lg:items-center lg:justify-between">
  <div class="flex flex-wrap items-center gap-2">
    <%= button_to root_path, method: :get, class: 'group inline-flex items-center gap-1.5 rounded-lg border border-[#131D58]/20 bg-white px-4 py-2.5 text-sm font-bold text-[#131D58] shadow-sm transition hover:border-[#131D58] hover:bg-[#131D58]/5 dark:border-slate-700 dark:bg-slate-900 dark:text-[#8FA3E6]' do %>
      <svg class="h-4 w-4 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
      </svg>
      Back
    <% end %>

    <% if current_user.has_role?(:admin) %>
      <%= button_to 'Add new user', new_user_invitation_path, method: :get, class: 'rounded-lg bg-[#0D9C66] px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#0B8558] hover:shadow active:scale-[0.98]' %>
      <%= button_to 'Add location', new_location_path, method: :get, class: 'rounded-lg bg-[#131D58] px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#1a2670] active:scale-[0.98]' %>
    <% end %>
  </div>

  <!-- Search -->
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
    <%= form_with url: users_path(@users), method: :get, class: 'flex gap-2' do |f| %>
      <%= f.text_field :query, placeholder: "Search users...", class: "h-11 w-full rounded-lg border border-slate-200 bg-white px-4 text-sm font-medium text-slate-700 shadow-sm transition placeholder-slate-400 focus:border-[#131D58] focus:outline-none focus:ring-2 focus:ring-[#131D58]/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:placeholder-slate-500 sm:w-64" %>
      <button type="submit" class="h-11 flex-shrink-0 rounded-lg bg-[#131D58] px-4 text-sm font-bold text-white shadow-sm transition hover:bg-[#1a2670] active:scale-[0.98]">Search</button>
    <% end %>
    <%= form_with url: users_path(@users), method: :get do |f| %>
      <button type="submit" class="h-11 w-full flex-shrink-0 rounded-lg border border-slate-200 bg-white px-4 text-sm font-bold text-slate-600 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 sm:w-auto">Clear</button>
    <% end %>
  </div>
</div>
