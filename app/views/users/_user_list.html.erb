<!-- Mobile cards -->
<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:hidden">
  <% @users.each do |user| %>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <% if (can?(:manage, user) || (can?(:read, user) && !user.has_role?(:admin))) && user != current_user %>
            <%= link_to user.name, edit_user_path(user), class: "truncate text-sm font-black capitalize text-[#131D58] hover:underline dark:text-[#8FA3E6]" %>
          <% else %>
            <p class="truncate text-sm font-black capitalize text-[#0A1024] dark:text-white"><%= user.name %></p>
          <% end %>
          <p class="truncate text-xs font-medium text-slate-500 dark:text-slate-400"><%= user.email %></p>
        </div>

        <% if (can?(:manage, user) || (can?(:read, user) && !user.has_role?(:admin))) && user != current_user %>
          <%= form_with url: status_user_path(user), method: :patch, local: true, remote: true do |form| %>
            <label class="relative inline-block h-7 w-12 flex-shrink-0 cursor-pointer">
              <%= form.check_box :active, checked: user.active, class: "peer sr-only", data: { confirm: 'Are you sure?' }, onchange: 'this.form.submit()' %>
              <span class="absolute inset-0 rounded-full bg-slate-300 transition duration-300 peer-checked:bg-[#0D9C66] dark:bg-slate-600"></span>
              <span class="absolute left-1 top-1 h-5 w-5 rounded-full bg-white shadow transition duration-300 peer-checked:translate-x-5"></span>
            </label>
          <% end %>
        <% end %>
      </div>

      <div class="mt-3 flex flex-wrap gap-1.5">
        <% user.roles.distinct.pluck(:name).each do |role| %>
          <span class="rounded-full bg-[#131D58]/10 px-2.5 py-1 text-xs font-bold capitalize text-[#131D58] dark:bg-[#131D58]/30 dark:text-[#8FA3E6]"><%= role %></span>
        <% end %>
      </div>

      <div class="mt-3 grid grid-cols-2 gap-2 border-t border-slate-100 pt-3 text-xs dark:border-slate-800">
        <div>
          <p class="font-bold uppercase tracking-wide text-slate-400">Client</p>
          <p class="mt-0.5 truncate font-semibold text-slate-700 dark:text-slate-200"><%= user.client&.name || 'No client assigned' %></p>
        </div>
        <div>
          <p class="font-bold uppercase tracking-wide text-slate-400">Created</p>
          <p class="mt-0.5 font-semibold text-slate-700 dark:text-slate-200"><%= user.created_at.strftime("%d %b %Y") %></p>
        </div>
      </div>

      <% if (can?(:manage, user) || (can?(:read, user) && !user.has_role?(:admin))) && user != current_user %>
        <%= link_to 'Edit roles', edit_user_path(user), class: "mt-3 block w-full rounded-lg bg-[#131D58] py-2 text-center text-xs font-bold uppercase text-white shadow-sm transition hover:bg-[#1a2670]" %>
      <% end %>
    </div>
  <% end %>
</div>

<!-- Desktop table -->
<div class="hidden overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900 lg:block">
  <div class="overflow-x-auto">
    <table class="w-full min-w-[900px] text-left text-sm text-slate-700 dark:text-slate-300">
      <thead class="bg-gradient-to-r from-[#131D58] via-[#1a2670] to-[#0D9C66] text-xs uppercase tracking-wide text-white">
      <tr>
        <th class="px-4 py-3 font-bold">Name</th>
        <th class="px-4 py-3 font-bold">Email</th>
        <th class="px-4 py-3 font-bold">Roles</th>
        <th class="px-4 py-3 font-bold">Date Created</th>
        <th class="px-4 py-3 font-bold">Client Name</th>
        <th class="px-4 py-3 text-center font-bold">Active</th>
        <th class="px-4 py-3 text-right font-bold">Edit Role</th>
      </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
      <% @users.each do |user| %>
        <tr class="bg-white transition hover:bg-[#131D58]/[0.03] dark:bg-slate-900 dark:hover:bg-slate-800">
          <td class="whitespace-nowrap px-4 py-3 font-bold capitalize">
            <% if (can?(:manage, user) || (can?(:read, user) && !user.has_role?(:admin))) && user != current_user %>
              <%= link_to user.name, edit_user_path(user), class: "text-[#131D58] hover:underline dark:text-[#8FA3E6]" %>
            <% else %>
              <span class="text-[#0A1024] dark:text-white"><%= user.name %></span>
            <% end %>
          </td>

          <td class="whitespace-nowrap px-4 py-3"><%= user.email %></td>

          <td class="px-4 py-3">
            <div class="flex flex-wrap gap-1.5">
              <% user.roles.distinct.pluck(:name).each do |role| %>
                <span class="rounded-full bg-[#131D58]/10 px-2.5 py-1 text-xs font-bold capitalize text-[#131D58] dark:bg-[#131D58]/30 dark:text-[#8FA3E6]"><%= role %></span>
              <% end %>
            </div>
          </td>

          <td class="whitespace-nowrap px-4 py-3 text-slate-500 dark:text-slate-400"><%= user.created_at.strftime("%d %b %Y") %></td>

          <td class="whitespace-nowrap px-4 py-3"><%= user.client&.name || 'No client assigned' %></td>

          <td class="px-4 py-3">
            <% if (can?(:manage, user) || (can?(:read, user) && !user.has_role?(:admin))) && user != current_user %>
              <%= form_with url: status_user_path(user), method: :patch, local: true, remote: true do |form| %>
                <div class="flex justify-center">
                  <label class="relative inline-block h-7 w-12 cursor-pointer">
                    <%= form.check_box :active, checked: user.active, class: "peer sr-only", data: { confirm: 'Are you sure?' }, onchange: 'this.form.submit()' %>
                    <span class="absolute inset-0 rounded-full bg-slate-300 transition duration-300 peer-checked:bg-[#0D9C66] dark:bg-slate-600"></span>
                    <span class="absolute left-1 top-1 h-5 w-5 rounded-full bg-white shadow transition duration-300 peer-checked:translate-x-5"></span>
                  </label>
                </div>
              <% end %>
            <% end %>
          </td>

          <td class="whitespace-nowrap px-4 py-3 text-right">
            <% if (can?(:manage, user) || (can?(:read, user) && !user.has_role?(:admin))) && user != current_user %>
              <%= link_to 'Edit roles', edit_user_path(user), class: "rounded-lg bg-[#131D58] px-3 py-1.5 text-xs font-bold uppercase text-white shadow-sm transition hover:bg-[#1a2670]" %>
            <% end %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>

<!-- Pagination -->
<div class="mt-4 flex items-center justify-between gap-3">
  <% if @page > 1 %>
    <%= link_to 'Previous', users_path(page: @page - 1, query: params[:query]), class: 'rounded-lg border border-[#131D58]/20 bg-white px-4 py-2 text-sm font-bold text-[#131D58] shadow-sm transition hover:border-[#131D58] hover:bg-[#131D58]/5 dark:border-slate-700 dark:bg-slate-900 dark:text-[#8FA3E6]' %>
  <% else %>
    <span></span>
  <% end %>

  <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-400">Page <%= @page %> of <%= @total_pages %></span>

  <% if @page < @total_pages %>
    <%= link_to 'Next', users_path(page: @page + 1, query: params[:query]), class: 'rounded-lg bg-[#0D9C66] px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-[#0B8558] hover:shadow active:scale-[0.98]' %>
  <% else %>
    <span></span>
  <% end %>
</div>
