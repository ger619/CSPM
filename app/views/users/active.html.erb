<div class="min-h-screen bg-slate-50 px-4 py-6 dark:bg-slate-950 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <h1 class="mb-6 text-xl font-black text-[#0A1024] dark:text-white sm:text-2xl">Active Users</h1>

    <% if @active_users.any? %>
      <!-- Mobile cards -->
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:hidden">
        <% @active_users.each do |user| %>
          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <p class="truncate text-sm font-black text-[#0A1024] dark:text-white"><%= user.first_name %> <%= user.last_name %></p>
            <p class="mt-0.5 truncate text-xs font-medium text-slate-500 dark:text-slate-400"><%= user.email %></p>
            <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-3 dark:border-slate-800">
              <span class="text-xs font-bold uppercase tracking-wide text-slate-400">Sign-ins</span>
              <span class="rounded-full bg-[#131D58]/10 px-2.5 py-1 text-xs font-black text-[#131D58] dark:bg-[#131D58]/30 dark:text-[#8FA3E6]"><%= user.sign_in_count %></span>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Desktop table -->
      <div class="hidden overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900 lg:block">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-slate-700 dark:text-slate-300">
            <thead class="bg-gradient-to-r from-[#131D58] via-[#1a2670] to-[#0D9C66] text-xs uppercase tracking-wide text-white">
            <tr>
              <th class="px-4 py-3 font-bold">First Name</th>
              <th class="px-4 py-3 font-bold">Last Name</th>
              <th class="px-4 py-3 font-bold">Email</th>
              <th class="px-4 py-3 text-center font-bold">Sign-In Count</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            <% @active_users.each do |user| %>
              <tr class="bg-white transition hover:bg-[#131D58]/[0.03] dark:bg-slate-900 dark:hover:bg-slate-800">
                <td class="px-4 py-3 font-bold text-[#0A1024] dark:text-white"><%= user.first_name %></td>
                <td class="px-4 py-3 font-bold text-[#0A1024] dark:text-white"><%= user.last_name %></td>
                <td class="px-4 py-3"><%= user.email %></td>
                <td class="px-4 py-3 text-center">
                  <span class="rounded-full bg-[#131D58]/10 px-2.5 py-1 text-xs font-black text-[#131D58] dark:bg-[#131D58]/30 dark:text-[#8FA3E6]"><%= user.sign_in_count %></span>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pagination -->
      <div class="mt-4 flex items-center justify-between gap-3">
        <% if @current_page > 1 %>
          <%= link_to "Previous", active_users_path(page: @current_page - 1), class: "rounded-lg border border-[#131D58]/20 bg-white px-4 py-2 text-sm font-bold text-[#131D58] shadow-sm transition hover:border-[#131D58] hover:bg-[#131D58]/5 dark:border-slate-700 dark:bg-slate-900 dark:text-[#8FA3E6]" %>
        <% else %>
          <span></span>
        <% end %>

        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-400">Page <%= @current_page %> of <%= @total_pages %></span>

        <% if @current_page < @total_pages %>
          <%= link_to "Next", active_users_path(page: @current_page + 1), class: "rounded-lg bg-[#0D9C66] px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-[#0B8558] hover:shadow active:scale-[0.98]" %>
        <% else %>
          <span></span>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-8 text-center dark:border-slate-700 dark:bg-slate-900">
        <p class="text-sm font-bold text-slate-400">No active users found.</p>
      </div>
    <% end %>
  </div>
</div>
